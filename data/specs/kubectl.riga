# Original Riga completion spec for a kubectl subset (MIT). Format reference: docs/SPECS.md.
# Contexts, clusters, users and context namespaces come from ~/.kube/config ($KUBECONFIG and --kubeconfig are ignored).
# Pods, containers and other resource names are not generated.
# Resource-type args list common types only; other types and type/name forms are still accepted.
command kubectl "Control Kubernetes clusters"
  flag --help|-h persistent "Print usage"
  flag --namespace|-n <kube-namespace> persistent "Namespace for this request"
  flag --context <kube-context> persistent "Kubeconfig context to use"
  flag --cluster <kube-cluster> persistent "Kubeconfig cluster to use"
  flag --user <kube-user> persistent "Kubeconfig user to use"
  flag --kubeconfig <file> persistent "Path to the kubeconfig file"
  flag --server|-s <address> persistent "Address and port of the API server"
  flag --as <user> persistent "User to impersonate"
  flag --as-group <group> repeat persistent "Group to impersonate"
  flag --token <token> persistent "Bearer token for API authentication"
  flag --request-timeout <duration> persistent "Time to wait before giving up on a request"
  flag --insecure-skip-tls-verify persistent "Skip server certificate verification"
  flag --certificate-authority <file> persistent "Certificate authority file"
  flag --client-certificate <file> persistent "Client certificate file for TLS"
  flag --client-key <file> persistent "Client key file for TLS"
  flag --v|-v <level> persistent "Log verbosity level"
  flag --warnings-as-errors persistent "Treat server warnings as errors"
  command get "List one or more resources"
    flag --all-namespaces|-A "List across all namespaces"
    flag --output|-o {json,yaml,wide,name,jsonpath=,custom-columns=,go-template=} "Output format"
    flag --selector|-l <selector> "Filter by label selector"
    flag --field-selector <selector> "Filter by field selector"
    flag --filename|-f <file> repeat "File, directory or URL identifying resources"
    flag --kustomize|-k <directory> "Kustomization directory"
    flag --recursive|-R "Process the -f directory recursively"
    flag --watch|-w "Watch for changes after listing"
    flag --watch-only "Watch for changes without listing first"
    flag --show-labels "Show all labels as the last column"
    flag --label-columns|-L <label> repeat "Show a label as its own column"
    flag --show-kind "Show the resource type"
    flag --no-headers "Omit column headers"
    flag --sort-by <jsonpath> "Sort the list by a JSONPath field"
    flag --ignore-not-found "Do not fail when the resource is missing"
    flag --chunk-size <count> "Return large lists in chunks"
    flag --raw <uri> "Raw URI to request from the server"
    arg {pods,deployments,services,nodes,namespaces,configmaps,secrets,ingresses,statefulsets,daemonsets,replicasets,jobs,cronjobs,persistentvolumeclaims,persistentvolumes,events,serviceaccounts,all} "Resource type"
    arg [<name>] repeat "Resource names"
  command describe "Show details of resources"
    flag --all-namespaces|-A "Describe across all namespaces"
    flag --selector|-l <selector> "Filter by label selector"
    flag --filename|-f <file> repeat "File, directory or URL identifying resources"
    flag --kustomize|-k <directory> "Kustomization directory"
    flag --recursive|-R "Process the -f directory recursively"
    flag --show-events "Show related events"
    arg {pods,deployments,services,nodes,namespaces,configmaps,secrets,ingresses,statefulsets,daemonsets,replicasets,jobs,cronjobs,persistentvolumeclaims,persistentvolumes,serviceaccounts} "Resource type"
    arg [<name>] repeat "Resource names"
  command apply "Apply a configuration to resources"
    flag --filename|-f <file> repeat "File, directory or URL to apply"
    flag --kustomize|-k <directory> excludes=--filename "Kustomization directory to apply"
    flag --recursive|-R "Process the -f directory recursively"
    flag --selector|-l <selector> "Filter by label selector"
    flag --dry-run [{none,client,server}] "Preview without persisting"
    flag --server-side "Apply on the server"
    flag --force-conflicts requires=--server-side "Take ownership of conflicting fields"
    flag --field-manager <name> "Name of the field manager"
    flag --prune "Delete resources no longer in the configuration"
    flag --all "Select all resources in the namespace"
    flag --force "Delete and re-create resources if needed"
    flag --output|-o {json,yaml,name} "Output format"
    flag --validate [{strict,warn,ignore}] "Schema validation mode"
    flag --wait "Wait for resources to be gone before returning"
    flag --timeout <duration> "Time to wait for deletion"
    command view-last-applied "Show the last applied configuration"
      flag --output|-o {yaml,json} "Output format"
      arg <resource> repeat "Resources"
    command edit-last-applied "Edit the last applied configuration"
      arg <resource> "Resource"
  command delete "Delete resources"
    flag --filename|-f <file> repeat "File, directory or URL identifying resources"
    flag --kustomize|-k <directory> "Kustomization directory"
    flag --recursive|-R "Process the -f directory recursively"
    flag --selector|-l <selector> "Filter by label selector"
    flag --field-selector <selector> "Filter by field selector"
    flag --all "Delete all resources of the type"
    flag --all-namespaces|-A "Delete across all namespaces"
    flag --force "Delete immediately without waiting for confirmation"
    flag --grace-period <seconds> "Seconds given to the resource to terminate"
    flag --now "Signal resources for immediate shutdown"
    flag --wait "Wait for resources to be gone"
    flag --timeout <duration> "Time to wait before giving up"
    flag --ignore-not-found "Do not fail when the resource is missing"
    flag --cascade [{background,foreground,orphan}] "Dependent deletion strategy"
    flag --dry-run [{none,client,server}] "Preview without deleting"
    flag --interactive|-i "Confirm each deletion"
    flag --output|-o {name} "Output format"
    arg {pods,deployments,services,namespaces,configmaps,secrets,ingresses,statefulsets,daemonsets,replicasets,jobs,cronjobs,persistentvolumeclaims,persistentvolumes,serviceaccounts} "Resource type"
    arg [<name>] repeat "Resource names"
  command logs "Print container logs"
    flag --follow|-f "Stream the logs"
    flag --previous|-p "Logs of the previous container instance"
    flag --container|-c <container> "Container name"
    flag --all-containers excludes=--container "Logs of all containers in the pod"
    flag --selector|-l <selector> "Select pods by label"
    flag --tail <lines> "Number of recent lines to show"
    flag --since <duration> "Only logs newer than a relative duration"
    flag --since-time <timestamp> "Only logs after an RFC3339 timestamp"
    flag --timestamps "Prefix lines with timestamps"
    flag --prefix "Prefix lines with pod and container name"
    flag --limit-bytes <bytes> "Maximum bytes of logs to return"
    flag --max-log-requests <count> "Maximum concurrent logs with a selector"
    arg <pod> "Pod or type/name"
    arg [<container>] "Container name"
  command exec "Run a command in a container"
    flag --stdin|-i "Pass stdin to the container"
    flag --tty|-t "Allocate a TTY"
    flag --container|-c <container> "Container name"
    flag --filename|-f <file> "File identifying the pod"
    flag --quiet|-q "Only print output from the remote session"
    flag --pod-running-timeout <duration> "Time to wait for a running pod"
    arg <pod> "Pod or type/name"
    arg <command> repeat "Command and arguments, after --"
  command port-forward "Forward local ports to a pod"
    flag --address <address> repeat "Local addresses to listen on"
    flag --pod-running-timeout <duration> "Time to wait for a running pod"
    arg <pod> "Pod or type/name"
    arg <local:remote> repeat "Port mappings"
  command cp "Copy files to and from containers"
    flag --container|-c <container> "Container name"
    flag --no-preserve "Do not preserve ownership and permissions"
    flag --retries <count> "Number of retries on failure"
    arg <source> "Local path or pod:path"
    arg <destination> "Local path or pod:path"
  command create "Create a resource from a file or stdin"
    flag --filename|-f <file> repeat "File, directory or URL to create from"
    flag --kustomize|-k <directory> "Kustomization directory"
    flag --recursive|-R "Process the -f directory recursively"
    flag --dry-run [{none,client,server}] "Preview without creating"
    flag --output|-o {json,yaml,name} "Output format"
    flag --save-config "Save the configuration in an annotation"
    flag --edit "Edit before creating"
    command namespace|ns "Create a namespace"
      flag --dry-run [{none,client,server}] "Preview without creating"
      flag --output|-o {json,yaml,name} "Output format"
      arg <name> "Namespace name"
    command deployment|deploy "Create a deployment"
      flag --image <image> repeat "Container image"
      flag --replicas|-r <count> "Number of replicas"
      flag --port <port> "Container port to expose"
      flag --dry-run [{none,client,server}] "Preview without creating"
      flag --output|-o {json,yaml,name} "Output format"
      arg <name> "Deployment name"
    command configmap|cm "Create a config map"
      flag --from-file <file> repeat "Key file or directory"
      flag --from-literal <key=value> repeat "Literal key and value"
      flag --from-env-file <file> repeat "Env file with key=value lines"
      flag --dry-run [{none,client,server}] "Preview without creating"
      flag --output|-o {json,yaml,name} "Output format"
      arg <name> "Config map name"
    command secret "Create a secret"
      command generic "Create a secret from files or literals"
        flag --from-file <file> repeat "Key file or directory"
        flag --from-literal <key=value> repeat "Literal key and value"
        flag --from-env-file <file> repeat "Env file with key=value lines"
        flag --type <type> "Secret type"
        flag --dry-run [{none,client,server}] "Preview without creating"
        flag --output|-o {json,yaml,name} "Output format"
        arg <name> "Secret name"
      command tls "Create a TLS secret"
        flag --cert <file> "PEM certificate file"
        flag --key <file> "PEM private key file"
        flag --dry-run [{none,client,server}] "Preview without creating"
        flag --output|-o {json,yaml,name} "Output format"
        arg <name> "Secret name"
      command docker-registry "Create a registry credentials secret"
        flag --docker-server <server> "Registry server"
        flag --docker-username <user> "Registry user name"
        flag --docker-password <password> "Registry password"
        flag --docker-email <email> "Registry email"
        flag --from-file <file> repeat "Docker config file"
        flag --dry-run [{none,client,server}] "Preview without creating"
        flag --output|-o {json,yaml,name} "Output format"
        arg <name> "Secret name"
    command job "Create a job"
      flag --image <image> "Container image"
      flag --from <cronjob> "Create from a cron job, as cronjob/name"
      flag --dry-run [{none,client,server}] "Preview without creating"
      flag --output|-o {json,yaml,name} "Output format"
      arg <name> "Job name"
      arg [<command>] repeat "Command and arguments, after --"
  command edit "Edit a resource in your editor"
    flag --filename|-f <file> repeat "File identifying resources"
    flag --output|-o {json,yaml} "Format to edit in"
    flag --save-config "Save the configuration in an annotation"
    flag --validate [{strict,warn,ignore}] "Schema validation mode"
    arg <resource> repeat "Type and name, or type/name"
  command diff "Diff live state against a configuration"
    flag --filename|-f <file> repeat "File, directory or URL to diff"
    flag --kustomize|-k <directory> "Kustomization directory"
    flag --recursive|-R "Process the -f directory recursively"
    flag --selector|-l <selector> "Filter by label selector"
    flag --server-side "Diff using server-side apply"
    flag --prune "Include resources that would be pruned"
  command scale "Set the replica count of a resource"
    flag --replicas <count> "New number of replicas"
    flag --current-replicas <count> "Precondition on the current replica count"
    flag --filename|-f <file> repeat "File identifying resources"
    flag --selector|-l <selector> "Filter by label selector"
    flag --all "Scale all resources of the type"
    flag --timeout <duration> "Time to wait for the scale"
    flag --dry-run [{none,client,server}] "Preview without scaling"
    arg <resource> repeat "Type and name, or type/name"
  command rollout "Manage rollouts of a resource"
    command status "Show rollout status"
      flag --watch|-w "Watch until the rollout finishes"
      flag --revision <number> "Revision to check"
      flag --timeout <duration> "Time to wait before giving up"
      flag --filename|-f <file> repeat "File identifying resources"
      flag --selector|-l <selector> "Filter by label selector"
      arg <resource> repeat "Type and name, or type/name"
    command restart "Restart a resource"
      flag --filename|-f <file> repeat "File identifying resources"
      flag --selector|-l <selector> "Filter by label selector"
      arg <resource> repeat "Type and name, or type/name"
    command undo "Roll back to a previous rollout"
      flag --to-revision <number> "Revision to roll back to"
      flag --dry-run [{none,client,server}] "Preview without rolling back"
      flag --filename|-f <file> repeat "File identifying resources"
      flag --selector|-l <selector> "Filter by label selector"
      arg <resource> repeat "Type and name, or type/name"
    command history "Show rollout history"
      flag --revision <number> "Show details of one revision"
      flag --filename|-f <file> repeat "File identifying resources"
      flag --selector|-l <selector> "Filter by label selector"
      arg <resource> repeat "Type and name, or type/name"
    command pause "Pause a resource"
      arg <resource> repeat "Type and name, or type/name"
    command resume "Resume a paused resource"
      arg <resource> repeat "Type and name, or type/name"
  command label "Update labels on resources"
    flag --overwrite "Allow overwriting existing labels"
    flag --all "Select all resources of the type"
    flag --selector|-l <selector> "Filter by label selector"
    flag --filename|-f <file> repeat "File identifying resources"
    flag --list "List current labels"
    flag --dry-run [{none,client,server}] "Preview without updating"
    arg <resource> repeat "Resource, then key=value or key- entries"
  command annotate "Update annotations on resources"
    flag --overwrite "Allow overwriting existing annotations"
    flag --all "Select all resources of the type"
    flag --selector|-l <selector> "Filter by label selector"
    flag --filename|-f <file> repeat "File identifying resources"
    flag --list "List current annotations"
    flag --dry-run [{none,client,server}] "Preview without updating"
    arg <resource> repeat "Resource, then key=value or key- entries"
  command patch "Update fields of a resource"
    flag --patch|-p <patch> excludes=--patch-file "Patch to apply"
    flag --patch-file <file> "File containing the patch"
    flag --type {strategic,merge,json} "Patch type"
    flag --filename|-f <file> repeat "File identifying the resource"
    flag --subresource <name> "Subresource to patch"
    flag --dry-run [{none,client,server}] "Preview without patching"
    flag --output|-o {json,yaml,name} "Output format"
    arg <resource> repeat "Type and name, or type/name"
  command expose "Expose a resource as a service"
    flag --port <port> "Port the service serves on"
    flag --target-port <port> "Container port to direct traffic to"
    flag --protocol {TCP,UDP,SCTP} "Network protocol"
    flag --type {ClusterIP,NodePort,LoadBalancer,ExternalName} "Service type"
    flag --name <name> "Service name"
    flag --dry-run [{none,client,server}] "Preview without creating"
    flag --output|-o {json,yaml,name} "Output format"
    arg <resource> repeat "Type and name, or type/name"
  command run "Run an image in a pod"
    flag --image <image> "Container image"
    flag --env <name=value> repeat "Environment variable"
    flag --port <port> "Container port to expose"
    flag --labels|-l <labels> "Comma-separated pod labels"
    flag --restart {Always,OnFailure,Never} "Restart policy"
    flag --rm "Delete the pod after it exits"
    flag --stdin|-i "Keep stdin open"
    flag --tty|-t "Allocate a TTY"
    flag --command "Use the extra arguments as the command"
    flag --image-pull-policy {Always,IfNotPresent,Never} "Image pull policy"
    flag --overrides <json> "Inline JSON override for the pod"
    flag --dry-run [{none,client,server}] "Preview without creating"
    flag --output|-o {json,yaml,name} "Output format"
    arg <name> "Pod name"
    arg [<args>] repeat "Arguments or command, after --"
  command wait "Wait for a condition on resources"
    flag --for <condition> "Condition, e.g. condition=Ready or delete"
    flag --timeout <duration> "Time to wait before giving up"
    flag --selector|-l <selector> "Filter by label selector"
    flag --all "Select all resources of the type"
    flag --all-namespaces|-A "Wait across all namespaces"
    flag --filename|-f <file> repeat "File identifying resources"
    arg <resource> repeat "Type and name, or type/name"
  command top "Show CPU and memory usage"
    command pod|pods|po "Show pod resource usage"
      flag --all-namespaces|-A "Show across all namespaces"
      flag --containers "Show usage per container"
      flag --selector|-l <selector> "Filter by label selector"
      flag --sort-by {cpu,memory} "Sort by usage"
      flag --no-headers "Omit column headers"
      flag --sum "Print the sum of usage"
      arg [<pod>] "Pod name"
    command node|nodes|no "Show node resource usage"
      flag --selector|-l <selector> "Filter by label selector"
      flag --sort-by {cpu,memory} "Sort by usage"
      flag --no-headers "Omit column headers"
      arg [<node>] "Node name"
  command config "Edit kubeconfig files"
    command current-context "Print the current context"
    command get-contexts "List contexts"
      flag --output|-o {name} "Output format"
      flag --no-headers "Omit column headers"
      arg [<kube-context>] repeat "Contexts to show"
    command use-context|use "Switch the current context"
      arg <kube-context> "Context name"
    command set-context "Set a context entry"
      flag --current "Modify the current context"
      flag --namespace <kube-namespace> "Namespace for the context"
      flag --cluster <kube-cluster> "Cluster for the context"
      flag --user <kube-user> "User for the context"
      arg [<kube-context>] "Context name"
    command view "Show the merged kubeconfig"
      flag --minify "Only show the current context"
      flag --flatten "Inline certificate data"
      flag --raw "Show unredacted secrets"
      flag --output|-o {yaml,json,jsonpath=} "Output format"
    command get-clusters "List clusters"
    command get-users "List users"
    command rename-context "Rename a context"
      arg <kube-context> "Current context name"
      arg <new-name> "New context name"
    command delete-context "Delete a context"
      arg <kube-context> "Context name"
    command delete-cluster "Delete a cluster"
      arg <kube-cluster> "Cluster name"
    command delete-user "Delete a user"
      arg <kube-user> "User name"
    command set "Set an individual kubeconfig value"
      arg <property> "Dotted property name"
      arg <value> "New value"
    command unset "Unset an individual kubeconfig value"
      arg <property> "Dotted property name"
  command explain "Describe fields of a resource type"
    flag --recursive "Print all nested fields"
    flag --api-version <version> "API version to use"
    arg <field> "Resource or resource.field path"
  command api-resources "List resource types on the server"
    flag --namespaced "Only namespaced or cluster-scoped types"
    flag --api-group <group> "Limit to an API group"
    flag --verbs <verb> repeat "Limit to types supporting these verbs"
    flag --output|-o {wide,name} "Output format"
    flag --no-headers "Omit column headers"
  command api-versions "List API versions on the server"
  command cluster-info "Show cluster endpoint information"
    command dump "Dump cluster state for debugging"
      flag --output-directory <directory> "Write files to a directory"
      flag --all-namespaces|-A "Dump all namespaces"
  command auth "Inspect authorization"
    command can-i "Check whether an action is allowed"
      flag --all-namespaces|-A "Check across all namespaces"
      flag --list "List all allowed actions"
      flag --quiet|-q "Only set the exit status"
      arg [<verb>] "Verb such as get or create"
      arg [<resource>] "Resource type or type/name"
    command whoami "Show the current subject"
      flag --output|-o {json,yaml} "Output format"
  command version "Print client and server versions"
    flag --client "Only the client version"
    flag --output|-o {json,yaml} "Output format"

#test "kubectl " => +get +apply +logs +config +-n +--context
#test "kubectl get " => +pods +deployments +-A
#test "kubectl get pods -" => +-A +-o +-n +--context
#test "kubectl get pods -o " => +json +yaml +wide
#test "kubectl get pods --output=y" => +yaml
#test "kubectl -n kube-system g" => +get
#test "kubectl get pods -n default -" => --n +-l
#test "kubectl logs --container app --all" => ---all-containers
#test "kubectl logs --all-containers -" => ---container --c +-f
#test "kubectl apply --force" => ---force-conflicts
#test "kubectl apply --server-side --force" => +--force-conflicts
#test "kubectl apply --dry-run=s" => +server
#test "kubectl delete --cascade=f" => +foreground
#test "kubectl config " => +use-context +use +get-contexts +view
#test "kubectl config view -" => +--minify +--kubeconfig
#test "kubectl top po --sort-by " => +cpu +memory
#test "kubectl create deploy --" => +--image +--replicas
#test "kubectl create secret " => +generic +tls +docker-registry
#test "kubectl exec -it web -- -" => ---stdin ---container
#test "kubectl run web --image=nginx --restart " => +Never +OnFailure
#test "kubectl expose deploy web --type " => +NodePort +LoadBalancer
#test "kubectl rollout " => +status +restart +undo +history
#test "kubectl patch --patch-file x --pa" => ---patch
#test "kubectl exec web -c app -" => +-i ---container
#test "kubectl exec -it web -- ls -" => --i ---quiet
