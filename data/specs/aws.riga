# Original Riga completion spec for an AWS CLI v2 subset (MIT). Format reference: docs/SPECS.md.
# Profiles and SSO sessions are read from ~/.aws/config and ~/.aws/credentials; regions are a static list.
# Buckets, instances, functions, log groups, stacks, tables, secrets and parameters are not generated.
command aws "Manage Amazon Web Services from the command line"
  flag --profile <aws-profile> persistent "Use a named profile from the config or credentials file"
  flag --region {us-east-1,us-east-2,us-west-1,us-west-2,af-south-1,ap-east-1,ap-east-2,ap-south-1,ap-south-2,ap-southeast-1,ap-southeast-2,ap-southeast-3,ap-southeast-4,ap-southeast-5,ap-southeast-7,ap-northeast-1,ap-northeast-2,ap-northeast-3,ca-central-1,ca-west-1,eu-central-1,eu-central-2,eu-west-1,eu-west-2,eu-west-3,eu-south-1,eu-south-2,eu-north-1,il-central-1,me-south-1,me-central-1,mx-central-1,sa-east-1,us-gov-east-1,us-gov-west-1,cn-north-1,cn-northwest-1} persistent "Region to send requests to"
  flag --output {json,text,table,yaml,yaml-stream} persistent "Output format"
  flag --query <jmespath> persistent "JMESPath query to filter the response"
  flag --endpoint-url <url> persistent "Override the service endpoint URL"
  flag --debug persistent "Print debug logging"
  flag --no-cli-pager persistent "Disable the output pager"
  flag --cli-auto-prompt excludes=--no-cli-auto-prompt persistent "Turn on the interactive auto-prompt"
  flag --no-cli-auto-prompt persistent "Turn off the interactive auto-prompt"
  flag --no-verify-ssl persistent "Skip TLS certificate verification"
  flag --no-paginate persistent "Return only the first page of results"
  flag --no-sign-request persistent "Send requests without credentials"
  flag --ca-bundle <file> persistent "CA certificate bundle for TLS verification"
  flag --color {on,off,auto} persistent "Colored output"
  flag --cli-binary-format {base64,raw-in-base64-out} persistent "How binary blob parameters are passed"
  flag --cli-read-timeout <seconds> persistent "Socket read timeout in seconds"
  flag --cli-connect-timeout <seconds> persistent "Socket connect timeout in seconds"
  flag --version "Print the CLI version"
  command help "Show documentation for a command"
    arg [<topic>] repeat "Service or topic"

  command configure "Set up credentials and settings interactively"
    command list "Show the configuration values in effect and their source"
    command list-profiles "List all profile names"
    command get "Print one configuration value"
      arg <name> "Setting name such as region or profile.dev.region"
    command set "Write one configuration value"
      arg <name> "Setting name"
      arg <value> "Value to store"
    command sso "Create a profile that signs in with IAM Identity Center"
    command sso-session "Create an SSO session section"
    command export-credentials "Print the profile's resolved credentials"
      flag --format {process,env,env-no-export,powershell,windows-cmd} "Output format"
    command import "Import credentials from a CSV file"
      flag --csv <file> "CSV file with access keys"

  command sso "Sign in with IAM Identity Center"
    command login "Sign in and cache an SSO access token"
      flag --sso-session <aws-sso-session> "SSO session to sign in with"
      flag --no-browser "Print the sign-in URL instead of opening a browser"
      flag --use-device-code "Use the device code flow"
    command logout "Remove cached SSO tokens"
    command list-accounts "List accounts the token can access"
      flag --access-token <token> "SSO access token"
    command list-account-roles "List roles in an account"
      flag --access-token <token> "SSO access token"
      flag --account-id <id> "Account ID"

  command sts "Security Token Service"
    command get-caller-identity "Show the account, user ID and ARN of the caller"
    command assume-role "Get temporary credentials for a role"
      flag --role-arn <arn> "ARN of the role to assume"
      flag --role-session-name <name> "Name for the session"
      flag --duration-seconds <seconds> "Session duration"
      flag --external-id <id> "External ID required by the role"
      flag --serial-number <arn> "MFA device serial number or ARN"
      flag --token-code <code> "MFA code"
    command get-session-token "Get temporary credentials for the caller"
      flag --duration-seconds <seconds> "Session duration"
      flag --serial-number <arn> "MFA device serial number or ARN"
      flag --token-code <code> "MFA code"
    command decode-authorization-message "Decode an encoded authorization failure message"
      flag --encoded-message <message> "Encoded message"

  command s3 "High-level S3 file commands"
    command ls "List buckets, or objects under a prefix"
      flag --recursive "List all objects under the prefix"
      flag --human-readable "Show sizes in readable units"
      flag --summarize "Show object count and total size"
      flag --page-size <count> "Objects per request"
      flag --request-payer {requester} "Accept requester-pays charges"
      arg [<s3-uri>] "Bucket or prefix, as s3://bucket/prefix"
    command cp "Copy files and objects"
      flag --recursive "Copy all files under the directory or prefix"
      flag --dryrun "Show what would run without doing it"
      flag --quiet "Print nothing"
      flag --only-show-errors "Print only errors"
      flag --no-progress "Hide the progress line"
      flag --exclude <pattern> repeat "Skip paths matching the pattern"
      flag --include <pattern> repeat "Do not skip paths matching the pattern"
      flag --acl {private,public-read,public-read-write,authenticated-read,aws-exec-read,bucket-owner-read,bucket-owner-full-control,log-delivery-write} "Canned ACL"
      flag --storage-class {STANDARD,REDUCED_REDUNDANCY,STANDARD_IA,ONEZONE_IA,INTELLIGENT_TIERING,GLACIER,DEEP_ARCHIVE,GLACIER_IR} "Storage class"
      flag --sse {AES256,aws:kms,aws:kms:dsse} "Server-side encryption"
      flag --sse-kms-key-id <key-id> "KMS key for server-side encryption"
      flag --content-type <type> "Content type to set"
      flag --cache-control <value> "Cache-Control header to set"
      flag --metadata <key=value> "Metadata to set"
      flag --source-region <region> "Region of the source bucket"
      flag --follow-symlinks excludes=--no-follow-symlinks "Follow symbolic links"
      flag --no-follow-symlinks "Do not follow symbolic links"
      flag --expected-size <bytes> "Size of a streamed upload"
      arg <source> "Local path, s3:// URI or - for stdin"
      arg <destination> "Local path, s3:// URI or - for stdout"
    command mv "Move files and objects"
      flag --recursive "Move all files under the directory or prefix"
      flag --dryrun "Show what would run without doing it"
      flag --quiet "Print nothing"
      flag --only-show-errors "Print only errors"
      flag --no-progress "Hide the progress line"
      flag --exclude <pattern> repeat "Skip paths matching the pattern"
      flag --include <pattern> repeat "Do not skip paths matching the pattern"
      flag --acl {private,public-read,public-read-write,authenticated-read,aws-exec-read,bucket-owner-read,bucket-owner-full-control,log-delivery-write} "Canned ACL"
      flag --storage-class {STANDARD,REDUCED_REDUNDANCY,STANDARD_IA,ONEZONE_IA,INTELLIGENT_TIERING,GLACIER,DEEP_ARCHIVE,GLACIER_IR} "Storage class"
      flag --sse {AES256,aws:kms,aws:kms:dsse} "Server-side encryption"
      arg <source> "Local path or s3:// URI"
      arg <destination> "Local path or s3:// URI"
    command rm "Delete objects"
      flag --recursive "Delete all objects under the prefix"
      flag --dryrun "Show what would run without doing it"
      flag --quiet "Print nothing"
      flag --only-show-errors "Print only errors"
      flag --exclude <pattern> repeat "Skip keys matching the pattern"
      flag --include <pattern> repeat "Do not skip keys matching the pattern"
      arg <s3-uri> "Object or prefix, as s3://bucket/key"
    command sync "Copy new and changed files between directories and prefixes"
      flag --delete "Delete destination files missing from the source"
      flag --dryrun "Show what would run without doing it"
      flag --quiet "Print nothing"
      flag --only-show-errors "Print only errors"
      flag --no-progress "Hide the progress line"
      flag --exclude <pattern> repeat "Skip paths matching the pattern"
      flag --include <pattern> repeat "Do not skip paths matching the pattern"
      flag --size-only "Compare by size only"
      flag --exact-timestamps "Treat differing timestamps as changes"
      flag --acl {private,public-read,public-read-write,authenticated-read,aws-exec-read,bucket-owner-read,bucket-owner-full-control,log-delivery-write} "Canned ACL"
      flag --storage-class {STANDARD,REDUCED_REDUNDANCY,STANDARD_IA,ONEZONE_IA,INTELLIGENT_TIERING,GLACIER,DEEP_ARCHIVE,GLACIER_IR} "Storage class"
      flag --sse {AES256,aws:kms,aws:kms:dsse} "Server-side encryption"
      flag --cache-control <value> "Cache-Control header to set"
      flag --follow-symlinks excludes=--no-follow-symlinks "Follow symbolic links"
      flag --no-follow-symlinks "Do not follow symbolic links"
      arg <source> "Local directory or s3:// URI"
      arg <destination> "Local directory or s3:// URI"
    command mb "Create a bucket"
      arg <s3-uri> "Bucket, as s3://bucket"
    command rb "Remove a bucket"
      flag --force "Delete all objects first"
      arg <s3-uri> "Bucket, as s3://bucket"
    command presign "Print a pre-signed URL for an object"
      flag --expires-in <seconds> "Seconds until the URL expires"
      arg <s3-uri> "Object, as s3://bucket/key"

  command s3api "Low-level S3 API operations"
    command list-buckets "List your buckets"
    command create-bucket "Create a bucket"
      flag --bucket <name> "Bucket name"
      flag --create-bucket-configuration <config> "Location constraint, such as LocationConstraint=eu-west-1"
      flag --acl {private,public-read,public-read-write,authenticated-read} "Canned ACL"
    command delete-bucket "Delete an empty bucket"
      flag --bucket <name> "Bucket name"
    command head-bucket "Check that a bucket exists and is accessible"
      flag --bucket <name> "Bucket name"
    command get-bucket-location "Show the bucket's region"
      flag --bucket <name> "Bucket name"
    command get-bucket-policy "Print the bucket policy"
      flag --bucket <name> "Bucket name"
    command put-bucket-policy "Set the bucket policy"
      flag --bucket <name> "Bucket name"
      flag --policy <json> "Policy JSON or file://path"
    command get-bucket-versioning "Show the versioning state"
      flag --bucket <name> "Bucket name"
    command put-bucket-versioning "Set the versioning state"
      flag --bucket <name> "Bucket name"
      flag --versioning-configuration <config> "Such as Status=Enabled"
    command list-objects-v2 "List objects in a bucket"
      flag --bucket <name> "Bucket name"
      flag --prefix <prefix> "Only keys starting with this prefix"
      flag --delimiter <char> "Group keys by this delimiter"
      flag --start-after <key> "Start listing after this key"
      flag --max-items <count> "Maximum items to return"
      flag --page-size <count> "Items per request"
    command head-object "Show an object's metadata"
      flag --bucket <name> "Bucket name"
      flag --key <key> "Object key"
      flag --version-id <id> "Object version"
    command get-object "Download an object"
      flag --bucket <name> "Bucket name"
      flag --key <key> "Object key"
      flag --version-id <id> "Object version"
      flag --range <bytes> "Byte range, such as bytes=0-99"
      arg <outfile> "File to write the object to"
    command put-object "Upload an object"
      flag --bucket <name> "Bucket name"
      flag --key <key> "Object key"
      flag --body <file> "File to upload"
      flag --content-type <type> "Content type"
      flag --metadata <map> "Metadata to set"
    command copy-object "Copy an object"
      flag --bucket <name> "Destination bucket"
      flag --key <key> "Destination key"
      flag --copy-source <bucket/key> "Source bucket and key"
    command delete-object "Delete an object"
      flag --bucket <name> "Bucket name"
      flag --key <key> "Object key"
      flag --version-id <id> "Object version"

  command ec2 "Elastic Compute Cloud"
    command describe-instances "Describe instances"
      flag --instance-ids <id> repeat "Instance IDs"
      flag --filters <filter> repeat "Filters, such as Name=instance-state-name,Values=running"
      flag --max-items <count> "Maximum items to return"
      flag --dry-run excludes=--no-dry-run "Check permissions only"
      flag --no-dry-run "Make the request"
    command start-instances "Start stopped instances"
      flag --instance-ids <id> repeat "Instance IDs"
      flag --dry-run excludes=--no-dry-run "Check permissions only"
      flag --no-dry-run "Make the request"
    command stop-instances "Stop running instances"
      flag --instance-ids <id> repeat "Instance IDs"
      flag --force "Force the instances to stop"
      flag --hibernate "Hibernate instead of stopping"
      flag --dry-run excludes=--no-dry-run "Check permissions only"
      flag --no-dry-run "Make the request"
    command reboot-instances "Reboot instances"
      flag --instance-ids <id> repeat "Instance IDs"
      flag --dry-run excludes=--no-dry-run "Check permissions only"
      flag --no-dry-run "Make the request"
    command terminate-instances "Terminate instances"
      flag --instance-ids <id> repeat "Instance IDs"
      flag --dry-run excludes=--no-dry-run "Check permissions only"
      flag --no-dry-run "Make the request"
    command run-instances "Launch instances"
      flag --image-id <ami> "AMI to launch"
      flag --instance-type <type> "Instance type, such as t3.micro"
      flag --count <n> "Number of instances"
      flag --key-name <name> "Key pair name"
      flag --security-group-ids <id> repeat "Security group IDs"
      flag --subnet-id <id> "Subnet to launch in"
      flag --iam-instance-profile <profile> "Instance profile, such as Name=role"
      flag --user-data <data> "User data or file://path"
      flag --tag-specifications <spec> repeat "Tags for the new resources"
      flag --dry-run excludes=--no-dry-run "Check permissions only"
      flag --no-dry-run "Make the request"
    command describe-images "Describe AMIs"
      flag --owners <owner> repeat "Owners, such as self or amazon"
      flag --image-ids <id> repeat "AMI IDs"
      flag --filters <filter> repeat "Filters"
    command describe-security-groups "Describe security groups"
      flag --group-ids <id> repeat "Security group IDs"
      flag --filters <filter> repeat "Filters"
    command describe-vpcs "Describe VPCs"
      flag --vpc-ids <id> repeat "VPC IDs"
      flag --filters <filter> repeat "Filters"
    command describe-subnets "Describe subnets"
      flag --subnet-ids <id> repeat "Subnet IDs"
      flag --filters <filter> repeat "Filters"
    command describe-volumes "Describe EBS volumes"
      flag --volume-ids <id> repeat "Volume IDs"
      flag --filters <filter> repeat "Filters"
    command describe-snapshots "Describe EBS snapshots"
      flag --owner-ids <owner> repeat "Owners, such as self"
      flag --snapshot-ids <id> repeat "Snapshot IDs"
      flag --filters <filter> repeat "Filters"
    command describe-key-pairs "Describe key pairs"
      flag --key-names <name> repeat "Key pair names"
    command describe-regions "Describe regions"
      flag --all-regions "Include regions not enabled for the account"
    command describe-availability-zones "Describe availability zones"
      flag --all-availability-zones "Include zones not opted in"
    command create-tags "Add tags to resources"
      flag --resources <id> repeat "Resource IDs"
      flag --tags <tag> repeat "Tags, such as Key=Name,Value=web"
    command get-console-output "Print an instance's console output"
      flag --instance-id <id> "Instance ID"
      flag --latest "Most recent output only"

  command iam "Identity and Access Management"
    command list-users "List users"
      flag --path-prefix <path> "Only users under this path"
    command get-user "Show a user"
      flag --user-name <name> "User name; defaults to the caller"
    command create-user "Create a user"
      flag --user-name <name> "User name"
    command delete-user "Delete a user"
      flag --user-name <name> "User name"
    command list-roles "List roles"
      flag --path-prefix <path> "Only roles under this path"
    command get-role "Show a role"
      flag --role-name <name> "Role name"
    command create-role "Create a role"
      flag --role-name <name> "Role name"
      flag --assume-role-policy-document <json> "Trust policy JSON or file://path"
      flag --description <text> "Role description"
    command delete-role "Delete a role"
      flag --role-name <name> "Role name"
    command list-policies "List managed policies"
      flag --scope {All,AWS,Local} "Which policies to list"
      flag --only-attached "Only policies attached to something"
    command get-policy "Show a managed policy"
      flag --policy-arn <arn> "Policy ARN"
    command attach-role-policy "Attach a managed policy to a role"
      flag --role-name <name> "Role name"
      flag --policy-arn <arn> "Policy ARN"
    command detach-role-policy "Detach a managed policy from a role"
      flag --role-name <name> "Role name"
      flag --policy-arn <arn> "Policy ARN"
    command list-attached-role-policies "List managed policies attached to a role"
      flag --role-name <name> "Role name"
    command put-role-policy "Set an inline policy on a role"
      flag --role-name <name> "Role name"
      flag --policy-name <name> "Inline policy name"
      flag --policy-document <json> "Policy JSON or file://path"
    command list-access-keys "List a user's access keys"
      flag --user-name <name> "User name"
    command create-access-key "Create an access key"
      flag --user-name <name> "User name"
    command list-groups "List groups"

  command lambda "Lambda functions"
    command list-functions "List functions"
      flag --max-items <count> "Maximum items to return"
    command get-function "Show a function and a link to its code"
      flag --function-name <name> "Function name or ARN"
      flag --qualifier <version> "Version or alias"
    command get-function-configuration "Show a function's settings"
      flag --function-name <name> "Function name or ARN"
      flag --qualifier <version> "Version or alias"
    command invoke "Invoke a function"
      flag --function-name <name> "Function name or ARN"
      flag --payload <json> "Event JSON or file://path"
      flag --invocation-type {RequestResponse,Event,DryRun} "Synchronous, asynchronous or validation only"
      flag --log-type {None,Tail} "Include the log tail in the response"
      flag --qualifier <version> "Version or alias"
      arg <outfile> "File to write the response to"
    command create-function "Create a function"
      flag --function-name <name> "Function name"
      flag --runtime <runtime> "Runtime, such as python3.12"
      flag --role <arn> "Execution role ARN"
      flag --handler <handler> "Handler, such as app.handler"
      flag --zip-file <fileb-uri> "Deployment package as fileb://path"
      flag --code <code> "Code location, such as S3Bucket=b,S3Key=k"
      flag --package-type {Zip,Image} "Deployment package type"
      flag --timeout <seconds> "Timeout in seconds"
      flag --memory-size <mb> "Memory in MB"
      flag --environment <vars> "Such as Variables={KEY=value}"
    command update-function-code "Deploy new code to a function"
      flag --function-name <name> "Function name or ARN"
      flag --zip-file <fileb-uri> "Deployment package as fileb://path"
      flag --s3-bucket <bucket> "Bucket holding the package"
      flag --s3-key <key> "Key of the package"
      flag --image-uri <uri> "Container image URI"
      flag --publish excludes=--no-publish "Publish a new version"
      flag --no-publish "Do not publish a version"
      flag --dry-run excludes=--no-dry-run "Validate only"
      flag --no-dry-run "Make the update"
    command update-function-configuration "Change a function's settings"
      flag --function-name <name> "Function name or ARN"
      flag --handler <handler> "Handler"
      flag --runtime <runtime> "Runtime"
      flag --timeout <seconds> "Timeout in seconds"
      flag --memory-size <mb> "Memory in MB"
      flag --environment <vars> "Such as Variables={KEY=value}"
      flag --role <arn> "Execution role ARN"
    command delete-function "Delete a function"
      flag --function-name <name> "Function name or ARN"
    command publish-version "Publish a version from the current code"
      flag --function-name <name> "Function name or ARN"
    command list-versions-by-function "List a function's versions"
      flag --function-name <name> "Function name or ARN"
    command list-aliases "List a function's aliases"
      flag --function-name <name> "Function name or ARN"

  command logs "CloudWatch Logs"
    command tail "Print log events from a group, optionally following"
      flag --follow "Keep printing new events"
      flag --since <time> "Start time, such as 10m, 2h or a timestamp"
      flag --format {detailed,short,json} "Event format"
      flag --filter-pattern <pattern> "Only matching events"
      flag --log-stream-names <name> repeat "Only these streams"
      flag --log-stream-name-prefix <prefix> "Only streams with this prefix"
      arg <log-group> "Log group name"
    command describe-log-groups "List log groups"
      flag --log-group-name-prefix <prefix> "Only groups with this prefix"
      flag --log-group-name-pattern <pattern> "Only groups containing this text"
      flag --max-items <count> "Maximum items to return"
    command describe-log-streams "List log streams in a group"
      flag --log-group-name <name> "Log group name"
      flag --log-stream-name-prefix <prefix> "Only streams with this prefix"
      flag --order-by {LogStreamName,LastEventTime} "Sort key"
      flag --descending "Sort in descending order"
      flag --max-items <count> "Maximum items to return"
    command filter-log-events "Search events in a group"
      flag --log-group-name <name> "Log group name"
      flag --filter-pattern <pattern> "Filter pattern"
      flag --start-time <ms> "Start time in epoch milliseconds"
      flag --end-time <ms> "End time in epoch milliseconds"
      flag --log-stream-names <name> repeat "Only these streams"
    command get-log-events "Print events from one stream"
      flag --log-group-name <name> "Log group name"
      flag --log-stream-name <name> "Log stream name"
      flag --start-from-head "Read from the oldest event"
    command create-log-group "Create a log group"
      flag --log-group-name <name> "Log group name"
    command delete-log-group "Delete a log group"
      flag --log-group-name <name> "Log group name"
    command put-retention-policy "Set how long events are kept"
      flag --log-group-name <name> "Log group name"
      flag --retention-in-days <days> "Days to keep events"
    command start-query "Start a Logs Insights query"
      flag --log-group-name <name> "Log group name"
      flag --log-group-names <name> repeat "Log group names"
      flag --start-time <seconds> "Start time in epoch seconds"
      flag --end-time <seconds> "End time in epoch seconds"
      flag --query-string <query> "Logs Insights query"
    command get-query-results "Print a query's results"
      flag --query-id <id> "Query ID from start-query"

  command cloudformation "CloudFormation stacks"
    command deploy "Create or update a stack through a change set"
      flag --template-file <file> "Template file"
      flag --stack-name <name> "Stack name"
      flag --parameter-overrides <key=value> repeat "Template parameters"
      flag --capabilities {CAPABILITY_IAM,CAPABILITY_NAMED_IAM,CAPABILITY_AUTO_EXPAND} repeat "Acknowledged capabilities"
      flag --s3-bucket <bucket> "Bucket for templates over 51,200 bytes"
      flag --role-arn <arn> "Role CloudFormation assumes"
      flag --tags <key=value> repeat "Stack tags"
      flag --no-execute-changeset "Create the change set without running it"
      flag --no-fail-on-empty-changeset "Succeed when nothing changed"
    command package "Upload local artifacts and write a deployable template"
      flag --template-file <file> "Template file"
      flag --s3-bucket <bucket> "Bucket to upload artifacts to"
      flag --s3-prefix <prefix> "Key prefix for artifacts"
      flag --output-template-file <file> "Where to write the packaged template"
    command create-stack "Create a stack"
      flag --stack-name <name> "Stack name"
      flag --template-body <template> "Template body or file://path"
      flag --template-url <url> "Template URL in S3"
      flag --parameters <param> repeat "Parameters, such as ParameterKey=k,ParameterValue=v"
      flag --capabilities {CAPABILITY_IAM,CAPABILITY_NAMED_IAM,CAPABILITY_AUTO_EXPAND} repeat "Acknowledged capabilities"
      flag --tags <tag> repeat "Stack tags"
    command update-stack "Update a stack"
      flag --stack-name <name> "Stack name"
      flag --template-body <template> "Template body or file://path"
      flag --template-url <url> "Template URL in S3"
      flag --use-previous-template "Keep the current template"
      flag --parameters <param> repeat "Parameters"
      flag --capabilities {CAPABILITY_IAM,CAPABILITY_NAMED_IAM,CAPABILITY_AUTO_EXPAND} repeat "Acknowledged capabilities"
    command delete-stack "Delete a stack"
      flag --stack-name <name> "Stack name"
    command describe-stacks "Describe stacks"
      flag --stack-name <name> "Stack name; all stacks when omitted"
    command describe-stack-events "List a stack's events"
      flag --stack-name <name> "Stack name"
    command list-stacks "List stack summaries"
      flag --stack-status-filter <status> repeat "Only stacks in these states"
    command list-stack-resources "List a stack's resources"
      flag --stack-name <name> "Stack name"
    command get-template "Print a stack's template"
      flag --stack-name <name> "Stack name"
    command validate-template "Check a template's syntax"
      flag --template-body <template> "Template body or file://path"
      flag --template-url <url> "Template URL in S3"
    command list-exports "List exported output values"
    command wait "Wait for a stack state"
      command stack-create-complete "Wait until creation finishes"
        flag --stack-name <name> "Stack name"
      command stack-update-complete "Wait until an update finishes"
        flag --stack-name <name> "Stack name"
      command stack-delete-complete "Wait until deletion finishes"
        flag --stack-name <name> "Stack name"

  command ecr "Elastic Container Registry"
    command get-login-password "Print a registry password for docker login"
    command describe-repositories "Describe repositories"
      flag --repository-names <name> repeat "Repository names"
    command create-repository "Create a repository"
      flag --repository-name <name> "Repository name"
      flag --image-tag-mutability {MUTABLE,IMMUTABLE} "Whether tags can be overwritten"
      flag --image-scanning-configuration <config> "Such as scanOnPush=true"
    command delete-repository "Delete a repository"
      flag --repository-name <name> "Repository name"
      flag --force "Delete even if it contains images"
    command list-images "List images in a repository"
      flag --repository-name <name> "Repository name"
    command describe-images "Describe images in a repository"
      flag --repository-name <name> "Repository name"
      flag --image-ids <id> repeat "Images, such as imageTag=latest"
    command batch-delete-image "Delete images"
      flag --repository-name <name> "Repository name"
      flag --image-ids <id> repeat "Images, such as imageTag=latest"

  command ecs "Elastic Container Service"
    command list-clusters "List clusters"
    command describe-clusters "Describe clusters"
      flag --clusters <name> repeat "Cluster names or ARNs"
    command list-services "List services in a cluster"
      flag --cluster <name> "Cluster name or ARN"
    command describe-services "Describe services"
      flag --cluster <name> "Cluster name or ARN"
      flag --services <name> repeat "Service names or ARNs"
    command update-service "Change a service"
      flag --cluster <name> "Cluster name or ARN"
      flag --service <name> "Service name or ARN"
      flag --desired-count <n> "Number of tasks to keep running"
      flag --task-definition <family:revision> "Task definition to run"
      flag --force-new-deployment "Start a new deployment"
    command list-tasks "List tasks"
      flag --cluster <name> "Cluster name or ARN"
      flag --service-name <name> "Only tasks of this service"
      flag --desired-status {RUNNING,PENDING,STOPPED} "Only tasks with this status"
    command describe-tasks "Describe tasks"
      flag --cluster <name> "Cluster name or ARN"
      flag --tasks <id> repeat "Task IDs or ARNs"
    command run-task "Start a task"
      flag --cluster <name> "Cluster name or ARN"
      flag --task-definition <family:revision> "Task definition to run"
      flag --count <n> "Number of tasks"
      flag --launch-type {EC2,FARGATE,EXTERNAL} "Launch type"
      flag --network-configuration <config> "Subnets and security groups"
      flag --overrides <json> "Container overrides"
    command stop-task "Stop a task"
      flag --cluster <name> "Cluster name or ARN"
      flag --task <id> "Task ID or ARN"
      flag --reason <text> "Reason shown on the task"
    command execute-command "Run a command in a running container"
      flag --cluster <name> "Cluster name or ARN"
      flag --task <id> "Task ID or ARN"
      flag --container <name> "Container name"
      flag --command <command> "Command to run"
      flag --interactive "Open an interactive session"
    command list-task-definitions "List task definitions"
      flag --family-prefix <family> "Only this family"
      flag --status {ACTIVE,INACTIVE,DELETE_IN_PROGRESS} "Only this status"
    command describe-task-definition "Describe a task definition"
      flag --task-definition <family:revision> "Task definition"
    command register-task-definition "Register a task definition"
      flag --cli-input-json <json> "Definition JSON or file://path"
      flag --family <family> "Family name"
      flag --container-definitions <json> "Container definitions"

  command eks "Elastic Kubernetes Service"
    command list-clusters "List clusters"
    command describe-cluster "Describe a cluster"
      flag --name <name> "Cluster name"
    command update-kubeconfig "Add a cluster to the kubeconfig"
      flag --name <name> "Cluster name"
      flag --alias <alias> "Context name to use"
      flag --role-arn <arn> "Role to assume for authentication"
      flag --kubeconfig <file> "Kubeconfig file to write"
      flag --dry-run "Print the result without writing it"

  command dynamodb "DynamoDB tables"
    command list-tables "List tables"
    command describe-table "Describe a table"
      flag --table-name <name> "Table name"
    command create-table "Create a table"
      flag --table-name <name> "Table name"
      flag --attribute-definitions <def> repeat "Key attributes, such as AttributeName=id,AttributeType=S"
      flag --key-schema <key> repeat "Key schema, such as AttributeName=id,KeyType=HASH"
      flag --billing-mode {PROVISIONED,PAY_PER_REQUEST} "Billing mode"
      flag --provisioned-throughput <capacity> "Read and write capacity units"
    command delete-table "Delete a table"
      flag --table-name <name> "Table name"
    command get-item "Read one item"
      flag --table-name <name> "Table name"
      flag --key <json> "Primary key JSON"
      flag --projection-expression <expr> "Attributes to return"
      flag --consistent-read excludes=--no-consistent-read "Strongly consistent read"
      flag --no-consistent-read "Eventually consistent read"
    command put-item "Write one item"
      flag --table-name <name> "Table name"
      flag --item <json> "Item JSON"
      flag --condition-expression <expr> "Write only if this holds"
      flag --expression-attribute-values <json> "Expression values"
    command update-item "Change attributes of one item"
      flag --table-name <name> "Table name"
      flag --key <json> "Primary key JSON"
      flag --update-expression <expr> "Update expression"
      flag --condition-expression <expr> "Update only if this holds"
      flag --expression-attribute-names <json> "Expression name placeholders"
      flag --expression-attribute-values <json> "Expression values"
      flag --return-values {NONE,ALL_OLD,UPDATED_OLD,ALL_NEW,UPDATED_NEW} "What to return"
    command delete-item "Delete one item"
      flag --table-name <name> "Table name"
      flag --key <json> "Primary key JSON"
      flag --condition-expression <expr> "Delete only if this holds"
    command query "Read items by key"
      flag --table-name <name> "Table name"
      flag --index-name <name> "Secondary index to query"
      flag --key-condition-expression <expr> "Key condition"
      flag --filter-expression <expr> "Filter applied after the read"
      flag --expression-attribute-names <json> "Expression name placeholders"
      flag --expression-attribute-values <json> "Expression values"
      flag --projection-expression <expr> "Attributes to return"
      flag --select {ALL_ATTRIBUTES,ALL_PROJECTED_ATTRIBUTES,SPECIFIC_ATTRIBUTES,COUNT} "What to return"
      flag --scan-index-forward excludes=--no-scan-index-forward "Ascending sort key order"
      flag --no-scan-index-forward "Descending sort key order"
      flag --max-items <count> "Maximum items to return"
    command scan "Read every item"
      flag --table-name <name> "Table name"
      flag --index-name <name> "Secondary index to scan"
      flag --filter-expression <expr> "Filter applied after the read"
      flag --expression-attribute-names <json> "Expression name placeholders"
      flag --expression-attribute-values <json> "Expression values"
      flag --projection-expression <expr> "Attributes to return"
      flag --max-items <count> "Maximum items to return"
    command batch-write-item "Put or delete many items"
      flag --request-items <json> "Requests JSON or file://path"

  command secretsmanager "Secrets Manager"
    command list-secrets "List secrets"
      flag --filters <filter> repeat "Filters, such as Key=name,Values=prod"
      flag --max-items <count> "Maximum items to return"
    command describe-secret "Show a secret's metadata"
      flag --secret-id <id> "Secret name or ARN"
    command get-secret-value "Print a secret's value"
      flag --secret-id <id> "Secret name or ARN"
      flag --version-id <id> "Version ID"
      flag --version-stage <stage> "Version stage, such as AWSCURRENT"
    command create-secret "Create a secret"
      flag --name <name> "Secret name"
      flag --secret-string <value> "Secret text or file://path"
      flag --secret-binary <value> "Secret bytes or fileb://path"
      flag --description <text> "Description"
      flag --kms-key-id <key-id> "KMS key to encrypt with"
    command put-secret-value "Store a new secret version"
      flag --secret-id <id> "Secret name or ARN"
      flag --secret-string <value> "Secret text or file://path"
      flag --secret-binary <value> "Secret bytes or fileb://path"
    command update-secret "Change a secret's value or settings"
      flag --secret-id <id> "Secret name or ARN"
      flag --secret-string <value> "Secret text or file://path"
      flag --description <text> "Description"
      flag --kms-key-id <key-id> "KMS key to encrypt with"
    command delete-secret "Schedule a secret for deletion"
      flag --secret-id <id> "Secret name or ARN"
      flag --recovery-window-in-days <days> excludes=--force-delete-without-recovery "Days before deletion"
      flag --force-delete-without-recovery "Delete immediately"
    command restore-secret "Cancel a scheduled deletion"
      flag --secret-id <id> "Secret name or ARN"
    command rotate-secret "Rotate a secret now"
      flag --secret-id <id> "Secret name or ARN"

  command ssm "Systems Manager"
    command get-parameter "Print a parameter"
      flag --name <name> "Parameter name"
      flag --with-decryption excludes=--no-with-decryption "Decrypt SecureString values"
      flag --no-with-decryption "Return SecureString values encrypted"
    command get-parameters "Print several parameters"
      flag --names <name> repeat "Parameter names"
      flag --with-decryption excludes=--no-with-decryption "Decrypt SecureString values"
      flag --no-with-decryption "Return SecureString values encrypted"
    command get-parameters-by-path "Print parameters under a path"
      flag --path <path> "Hierarchy path, such as /app/prod"
      flag --recursive "Include nested levels"
      flag --with-decryption excludes=--no-with-decryption "Decrypt SecureString values"
      flag --no-with-decryption "Return SecureString values encrypted"
    command put-parameter "Create or update a parameter"
      flag --name <name> "Parameter name"
      flag --value <value> "Parameter value"
      flag --type {String,StringList,SecureString} "Parameter type"
      flag --overwrite "Replace an existing value"
      flag --description <text> "Description"
      flag --key-id <key-id> "KMS key for SecureString"
      flag --tier {Standard,Advanced,Intelligent-Tiering} "Parameter tier"
    command delete-parameter "Delete a parameter"
      flag --name <name> "Parameter name"
    command describe-parameters "List parameter metadata"
      flag --parameter-filters <filter> repeat "Filters"
      flag --max-items <count> "Maximum items to return"
    command start-session "Open a Session Manager session"
      flag --target <instance-id> "Instance to connect to"
      flag --document-name <name> "Session document, such as AWS-StartPortForwardingSession"
      flag --parameters <params> "Document parameters"
    command send-command "Run a command document on instances"
      flag --instance-ids <id> repeat "Instance IDs"
      flag --targets <target> repeat "Targets, such as Key=tag:Role,Values=web"
      flag --document-name <name> "Document, such as AWS-RunShellScript"
      flag --parameters <params> "Document parameters"
      flag --comment <text> "Comment"
    command list-commands "List sent commands"
      flag --command-id <id> "Only this command"
    command get-command-invocation "Show a command's result on one instance"
      flag --command-id <id> "Command ID"
      flag --instance-id <id> "Instance ID"
    command describe-instance-information "List managed instances"

#test "aws " => +s3 +ec2 +configure +sso +--profile +--region +--output
#test "aws --output " => +json +yaml-stream +table -s3
#test "aws --output=y" => +yaml +yaml-stream
#test "aws --region eu-" => +eu-north-1 +eu-west-1 -us-east-1
#test "aws s3 cp --region=us-w" => +us-west-2
#test "aws s3 " => +ls +cp +sync +presign +mb
#test "aws s3 sync --" => +--delete +--exclude +--profile +--no-cli-pager
#test "aws --profile dev s3 ls -" => ---profile +--recursive
#test "aws s3 cp --recursive --" => ---recursive +--exclude +--storage-class
#test "aws s3 cp --exclude a --exclude b --ex" => +--exclude
#test "aws s3 cp --storage-class " => +STANDARD_IA +DEEP_ARCHIVE
#test "aws s3 cp --follow-symlinks --no" => ---no-follow-symlinks +--no-progress
#test "aws sts " => +get-caller-identity +assume-role
#test "aws ec2 describe-" => +describe-instances +describe-vpcs +describe-regions
#test "aws ec2 stop-instances --dry-run --" => ---no-dry-run +--force
#test "aws lambda invoke --invocation-type " => +Event +RequestResponse
#test "aws logs tail --format=s" => +short
#test "aws configure " => +list +list-profiles +sso +get +set
#test "aws configure export-credentials --format " => +env +process
#test "aws cloudformation deploy --capabilities " => +CAPABILITY_IAM
#test "aws cloudformation wait " => +stack-create-complete
#test "aws secretsmanager delete-secret --force-delete-without-recovery --" => ---recovery-window-in-days
#test "aws ssm get-parameter --" => +--name +--with-decryption
#test "aws ecs run-task --launch-type " => +FARGATE
#test "aws dynamodb update-item --return-values " => +ALL_NEW
#test "aws sso login --" => +--sso-session +--no-browser
#test "aws --cli-auto-prompt --" => ---no-cli-auto-prompt
