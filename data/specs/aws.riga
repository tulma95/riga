# Original Riga completion spec for the AWS CLI v2 (MIT). Format reference: docs/SPECS.md.
# Holds what the installed CLI's API models cannot say: global options, the hand-written commands
# (s3, configure, sso, logs tail, cloudformation deploy/package, eks update-kubeconfig, ...) and the
# customized API operations. Every other service and operation is generated at runtime from the
# installed CLI's botocore data (src/aws_cli.rs); this file wins where both define an operation.
# Profiles and SSO sessions are read from ~/.aws/config and ~/.aws/credentials; regions are a static list.
# Buckets, instances, functions, log groups, stacks, tables, secrets and parameters are not generated.
# `open`: without CLI data, services this file lacks do not stop completion.
command aws open "Manage Amazon Web Services from the command line"
  flag --profile <aws-profile> persistent "Use a named profile from the config or credentials file"
  flag --region {us-east-1,us-east-2,us-west-1,us-west-2,af-south-1,ap-east-1,ap-east-2,ap-south-1,ap-south-2,ap-southeast-1,ap-southeast-2,ap-southeast-3,ap-southeast-4,ap-southeast-5,ap-southeast-7,ap-northeast-1,ap-northeast-2,ap-northeast-3,ca-central-1,ca-west-1,eu-central-1,eu-central-2,eu-west-1,eu-west-2,eu-west-3,eu-south-1,eu-south-2,eu-north-1,il-central-1,me-south-1,me-central-1,mx-central-1,sa-east-1,us-gov-east-1,us-gov-west-1,cn-north-1,cn-northwest-1} persistent "Region to send requests to"
  flag --output {json,text,table,yaml,yaml-stream} persistent "Output format"
  flag --query <jmespath> persistent "JMESPath query to filter the response"
  flag --endpoint-url <url> persistent "Override the service endpoint URL"
  flag --debug persistent "Print debug logging"
  flag --no-cli-pager persistent "Disable the output pager"
  flag --cli-auto-prompt excludes=--no-cli-auto-prompt persistent "Turn on the interactive auto-prompt"
  flag --no-cli-auto-prompt persistent "Turn off the interactive auto-prompt"
  flag --no-verify-ssl persistent "Skip TLS certificate verification"
  flag --no-paginate persistent "Return only the first page of results"
  flag --no-sign-request persistent "Send requests without credentials"
  flag --ca-bundle <file> persistent "CA certificate bundle for TLS verification"
  flag --color {on,off,auto} persistent "Colored output"
  flag --cli-error-format {legacy,json,yaml,text,table,enhanced} persistent "Format of error output"
  flag --cli-binary-format {base64,raw-in-base64-out} persistent "How binary blob parameters are passed"
  flag --cli-read-timeout <seconds> persistent "Socket read timeout in seconds"
  flag --cli-connect-timeout <seconds> persistent "Socket connect timeout in seconds"
  flag --version "Print the CLI version"
  command help "Show documentation for a command"
    arg [<topic>] repeat "Service or topic"

  command configure "Set up credentials and settings interactively"
    command list "Show the configuration values in effect and their source"
    command list-profiles "List all profile names"
    command get "Print one configuration value"
      arg <name> "Setting name such as region or profile.dev.region"
    command set "Write one configuration value"
      arg <name> "Setting name"
      arg <value> "Value to store"
    command sso "Create a profile that signs in with IAM Identity Center"
    command sso-session "Create an SSO session section"
    command export-credentials "Print the profile's resolved credentials"
      flag --format {process,env,env-no-export,powershell,windows-cmd} "Output format"
    command import "Import credentials from a CSV file"
      flag --csv <file> "CSV file with access keys"

  command sso "Sign in with IAM Identity Center"
    command login "Sign in and cache an SSO access token"
      flag --sso-session <aws-sso-session> "SSO session to sign in with"
      flag --no-browser "Print the sign-in URL instead of opening a browser"
      flag --use-device-code "Use the device code flow"
    command logout "Remove cached SSO tokens"
    command list-accounts "List accounts the token can access"
      flag --access-token <token> "SSO access token"
    command list-account-roles "List roles in an account"
      flag --access-token <token> "SSO access token"
      flag --account-id <id> "Account ID"

  command sts "Security Token Service"
  command s3 "High-level S3 file commands"
    command ls "List buckets, or objects under a prefix"
      flag --recursive "List all objects under the prefix"
      flag --human-readable "Show sizes in readable units"
      flag --summarize "Show object count and total size"
      flag --page-size <count> "Objects per request"
      flag --request-payer {requester} "Accept requester-pays charges"
      arg [<s3-uri>] "Bucket or prefix, as s3://bucket/prefix"
    command cp "Copy files and objects"
      flag --recursive "Copy all files under the directory or prefix"
      flag --dryrun "Show what would run without doing it"
      flag --quiet "Print nothing"
      flag --only-show-errors "Print only errors"
      flag --no-progress "Hide the progress line"
      flag --exclude <pattern> repeat "Skip paths matching the pattern"
      flag --include <pattern> repeat "Do not skip paths matching the pattern"
      flag --acl {private,public-read,public-read-write,authenticated-read,aws-exec-read,bucket-owner-read,bucket-owner-full-control,log-delivery-write} "Canned ACL"
      flag --storage-class {STANDARD,REDUCED_REDUNDANCY,STANDARD_IA,ONEZONE_IA,INTELLIGENT_TIERING,GLACIER,DEEP_ARCHIVE,GLACIER_IR} "Storage class"
      flag --sse {AES256,aws:kms,aws:kms:dsse} "Server-side encryption"
      flag --sse-kms-key-id <key-id> "KMS key for server-side encryption"
      flag --content-type <type> "Content type to set"
      flag --cache-control <value> "Cache-Control header to set"
      flag --metadata <key=value> "Metadata to set"
      flag --source-region <region> "Region of the source bucket"
      flag --follow-symlinks excludes=--no-follow-symlinks "Follow symbolic links"
      flag --no-follow-symlinks "Do not follow symbolic links"
      flag --expected-size <bytes> "Size of a streamed upload"
      arg <source> "Local path, s3:// URI or - for stdin"
      arg <destination> "Local path, s3:// URI or - for stdout"
    command mv "Move files and objects"
      flag --recursive "Move all files under the directory or prefix"
      flag --dryrun "Show what would run without doing it"
      flag --quiet "Print nothing"
      flag --only-show-errors "Print only errors"
      flag --no-progress "Hide the progress line"
      flag --exclude <pattern> repeat "Skip paths matching the pattern"
      flag --include <pattern> repeat "Do not skip paths matching the pattern"
      flag --acl {private,public-read,public-read-write,authenticated-read,aws-exec-read,bucket-owner-read,bucket-owner-full-control,log-delivery-write} "Canned ACL"
      flag --storage-class {STANDARD,REDUCED_REDUNDANCY,STANDARD_IA,ONEZONE_IA,INTELLIGENT_TIERING,GLACIER,DEEP_ARCHIVE,GLACIER_IR} "Storage class"
      flag --sse {AES256,aws:kms,aws:kms:dsse} "Server-side encryption"
      arg <source> "Local path or s3:// URI"
      arg <destination> "Local path or s3:// URI"
    command rm "Delete objects"
      flag --recursive "Delete all objects under the prefix"
      flag --dryrun "Show what would run without doing it"
      flag --quiet "Print nothing"
      flag --only-show-errors "Print only errors"
      flag --exclude <pattern> repeat "Skip keys matching the pattern"
      flag --include <pattern> repeat "Do not skip keys matching the pattern"
      arg <s3-uri> "Object or prefix, as s3://bucket/key"
    command sync "Copy new and changed files between directories and prefixes"
      flag --delete "Delete destination files missing from the source"
      flag --dryrun "Show what would run without doing it"
      flag --quiet "Print nothing"
      flag --only-show-errors "Print only errors"
      flag --no-progress "Hide the progress line"
      flag --exclude <pattern> repeat "Skip paths matching the pattern"
      flag --include <pattern> repeat "Do not skip paths matching the pattern"
      flag --size-only "Compare by size only"
      flag --exact-timestamps "Treat differing timestamps as changes"
      flag --acl {private,public-read,public-read-write,authenticated-read,aws-exec-read,bucket-owner-read,bucket-owner-full-control,log-delivery-write} "Canned ACL"
      flag --storage-class {STANDARD,REDUCED_REDUNDANCY,STANDARD_IA,ONEZONE_IA,INTELLIGENT_TIERING,GLACIER,DEEP_ARCHIVE,GLACIER_IR} "Storage class"
      flag --sse {AES256,aws:kms,aws:kms:dsse} "Server-side encryption"
      flag --cache-control <value> "Cache-Control header to set"
      flag --follow-symlinks excludes=--no-follow-symlinks "Follow symbolic links"
      flag --no-follow-symlinks "Do not follow symbolic links"
      arg <source> "Local directory or s3:// URI"
      arg <destination> "Local directory or s3:// URI"
    command mb "Create a bucket"
      arg <s3-uri> "Bucket, as s3://bucket"
    command rb "Remove a bucket"
      flag --force "Delete all objects first"
      arg <s3-uri> "Bucket, as s3://bucket"
    command presign "Print a pre-signed URL for an object"
      flag --expires-in <seconds> "Seconds until the URL expires"
      arg <s3-uri> "Object, as s3://bucket/key"

  command s3api "Low-level S3 API operations"
  command ec2 "Elastic Compute Cloud"
    command run-instances "Launch instances"
      flag --image-id <ami> "AMI to launch"
      flag --instance-type <type> "Instance type, such as t3.micro"
      flag --count <n> "Number of instances"
      flag --key-name <name> "Key pair name"
      flag --security-group-ids <id> repeat "Security group IDs"
      flag --subnet-id <id> "Subnet to launch in"
      flag --iam-instance-profile <profile> "Instance profile, such as Name=role"
      flag --user-data <data> "User data or file://path"
      flag --tag-specifications <spec> repeat "Tags for the new resources"
      flag --associate-public-ip-address excludes=--no-associate-public-ip-address "Give the instance a public IPv4 address"
      flag --no-associate-public-ip-address "Do not give the instance a public IPv4 address"
      flag --secondary-private-ip-addresses <ip> repeat "Secondary private IPv4 addresses"
      flag --secondary-private-ip-address-count <n> "Number of secondary private IPv4 addresses"
      flag --dry-run excludes=--no-dry-run "Check permissions only"
      flag --no-dry-run "Make the request"

  command iam "Identity and Access Management"
  command lambda "Lambda functions"
    command create-function "Create a function"
      flag --function-name <name> "Function name"
      flag --runtime <runtime> "Runtime, such as python3.12"
      flag --role <arn> "Execution role ARN"
      flag --handler <handler> "Handler, such as app.handler"
      flag --zip-file <fileb-uri> "Deployment package as fileb://path"
      flag --code <code> "Code location, such as S3Bucket=b,S3Key=k"
      flag --package-type {Zip,Image} "Deployment package type"
      flag --timeout <seconds> "Timeout in seconds"
      flag --memory-size <mb> "Memory in MB"
      flag --environment <vars> "Such as Variables={KEY=value}"

  command logs "CloudWatch Logs"
    command tail "Print log events from a group, optionally following"
      flag --follow "Keep printing new events"
      flag --since <time> "Start time, such as 10m, 2h or a timestamp"
      flag --format {detailed,short,json} "Event format"
      flag --filter-pattern <pattern> "Only matching events"
      flag --log-stream-names <name> repeat "Only these streams"
      flag --log-stream-name-prefix <prefix> "Only streams with this prefix"
      arg <log-group> "Log group name"

  command cloudformation "CloudFormation stacks"
    command deploy "Create or update a stack through a change set"
      flag --template-file <file> "Template file"
      flag --stack-name <name> "Stack name"
      flag --parameter-overrides <key=value> repeat "Template parameters"
      flag --capabilities {CAPABILITY_IAM,CAPABILITY_NAMED_IAM,CAPABILITY_AUTO_EXPAND} repeat "Acknowledged capabilities"
      flag --s3-bucket <bucket> "Bucket for templates over 51,200 bytes"
      flag --role-arn <arn> "Role CloudFormation assumes"
      flag --tags <key=value> repeat "Stack tags"
      flag --no-execute-changeset "Create the change set without running it"
      flag --no-fail-on-empty-changeset "Succeed when nothing changed"
    command package "Upload local artifacts and write a deployable template"
      flag --template-file <file> "Template file"
      flag --s3-bucket <bucket> "Bucket to upload artifacts to"
      flag --s3-prefix <prefix> "Key prefix for artifacts"
      flag --output-template-file <file> "Where to write the packaged template"
    command wait "Wait for a stack state"
      command stack-create-complete "Wait until creation finishes"
        flag --stack-name <name> "Stack name"
      command stack-update-complete "Wait until an update finishes"
        flag --stack-name <name> "Stack name"
      command stack-delete-complete "Wait until deletion finishes"
        flag --stack-name <name> "Stack name"

  command ecr "Elastic Container Registry"
  command ecs "Elastic Container Service"
  command eks "Elastic Kubernetes Service"
    command update-kubeconfig "Add a cluster to the kubeconfig"
      flag --name <name> "Cluster name"
      flag --alias <alias> "Context name to use"
      flag --role-arn <arn> "Role to assume for authentication"
      flag --kubeconfig <file> "Kubeconfig file to write"
      flag --dry-run "Print the result without writing it"

  command dynamodb "DynamoDB tables"
  command secretsmanager "Secrets Manager"
  command ssm "Systems Manager"

#test "aws " => +s3 +ec2 +configure +sso +--profile +--region +--output
#test "aws --output " => +json +yaml-stream +table -s3
#test "aws --output=y" => +yaml +yaml-stream
#test "aws --region eu-" => +eu-north-1 +eu-west-1 -us-east-1
#test "aws s3 cp --region=us-w" => +us-west-2
#test "aws s3 " => +ls +cp +sync +presign +mb
#test "aws s3 sync --" => +--delete +--exclude +--profile +--no-cli-pager
#test "aws --profile dev s3 ls -" => ---profile +--recursive
#test "aws s3 cp --recursive --" => ---recursive +--exclude +--storage-class
#test "aws s3 cp --exclude a --exclude b --ex" => +--exclude
#test "aws s3 cp --storage-class " => +STANDARD_IA +DEEP_ARCHIVE
#test "aws s3 cp --follow-symlinks --no" => ---no-follow-symlinks +--no-progress
#test "aws rds describe-db-instances --pro" => +--profile ---version
#test "aws sts get-caller-identity --out" => +--output
#test "aws ec2 run-instances --dry-run --" => ---no-dry-run +--count +--profile
#test "aws ec2 run-" => +run-instances
#test "aws lambda create-function --package-type " => +Zip +Image
#test "aws logs tail --format=s" => +short
#test "aws configure " => +list +list-profiles +sso +get +set
#test "aws configure export-credentials --format " => +env +process
#test "aws cloudformation deploy --capabilities " => +CAPABILITY_IAM
#test "aws cloudformation wait " => +stack-create-complete
#test "aws sso login --" => +--sso-session +--no-browser
#test "aws --cli-auto-prompt --" => ---no-cli-auto-prompt
