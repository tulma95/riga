# Original Riga completion spec for a Visual Studio Code CLI subset (MIT). Format reference: docs/SPECS.md.
# Installed extension IDs and profile names come from local VS Code data; locales, tunnel names and tokens are not generated.
command code "Visual Studio Code editor"
  flag --help|-h persistent "Print usage"
  flag --verbose persistent "Print verbose output (implies --wait)"
  flag --log {critical,error,warn,info,debug,trace,off} repeat persistent "Log level to use"
  flag --version|-v "Print version"
  flag --diff|-d <file> "Compare two files with each other"
  flag --merge|-m <file> "Three-way merge: two modified files, their base and the result file"
  flag --add|-a <directory> "Add a folder to the last active window"
  flag --remove <directory> "Remove a folder from the last active window"
  flag --goto|-g <file:line> "Open a file at a line and optional column"
  flag --new-window|-n excludes=--reuse-window "Open a new window"
  flag --reuse-window|-r "Open in an already opened window"
  flag --wait|-w "Wait for the files to be closed before returning"
  flag --agents "Open the agents window"
  flag --locale <locale> "Locale to use, such as en-US"
  flag --user-data-dir <directory> "Directory for user data, for separate instances"
  flag --profile <vscode-profile> "Open with the given profile, creating it if needed"
  flag --extensions-dir <directory> "Root path for extensions"
  flag --list-extensions "List installed extensions"
  flag --show-versions requires=--list-extensions "Show extension versions in the list"
  flag --category <category> requires=--list-extensions "Filter listed extensions by category"
  flag --install-extension <vscode-extension> repeat "Install or update an extension by ID or VSIX path"
  flag --pre-release "Install the pre-release version of the extension"
  flag --force "Update an extension to the latest version"
  flag --uninstall-extension <vscode-extension> repeat "Uninstall an extension"
  flag --update-extensions "Update installed extensions"
  flag --enable-proposed-api <vscode-extension> repeat "Enable proposed API features for an extension"
  flag --add-mcp <json> "Add a Model Context Protocol server definition"
  flag --status|-s "Print process usage and diagnostics"
  flag --prof-startup "Run the CPU profiler during startup"
  flag --disable-extensions "Disable all installed extensions for this window"
  flag --disable-extension <vscode-extension> repeat "Disable one extension for this window"
  flag --sync {on,off} "Turn settings sync on or off"
  flag --inspect-extensions <port> "Allow debugging and profiling of extensions"
  flag --inspect-brk-extensions <port> "Debug extensions with the extension host paused at start"
  flag --disable-lcd-text "Disable LCD font rendering"
  flag --disable-gpu "Disable GPU hardware acceleration"
  flag --disable-chromium-sandbox "Disable the Chromium sandbox"
  flag --locate-shell-integration-path {bash,pwsh,zsh,fish} "Print the path to a shell integration script"
  flag --telemetry "Show all telemetry events collected"
  flag --transient "Run with temporary data and extension directories"
  arg [<path>] repeat "Files or folders to open; - reads stdin"
  command chat "Run a prompt in a chat session in the current directory"
    flag --mode|-m <mode> "Chat mode: ask, edit, agent or a custom mode"
    flag --add-file|-a <file> repeat "Add a file as context"
    flag --maximize "Maximize the chat session view"
    flag --reuse-window|-r excludes=--new-window "Use the last active window"
    flag --new-window|-n "Open an empty window for the chat"
    flag --profile <vscode-profile> "Open with the given profile"
    arg [<prompt>] repeat "Prompt text; - reads stdin"
  command serve-web "Run a server that shows the editor UI in browsers"
    flag --cli-data-dir <directory> persistent "Directory for CLI metadata"
    flag --host <host> "Host to listen on"
    flag --socket-path <file> "Unix socket to listen on"
    flag --port <port> "Port to listen on, 0 for a random one"
    flag --connection-token <token> excludes=--without-connection-token "Secret required with every request"
    flag --connection-token-file <file> excludes=--without-connection-token "File holding the connection secret"
    flag --without-connection-token "Run without a connection token"
    flag --accept-server-license-terms "Accept the server license terms without a prompt"
    flag --server-base-path <path> "URL path for the web UI and server"
    flag --server-data-dir <directory> "Directory for server data"
    flag --default-folder <directory> "Folder to open when the URL names none"
    flag --default-workspace <file> "Workspace to open when the URL names none"
    flag --disable-telemetry "Disable telemetry"
    flag --commit-id <sha> "Use a specific client commit"
  command tunnel "Make this machine reachable from vscode.dev through a secure tunnel"
    flag --cli-data-dir <directory> persistent "Directory for CLI metadata"
    flag --install-extension <extension-id> repeat "Preload an extension on connecting servers"
    flag --server-data-dir <directory> "Directory for server data"
    flag --extensions-dir <directory> "Root path for extensions"
    flag --reconnection-grace-time <seconds> "Reconnection grace time in seconds"
    flag --random-name excludes=--name "Pick a random machine name"
    flag --no-sleep "Keep the machine awake while running"
    flag --name <name> "Machine name for port forwarding"
    flag --accept-server-license-terms "Accept the server license terms without a prompt"
    command prune "Delete all servers that are not running"
    command kill "Stop any running tunnel"
    command restart "Restart any running tunnel"
    command status "Show whether a tunnel is running"
    command rename "Rename this machine for port forwarding"
      arg <name> "New machine name"
    command unregister "Remove this machine from the port forwarding service"
    command user "Manage the port forwarding account"
      command login "Log in to the port forwarding service"
        flag --access-token <token> "Access token to store"
        flag --refresh-token <token> "Refresh token to store"
        flag --provider {microsoft,github} "Authentication provider"
      command logout "Log out of the port forwarding service"
      command show "Show the logged-in account"
    command service "Manage the tunnel as a system service (preview)"
      command install "Install or reinstall the tunnel service"
        flag --accept-server-license-terms "Accept the server license terms without a prompt"
        flag --name <name> "Machine name for port forwarding"
      command uninstall "Uninstall and stop the tunnel service"
      command log "Show logs of the running service"

#test "code " => +chat +tunnel +serve-web +--diff +-n
#test "code --" => +--new-window +--install-extension +--help ---show-versions
#test "code --list-extensions --" => +--show-versions +--category
#test "code -n --re" => ---reuse-window
#test "code --wait --w" => ---wait
#test "code --log " => +trace +off -chat
#test "code --log=c" => +critical
#test "code --sync " => +on +off
#test "code --locate-shell-integration-path=z" => +zsh
#test "code chat -" => +-m +--add-file +--help +--log ---diff
#test "code chat -n --re" => ---reuse-window
#test "code tunnel " => +user +service +prune +rename
#test "code tunnel --random-name --na" => ---name
#test "code tunnel user login --provider " => +github +microsoft
#test "code tunnel user login --provider=g" => +github
#test "code tunnel service install --" => +--cli-data-dir +--verbose +--name
#test "code serve-web --without-connection-token --conn" => ---connection-token ---connection-token-file
#test "code serve-web --" => +--port +--cli-data-dir ---diff
