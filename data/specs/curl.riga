# Original Riga completion spec for curl 8.x, checked against 8.7.1 (macOS) and 8.22 (MIT). Format reference: docs/SPECS.md.
# URLs, headers, data, credentials and hosts are free text; only file and directory values complete paths.
command curl "Transfer data from or to a server"
  # Request
  flag --request|-X {GET,POST,PUT,PATCH,DELETE,HEAD,OPTIONS,CONNECT,TRACE} "HTTP method or protocol command to use"
  flag --request-target <path> "Target to send instead of the URL path"
  flag --header|-H <header> repeat "Add a request header, or @file to read headers from"
  flag --get|-G "Send -d data as a URL query string with GET"
  flag --head|-I excludes=--data,--data-raw,--data-binary,--data-urlencode,--data-ascii,--json,--form,--form-string,--upload-file "Fetch headers only"
  flag --url <url> repeat "URL to fetch"
  flag --url-query <name=value> repeat "Add a URL-encoded query parameter"
  flag --globoff|-g "Do not treat {} and [] in URLs as globs"
  flag --path-as-is "Do not squash /../ and /./ in the URL path"
  flag --location|-L excludes=--follow "Follow redirects"
  flag --location-trusted "Follow redirects and send credentials to other hosts"
  flag --follow "Follow redirects the way the HTTP method says to (8.16+)"
  flag --max-redirs <num> "Maximum number of redirects to follow"
  flag --post301 "Keep POST after a 301 redirect"
  flag --post302 "Keep POST after a 302 redirect"
  flag --post303 "Keep POST after a 303 redirect"
  flag --range|-r <range> "Fetch only a byte range, such as 0-499"
  flag --continue-at|-C <offset> "Resume at a byte offset, or - to work it out"
  flag --time-cond|-z <time> "Only fetch if modified since a date or a file's mtime"
  flag --compressed "Request a compressed response and decompress it"
  flag --tr-encoding "Request a compressed Transfer-Encoding"
  flag --raw "Pass HTTP content and transfer encodings through undecoded"
  flag --ignore-content-length "Ignore the Content-Length header"
  flag --user-agent|-A <name> "User-Agent header to send"
  flag --referer|-e <url> "Referer header to send"
  flag --http0.9 "Accept HTTP/0.9 responses"
  flag --expect100-timeout <seconds> "How long to wait for a 100-continue response"
  flag --variable <name=value> repeat "Set a variable for --expand-* options, or name@file"
  flag --rate <rate> "Maximum request rate for serial transfers, such as 2/s"
  # Body
  flag --data|-d <data> repeat "Send POST data, or @file to read it from a file"
  flag --data-raw <data> repeat "Send POST data without treating @ specially"
  flag --data-binary <data> repeat "Send POST data exactly as given, or @file"
  flag --data-urlencode <data> repeat "URL-encode and send POST data"
  flag --data-ascii <data> repeat "Send POST data, same as --data"
  flag --json <data> repeat "Send JSON data with JSON headers, or @file"
  flag --form|-F <name=content> repeat "Send a multipart form field; @file uploads a file"
  flag --form-string <name=string> repeat "Send a multipart form field literally"
  flag --form-escape "Escape multipart form field and file names with backslashes"
  flag --upload-file|-T <file> repeat "Upload a file with PUT"
  flag --append|-a "Append to the remote file when uploading"
  flag --crlf "Convert LF to CRLF when uploading"
  flag --upload-flags <flags> "IMAP flags for the uploaded message (8.13+)"
  # Output
  flag --output|-o <file> repeat "Write the body to a file"
  flag --output-dir <directory> "Directory to save output files in"
  flag --create-dirs "Create missing directories for --output"
  flag --create-file-mode <mode> "File mode for created files, such as 0644"
  flag --remote-name|-O repeat "Save to a file named after the URL"
  flag --remote-name-all "Use --remote-name for every URL"
  flag --remote-header-name|-J "Use the Content-Disposition file name"
  flag --remote-time|-R "Set the local file's time to the remote one"
  flag --no-clobber "Do not overwrite existing files; add a number instead"
  flag --skip-existing "Skip the download if the output file exists (8.10+)"
  flag --remove-on-error "Delete the output file if the transfer fails"
  flag --out-null "Discard the response body (8.16+)"
  flag --dump-header|-D <file> "Write response headers to a file"
  flag --include|-i|--show-headers "Include response headers in the output"
  flag --write-out|-w <format> "Print information after the transfer, or @file"
  flag --stderr <file> "Redirect stderr to a file"
  flag --no-buffer|-N "Disable output buffering"
  flag --xattr "Store metadata in extended file attributes"
  flag --etag-save <file> "Save the response ETag to a file"
  flag --etag-compare <file> "Fetch only if the ETag differs from the one in a file"
  flag --libcurl <file> "Write C code that does the same transfer to a file"
  flag --styled-output "Show response header names in bold"
  flag --suppress-connect-headers "Hide proxy CONNECT response headers"
  # Verbosity and errors
  flag --verbose|-v "Show request and response details"
  flag --trace <file> "Write a full trace, including data, to a file"
  flag --trace-ascii <file> "Write a full trace without hex to a file"
  flag --trace-config <list> "Trace components to log, such as all,-tls"
  flag --trace-ids "Add transfer and connection IDs to trace output"
  flag --trace-time "Add timestamps to trace output"
  flag --silent|-s "Hide the progress meter and errors"
  flag --show-error|-S "Show errors even with --silent"
  flag --no-progress-meter "Hide only the progress meter"
  flag --progress-bar|-# "Show a simple progress bar"
  flag --fail|-f excludes=--fail-with-body "Fail silently on HTTP errors"
  flag --fail-with-body "Fail on HTTP errors but still output the body"
  flag --fail-early "Stop at the first failed transfer"
  # Authentication
  flag --user|-u <user:password> "Server user name and password"
  flag --oauth2-bearer <token> "OAuth 2 bearer token"
  flag --basic "Use HTTP Basic authentication"
  flag --digest "Use HTTP Digest authentication"
  flag --ntlm "Use HTTP NTLM authentication"
  flag --ntlm-wb "Use NTLM authentication through winbind (removed in 8.8)"
  flag --negotiate "Use SPNEGO authentication"
  flag --anyauth "Pick the most secure method the server supports"
  flag --aws-sigv4 <provider> "Sign requests with AWS V4 signatures"
  flag --delegation {none,policy,always} "GSS-API credential delegation"
  flag --service-name <name> "SPNEGO service name"
  flag --sasl-authzid <identity> "Identity to act as in SASL PLAIN authentication"
  flag --sasl-ir "Send the initial response in the first SASL message"
  flag --login-options <options> "Server login options, such as AUTH=*"
  flag --disallow-username-in-url "Refuse URLs that contain a user name"
  flag --netrc|-n excludes=--netrc-optional "Read credentials from ~/.netrc"
  flag --netrc-optional "Use ~/.netrc if it exists"
  flag --netrc-file <file> "Read credentials from this netrc file"
  flag --krb <level> "Kerberos security level for FTP: clear, safe, confidential or private"
  # Cookies, HSTS and Alt-Svc
  flag --cookie|-b <file> repeat "Send cookies from a string or a cookie file"
  flag --cookie-jar|-c <file> "Write cookies to a file after the transfer"
  flag --junk-session-cookies|-j "Ignore session cookies read from a file"
  flag --hsts <file> repeat "HSTS cache file to read and update"
  flag --alt-svc <file> repeat "Alt-Svc cache file to read and update"
  # TLS
  flag --insecure|-k "Skip TLS certificate verification"
  flag --cacert <file> "CA certificate bundle to verify with"
  flag --capath <directory> "Directory of CA certificates"
  flag --ca-native "Use the operating system's CA store"
  flag --dump-ca-embed "Print the CA bundle built into curl (8.13+)"
  flag --crlfile <file> "Certificate revocation list in PEM format"
  flag --cert|-E <file> "Client certificate, optionally file:password"
  flag --cert-type {PEM,DER,ENG,P12} "Client certificate type"
  flag --cert-status "Check the server certificate with OCSP stapling"
  flag --key <file> "Private key for the client certificate or SSH"
  flag --key-type {PEM,DER,ENG} "Private key type"
  flag --pass <phrase> "Passphrase for the private key"
  flag --pinnedpubkey <file> "Public key or sha256// hashes to pin"
  flag --ciphers <list> "TLS 1.2 cipher suites to use"
  flag --tls13-ciphers <list> "TLS 1.3 cipher suites to use"
  flag --curves <list> "TLS key exchange groups to request"
  flag --sigalgs <list> "TLS signature algorithms to use (8.14+)"
  flag --ech <config> "Encrypted Client Hello: false, grease, true, hard, ecl: or pn: (8.8+)"
  flag --tlsv1|-1 "Use TLS 1.0 or later"
  flag --tlsv1.0 "Use TLS 1.0 or later"
  flag --tlsv1.1 "Use TLS 1.1 or later"
  flag --tlsv1.2 "Use TLS 1.2 or later"
  flag --tlsv1.3 "Use TLS 1.3 or later"
  flag --sslv2|-2 "SSLv2 (no longer supported)"
  flag --sslv3|-3 "SSLv3 (no longer supported)"
  flag --tls-max {1.0,1.1,1.2,1.3,default} "Highest TLS version to allow"
  flag --tls-earlydata "Send TLS 1.3 early data (8.12+)"
  flag --tlsauthtype {SRP} "TLS authentication type"
  flag --tlsuser <name> "TLS-SRP user name"
  flag --tlspassword <password> "TLS-SRP password"
  flag --ssl "Try TLS for FTP, IMAP, POP3 and SMTP"
  flag --ssl-reqd "Require TLS for the connection"
  flag --ssl-allow-beast "Allow the BEAST TLS flaw for compatibility"
  flag --ssl-no-revoke "Skip certificate revocation checks (Schannel)"
  flag --ssl-revoke-best-effort "Ignore missing revocation information (Schannel)"
  flag --ssl-auto-client-cert "Find a client certificate automatically (Schannel)"
  flag --ssl-sessions <file> "File to load and save TLS session tickets (8.12+)"
  flag --no-sessionid "Do not reuse TLS session IDs"
  flag --no-alpn "Do not send the ALPN TLS extension"
  flag --no-npn "Do not send the NPN TLS extension"
  flag --false-start "Use TLS False Start"
  flag --random-file <file> "File to read random data from (deprecated)"
  flag --egd-file <file> "EGD socket for random data (deprecated)"
  flag --engine <name> "OpenSSL crypto engine, or list"
  flag --proto <protocols> "Protocols to allow, such as =https"
  flag --proto-redir <protocols> "Protocols to allow on redirects"
  flag --proto-default <protocol> "Scheme for URLs that have none"
  # Protocol versions
  flag --http1.0|-0 excludes=--http1.1,--http2,--http2-prior-knowledge,--http3,--http3-only "Use HTTP/1.0"
  flag --http1.1 excludes=--http2,--http2-prior-knowledge,--http3,--http3-only "Use HTTP/1.1"
  flag --http2 excludes=--http2-prior-knowledge,--http3,--http3-only "Use HTTP/2"
  flag --http2-prior-knowledge excludes=--http3,--http3-only "Use HTTP/2 without an HTTP/1.1 upgrade"
  flag --http3 excludes=--http3-only "Use HTTP/3, falling back to earlier versions"
  flag --http3-only "Use HTTP/3 only"
  flag --ipv4|-4 excludes=--ipv6 "Resolve names to IPv4 addresses only"
  flag --ipv6|-6 "Resolve names to IPv6 addresses only"
  # Connection
  flag --resolve <host:port:addr> repeat "Use this address for a host and port"
  flag --connect-to <host:port:host:port> repeat "Connect to another host and port instead"
  flag --interface <name> "Network interface or address to use"
  flag --local-port <range> "Local port or port range to use"
  flag --unix-socket <file> "Connect through a Unix domain socket"
  flag --abstract-unix-socket <path> "Connect through an abstract Unix domain socket"
  flag --dns-servers <addresses> "DNS servers to use instead of the system's"
  flag --dns-interface <interface> "Interface to send DNS requests from"
  flag --dns-ipv4-addr <address> "IPv4 address to send DNS requests from"
  flag --dns-ipv6-addr <address> "IPv6 address to send DNS requests from"
  flag --doh-url <url> "Resolve host names over DNS-over-HTTPS"
  flag --doh-insecure "Skip TLS verification of the DoH server"
  flag --doh-cert-status "Check the DoH server certificate with OCSP stapling"
  flag --happy-eyeballs-timeout-ms <ms> "Head start for IPv6 before trying IPv4"
  flag --haproxy-protocol "Send an HAProxy PROXY v1 header"
  flag --haproxy-clientip <ip> "Client address to send in the HAProxy PROXY header"
  flag --tcp-nodelay "Disable Nagle's algorithm"
  flag --tcp-fastopen "Use TCP Fast Open"
  flag --mptcp "Use Multipath TCP (8.9+)"
  flag --ip-tos <value> "IP type of service or traffic class (8.9+)"
  flag --vlan-priority <priority> "VLAN priority, 0 to 7 (8.9+)"
  flag --max-time|-m <seconds> "Maximum time for the whole transfer"
  flag --connect-timeout <seconds> "Maximum time to connect"
  flag --keepalive-time <seconds> "Idle time before keepalive probes"
  flag --keepalive-cnt <count> "Keepalive probes before giving up (8.9+)"
  flag --no-keepalive "Disable TCP keepalive"
  flag --limit-rate <speed> "Maximum transfer rate, such as 100K or 1M"
  flag --speed-limit|-Y <bytes> "Abort transfers slower than this many bytes per second"
  flag --speed-time|-y <seconds> "How long a transfer may stay below --speed-limit"
  flag --max-filesize <bytes> "Do not download files larger than this"
  flag --retry <num> "Retry transient failures this many times"
  flag --retry-delay <seconds> requires=--retry "Wait this long between retries"
  flag --retry-max-time <seconds> requires=--retry "Stop retrying after this long"
  flag --retry-all-errors requires=--retry "Retry on any error"
  flag --retry-connrefused requires=--retry "Retry on connection refused"
  # Proxies
  flag --proxy|-x <url> "Proxy to use"
  flag --proxy-user|-U <user:password> "Proxy user name and password"
  flag --noproxy <hosts> "Hosts that bypass the proxy"
  flag --preproxy <url> "SOCKS proxy to go through before the HTTP proxy"
  flag --proxytunnel|-p "Tunnel through the HTTP proxy with CONNECT"
  flag --proxy1.0 <host:port> "Use an HTTP/1.0 proxy"
  flag --proxy-header <header> repeat "Header to send to the proxy, or @file"
  flag --proxy-anyauth "Pick any authentication method for the proxy"
  flag --proxy-basic "Use Basic authentication with the proxy"
  flag --proxy-digest "Use Digest authentication with the proxy"
  flag --proxy-negotiate "Use SPNEGO authentication with the proxy"
  flag --proxy-ntlm "Use NTLM authentication with the proxy"
  flag --proxy-service-name <name> "SPNEGO service name for the proxy"
  flag --proxy-http2 "Use HTTP/2 with an HTTPS proxy"
  flag --proxy-http3 "Use HTTP/3 with an HTTPS proxy (8.17+)"
  flag --proxy-insecure "Skip TLS verification of the HTTPS proxy"
  flag --proxy-cacert <file> "CA bundle to verify the proxy with"
  flag --proxy-capath <directory> "CA directory to verify the proxy with"
  flag --proxy-ca-native "Use the operating system's CA store for the proxy"
  flag --proxy-crlfile <file> "Certificate revocation list for the proxy"
  flag --proxy-cert <file> "Client certificate for the HTTPS proxy, optionally file:password"
  flag --proxy-cert-type {PEM,DER,ENG,P12} "Client certificate type for the proxy"
  flag --proxy-key <file> "Private key for the HTTPS proxy"
  flag --proxy-key-type {PEM,DER,ENG} "Private key type for the proxy"
  flag --proxy-pass <phrase> "Passphrase for the proxy private key"
  flag --proxy-pinnedpubkey <file> "Public key or sha256// hashes to pin for the proxy"
  flag --proxy-ciphers <list> "TLS 1.2 cipher suites for the proxy"
  flag --proxy-tls13-ciphers <list> "TLS 1.3 cipher suites for the proxy"
  flag --proxy-tlsv1 "Use TLS 1.0 or later with the proxy"
  flag --proxy-tlsauthtype {SRP} "TLS authentication type for the proxy"
  flag --proxy-tlsuser <name> "TLS-SRP user name for the proxy"
  flag --proxy-tlspassword <password> "TLS-SRP password for the proxy"
  flag --proxy-ssl-allow-beast "Allow the BEAST TLS flaw with the proxy"
  flag --proxy-ssl-auto-client-cert "Find a proxy client certificate automatically (Schannel)"
  flag --socks4 <host:port> "SOCKS4 proxy"
  flag --socks4a <host:port> "SOCKS4a proxy"
  flag --socks5 <host:port> "SOCKS5 proxy"
  flag --socks5-hostname <host:port> "SOCKS5 proxy that resolves names"
  flag --socks5-basic "Use user name and password authentication with SOCKS5"
  flag --socks5-gssapi "Use GSS-API authentication with SOCKS5"
  flag --socks5-gssapi-nec "Use the NEC SOCKS5 GSS-API variant"
  flag --socks5-gssapi-service <name> "GSS-API service name for SOCKS5"
  # FTP, SSH, mail and other protocols
  flag --list-only|-l "List names only (FTP, POP3, SFTP)"
  flag --use-ascii|-B "Use ASCII transfer mode (FTP, LDAP)"
  flag --quote|-Q <command> repeat "Send a command to an FTP or SFTP server"
  flag --ftp-port|-P <address> "Use active FTP mode with this address"
  flag --ftp-pasv "Use passive FTP mode (default)"
  flag --ftp-pret "Send PRET before PASV"
  flag --ftp-skip-pasv-ip "Ignore the address the server sends for PASV"
  flag --disable-epsv "Do not use EPSV"
  flag --disable-eprt "Do not use EPRT or LPRT"
  flag --ftp-create-dirs "Create missing remote directories"
  flag --ftp-method {multicwd,nocwd,singlecwd} "How to reach the remote file"
  flag --ftp-account <data> "FTP ACCT data"
  flag --ftp-alternative-to-user <command> "Command to send instead of USER"
  flag --ftp-ssl-ccc "Send CCC after authenticating"
  flag --ftp-ssl-ccc-mode {active,passive} "CCC mode"
  flag --ftp-ssl-control "Require TLS for the login only"
  flag --pubkey <file> "SSH public key file"
  flag --hostpubmd5 <md5> "Expected MD5 of the SSH host key"
  flag --hostpubsha256 <sha256> "Expected SHA-256 of the SSH host key"
  flag --knownhosts <file> "SSH known_hosts file (8.17+)"
  flag --compressed-ssh "Use SSH compression"
  flag --mail-from <address> "SMTP sender address"
  flag --mail-rcpt <address> repeat "SMTP recipient address"
  flag --mail-rcpt-allowfails "Continue when some recipients are rejected"
  flag --mail-auth <address> "Address of the original sender for SMTP AUTH"
  flag --telnet-option|-t <opt=val> repeat "Telnet option"
  flag --tftp-blksize <bytes> "TFTP block size"
  flag --tftp-no-options "Send no TFTP options"
  flag --ipfs-gateway <url> "Gateway for ipfs:// and ipns:// URLs"
  flag --metalink "Treat URLs as Metalink files (disabled)"
  # Parallel and config
  flag --parallel|-Z "Do transfers in parallel"
  flag --parallel-max <num> requires=--parallel "Maximum parallel transfers"
  flag --parallel-max-host <num> requires=--parallel "Maximum connections to one host (8.16+)"
  flag --parallel-immediate requires=--parallel "Prefer new connections over waiting to reuse"
  flag --next|-: repeat "Use separate options for the following URLs"
  flag --config|-K <file> repeat "Read options from a config file"
  flag --disable|-q "Do not read ~/.curlrc (must be first)"
  flag --help|-h "Print usage; add a category such as all, http or tls"
  flag --manual|-M "Print the full manual"
  flag --version|-V "Print version and features"
  arg <url> repeat "URLs to fetch"
#test "curl --re" => +--request +--resolve +--retry ---head
#test "curl -X " => +GET +POST +PATCH +OPTIONS +CONNECT
#test "curl --request=P" => +POST +PUT +PATCH -GET
#test "curl -L --lo" => ---location +--location-trusted
#test "curl -sSL https://example.com --s" => ---silent ---show-error +--ssl
#test "curl -sSL https://example.com --ou" => +--output
#test "curl -H 'Accept: a' -H 'B: c' --hea" => +--header +--head
#test "curl -I --da" => ---data ---data-raw ---data-binary
#test "curl -d x --he" => ---head +--header
#test "curl --fail --fail" => ---fail-with-body +--fail-early
#test "curl --ret" => +--retry ---retry-delay ---retry-all-errors
#test "curl --retry 3 --retry-" => +--retry-delay +--retry-all-errors
#test "curl --http2 --http" => ---http1.1 ---http3 ---http1.0 ---http2-prior-knowledge
#test "curl -4 --ipv" => ---ipv6
#test "curl --tls-max " => +1.2 +1.3 +default
#test "curl -o out.json --out" => +--output +--output-dir +--out-null
#test "curl -Z --parallel-" => +--parallel-max +--parallel-max-host
#test "curl -X" => +-X
#test "curl '-#' --progr" => ---progress-bar
#test "curl '-#sL' --loc" => ---location +--location-trusted
#test "curl -p -x proxy:8080 --proxy-" => +--proxy-header +--proxy-insecure 
#test "curl -i --show" => ---show-headers +--show-error
#test "curl --ftp-method " => +nocwd +singlecwd
#test "curl a -: b --ne" => +--next +--negotiate
