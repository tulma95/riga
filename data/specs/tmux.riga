# Original Riga completion spec for a tmux subset (MIT). Format reference: docs/SPECS.md.
# Session, window, pane and buffer names come from `tmux list-*` on the default server; client, option and key names are not generated.
# tmux accepts unique command prefixes (`tmux a`); only the documented aliases plus `a` are listed.
# Command separators (`\;`) and nested tmux commands in bind-key/if-shell are not modelled.
command tmux "Terminal multiplexer"
  flag -2 "Assume the terminal supports 256 colours"
  flag -C repeat "Start in control mode (twice disables echo)"
  flag -D "Do not daemonize the server"
  flag -c <shell-command> "Run a shell command with the default shell"
  flag -f <file> "Use an alternative configuration file"
  flag -L <socket-name> "Use a named server socket"
  flag -S <file> "Use an explicit server socket path"
  flag -T <features> "Set terminal features for the client"
  flag -l "Behave as a login shell"
  flag -N "Do not start the server unless a command needs it"
  flag -u "Assume UTF-8 output"
  flag -V "Print the tmux version"
  flag -v repeat "Write verbose logs to files"
  command attach-session|attach|a "Attach this terminal to a session"
    flag -d "Detach other clients from the session"
    flag -E "Do not apply update-environment"
    flag -r "Attach read-only"
    flag -x "Send SIGHUP to the parent of other clients"
    flag -c <directory> "Set the session working directory"
    flag -f <flags> "Client flags"
    flag -t <tmux-session> "Session to attach to"
  command new-session|new "Create a new session"
    flag -A "Attach if the session already exists"
    flag -d "Do not attach to the new session"
    flag -D "Detach other clients when attaching with -A"
    flag -E "Do not apply update-environment"
    flag -P "Print information about the new session"
    flag -X "Send SIGHUP to other clients when attaching with -A"
    flag -c <directory> "Start directory"
    flag -e <name=value> repeat "Set an environment variable"
    flag -F <format> requires=-P "Format for -P output"
    flag -f <flags> "Client flags"
    flag -n <window-name> "Name of the first window"
    flag -s <session-name> "Name of the session"
    flag -t <tmux-session> "Group with an existing session"
    flag -x <width> "Width of a detached session"
    flag -y <height> "Height of a detached session"
    arg [<shell-command>] stop "Command to run in the first window"
    arg [<argument>] repeat "Command arguments"
  command new-window|neww "Create a new window"
    flag -a "Insert after the target window"
    flag -b "Insert before the target window"
    flag -d "Do not make the new window current"
    flag -k "Replace an existing window at the target index"
    flag -P "Print information about the new window"
    flag -S "Select an existing window with the same name"
    flag -c <directory> "Start directory"
    flag -e <name=value> repeat "Set an environment variable"
    flag -F <format> requires=-P "Format for -P output"
    flag -n <window-name> "Name of the window"
    flag -t <tmux-window> "Target window index"
    arg [<shell-command>] stop "Command to run in the window"
    arg [<argument>] repeat "Command arguments"
  command split-window|splitw "Split a pane into two"
    flag -b "Place the new pane left of or above the target"
    flag -d "Do not make the new pane active"
    flag -f "Span the full window width or height"
    flag -h excludes=-v "Split horizontally (side by side)"
    flag -v "Split vertically (one above the other)"
    flag -I "Show stdin in the new pane"
    flag -P "Print information about the new pane"
    flag -Z "Zoom the new pane"
    flag -c <directory> "Start directory"
    flag -e <name=value> repeat "Set an environment variable"
    flag -F <format> requires=-P "Format for -P output"
    flag -l <size> "Size of the new pane in lines, columns or percent"
    flag -t <tmux-pane> "Pane to split"
    arg [<shell-command>] stop "Command to run in the new pane"
    arg [<argument>] repeat "Command arguments"
  command detach-client|detach "Detach a client"
    flag -a "Detach all clients except the target"
    flag -P "Send SIGHUP to the parent process"
    flag -E <shell-command> "Run a command to replace the client"
    flag -s <tmux-session> "Detach all clients of a session"
    flag -t <target-client> "Client to detach"
  command has-session|has "Check whether a session exists"
    flag -t <tmux-session> "Session to check"
  command kill-server "Kill the server and all sessions"
  command kill-session "Destroy a session"
    flag -a "Kill all sessions except the target"
    flag -C "Clear alerts in all windows of the session"
    flag -t <tmux-session> "Session to kill"
  command kill-window|killw "Destroy a window"
    flag -a "Kill all windows except the target"
    flag -t <tmux-window> "Window to kill"
  command kill-pane|killp "Destroy a pane"
    flag -a "Kill all panes except the target"
    flag -t <tmux-pane> "Pane to kill"
  command list-sessions|ls "List sessions"
    flag -F <format> "Output format"
    flag -f <filter> "Only list sessions matching a filter"
  command list-windows|lsw "List windows"
    flag -a "List windows of all sessions"
    flag -F <format> "Output format"
    flag -f <filter> "Only list windows matching a filter"
    flag -t <tmux-session> "Session to list"
  command list-panes|lsp "List panes"
    flag -a "List panes on the whole server"
    flag -s "List panes of the target session"
    flag -F <format> "Output format"
    flag -f <filter> "Only list panes matching a filter"
    flag -t <tmux-window> "Window or session to list"
  command list-clients|lsc "List attached clients"
    flag -F <format> "Output format"
    flag -f <filter> "Only list clients matching a filter"
    flag -t <tmux-session> "Only clients of a session"
  command list-keys|lsk "List key bindings"
    flag -1 "Show only the first matching binding"
    flag -a "Also list keys without notes with -N"
    flag -N "List keys with notes"
    flag -P <prefix-string> "Prefix for each key with -N"
    flag -T <key-table> "Key table to list"
    arg [<key>] "Key to show"
  command list-commands|lscm "List tmux commands"
    flag -F <format> "Output format"
    arg [<command>] "Command to show"
  command list-buffers|lsb "List paste buffers"
    flag -F <format> "Output format"
    flag -f <filter> "Only list buffers matching a filter"
  command rename-session|rename "Rename a session"
    flag -t <tmux-session> "Session to rename"
    arg <new-name> "New session name"
  command rename-window|renamew "Rename a window"
    flag -t <tmux-window> "Window to rename"
    arg <new-name> "New window name"
  command select-window|selectw "Select a window"
    flag -l "Select the last window"
    flag -n "Select the next window"
    flag -p "Select the previous window"
    flag -T "Toggle to the last window if already selected"
    flag -t <tmux-window> "Window to select"
  command select-pane|selectp "Select a pane"
    flag -D "Select the pane below"
    flag -L "Select the pane to the left"
    flag -R "Select the pane to the right"
    flag -U "Select the pane above"
    flag -l "Select the last pane"
    flag -d "Disable input to the pane"
    flag -e "Enable input to the pane"
    flag -M "Clear the marked pane"
    flag -m "Mark the pane"
    flag -Z "Keep the window zoomed"
    flag -T <title> "Set the pane title"
    flag -t <tmux-pane> "Pane to select"
  command select-layout|selectl "Apply a window layout"
    flag -E "Spread panes out evenly"
    flag -n "Apply the next layout"
    flag -o "Apply the previous layout"
    flag -p "Apply the previous layout"
    flag -t <tmux-pane> "Window or pane to lay out"
    arg [{even-horizontal,even-vertical,main-horizontal,main-vertical,tiled}] "Layout name"
  command next-window|next "Move to the next window"
    flag -a "Move to the next window with an alert"
    flag -t <tmux-session> "Session"
  command previous-window|prev "Move to the previous window"
    flag -a "Move to the previous window with an alert"
    flag -t <tmux-session> "Session"
  command last-window|last "Select the last used window"
    flag -t <tmux-session> "Session"
  command switch-client|switchc "Switch a client to another session"
    flag -E "Do not apply update-environment"
    flag -l "Switch to the last session"
    flag -n "Switch to the next session"
    flag -p "Switch to the previous session"
    flag -r "Toggle read-only mode"
    flag -Z "Keep the window zoomed"
    flag -c <target-client> "Client to switch"
    flag -t <tmux-session> "Session to switch to"
    flag -T <key-table> "Set the client key table"
  command swap-pane|swapp "Swap two panes"
    flag -d "Do not change the active pane"
    flag -D "Swap with the next pane"
    flag -U "Swap with the previous pane"
    flag -Z "Keep the window zoomed"
    flag -s <tmux-pane> "Source pane"
    flag -t <tmux-pane> "Destination pane"
  command swap-window|swapw "Swap two windows"
    flag -d "Do not make the new window current"
    flag -s <tmux-window> "Source window"
    flag -t <tmux-window> "Destination window"
  command move-window|movew "Move a window"
    flag -a "Move after the destination window"
    flag -b "Move before the destination window"
    flag -d "Do not make the moved window current"
    flag -k "Kill the destination window if it exists"
    flag -r "Renumber windows in the session"
    flag -s <tmux-window> "Window to move"
    flag -t <tmux-window> "Destination"
  command break-pane|breakp "Move a pane into its own window"
    flag -a "Insert after the target window"
    flag -b "Insert before the target window"
    flag -d "Do not make the new window current"
    flag -P "Print information about the new window"
    flag -F <format> requires=-P "Format for -P output"
    flag -n <window-name> "Name of the new window"
    flag -s <tmux-pane> "Pane to break off"
    flag -t <tmux-window> "Destination window"
  command join-pane|joinp "Move a pane into another window"
    flag -b "Place the pane left of or above the target"
    flag -d "Do not make the moved pane active"
    flag -f "Span the full window width or height"
    flag -h excludes=-v "Join side by side"
    flag -v "Join one above the other"
    flag -l <size> "Size of the joined pane"
    flag -s <tmux-pane> "Pane to move"
    flag -t <tmux-pane> "Pane to join next to"
  command resize-pane|resizep "Resize a pane"
    flag -D <lines> "Resize downwards"
    flag -L <columns> "Resize to the left"
    flag -R <columns> "Resize to the right"
    flag -U <lines> "Resize upwards"
    flag -M "Begin mouse resizing"
    flag -T "Trim lines below the cursor"
    flag -Z "Toggle zoom of the pane"
    flag -x <width> "Absolute width"
    flag -y <height> "Absolute height"
    flag -t <tmux-pane> "Pane to resize"
  command respawn-pane|respawnp "Restart the command in a pane"
    flag -k "Kill the running command first"
    flag -c <directory> "Start directory"
    flag -e <name=value> repeat "Set an environment variable"
    flag -t <tmux-pane> "Pane to respawn"
    arg [<shell-command>] stop "Command to run"
    arg [<argument>] repeat "Command arguments"
  command send-keys|send "Send keys to a pane"
    flag -H "Keys are hexadecimal character codes"
    flag -l "Send keys literally"
    flag -M "Pass through a mouse event"
    flag -R "Reset the terminal state"
    flag -X "Send a copy-mode command"
    flag -N <repeat-count> "Repeat the keys"
    flag -t <tmux-pane> "Pane to send keys to"
    arg [<key>] repeat "Keys to send"
  command send-prefix "Send the prefix key to a pane"
    flag -2 "Send the secondary prefix key"
    flag -t <tmux-pane> "Pane"
  command capture-pane|capturep "Capture the contents of a pane"
    flag -a "Capture the alternate screen"
    flag -C "Escape non-printable characters as octal"
    flag -e "Include escape sequences for attributes"
    flag -J "Join wrapped lines and keep trailing spaces"
    flag -N "Keep trailing spaces"
    flag -p "Print to stdout instead of a buffer"
    flag -P "Capture only an incomplete escape sequence"
    flag -q "Suppress errors"
    flag -b <tmux-buffer> "Buffer to save into"
    flag -E <end-line> "Last line to capture"
    flag -S <start-line> "First line to capture"
    flag -t <tmux-pane> "Pane to capture"
  command copy-mode "Enter copy mode"
    flag -e "Exit copy mode when scrolled to the bottom"
    flag -H "Hide the position indicator"
    flag -M "Begin a mouse drag"
    flag -q "Cancel copy mode and other modes"
    flag -u "Scroll up one page"
    flag -s <tmux-pane> "Copy from another pane"
    flag -t <tmux-pane> "Pane"
  command choose-tree "Choose a session, window or pane interactively"
    flag -G "Include all sessions in groups"
    flag -N "Start without the preview"
    flag -r "Reverse the sort order"
    flag -s "Start with sessions collapsed"
    flag -w "Start with windows collapsed"
    flag -Z "Zoom the pane"
    flag -F <format> "Format for each item"
    flag -f <filter> "Filter items"
    flag -O <sort-order> "Sort order"
    flag -t <tmux-pane> "Pane"
    arg [<template>] "Command template"
  command display-message|display "Display a message"
    flag -a "List format variables"
    flag -I "Forward stdin to the pane"
    flag -p "Print to stdout"
    flag -v "Print verbose logging"
    flag -c <target-client> "Client"
    flag -d <delay> "Display time in milliseconds"
    flag -F <format> "Message format"
    flag -t <tmux-pane> "Pane for format expansion"
    arg [<message>] "Message or format"
  command display-popup|popup "Display a popup over a pane"
    flag -B "Draw the popup without a border"
    flag -C "Close any open popup"
    flag -E "Close the popup when the command exits"
    flag -c <target-client> "Client"
    flag -d <directory> "Start directory"
    flag -e <name=value> repeat "Set an environment variable"
    flag -h <height> "Popup height"
    flag -w <width> "Popup width"
    flag -x <position> "Horizontal position"
    flag -y <position> "Vertical position"
    flag -T <title> "Popup title"
    flag -t <tmux-pane> "Pane"
    arg [<shell-command>] stop "Command to run in the popup"
    arg [<argument>] repeat "Command arguments"
  command run-shell|run "Run a shell command"
    flag -b "Run in the background"
    flag -C "Run a tmux command instead"
    flag -c <directory> "Start directory"
    flag -d <delay> "Wait this many seconds first"
    flag -t <tmux-pane> "Pane to show output in"
    arg [<shell-command>] stop "Command to run"
    arg [<argument>] repeat "Command arguments"
  command source-file|source "Run tmux commands from files"
    flag -F "Expand the paths as formats"
    flag -n "Parse only, do not run"
    flag -q "Ignore missing files"
    flag -v "Show parsed commands"
    flag -t <tmux-pane> "Target for format expansion"
    arg <file> repeat "Files to source"
  command set-option|set "Set an option"
    flag -a "Append to a string or array option"
    flag -F "Expand formats in the value"
    flag -g "Set a global option"
    flag -o "Do not overwrite an existing option"
    flag -p "Set a pane option"
    flag -q "Suppress errors about unknown options"
    flag -s "Set a server option"
    flag -u "Unset the option"
    flag -U "Unset the option in the window and its panes"
    flag -w "Set a window option"
    flag -t <tmux-pane> "Target session, window or pane"
    arg <option> "Option name"
    arg [<value>] "Option value"
  command show-options|show "Show options"
    flag -A "Include inherited options"
    flag -g "Show global options"
    flag -H "Include hooks"
    flag -p "Show pane options"
    flag -q "Suppress errors about unknown options"
    flag -s "Show server options"
    flag -v "Show only values"
    flag -w "Show window options"
    flag -t <tmux-pane> "Target session, window or pane"
    arg [<option>] "Option name"
  command set-environment|setenv "Set an environment variable"
    flag -F "Expand the value as a format"
    flag -g "Set in the global environment"
    flag -h "Mark the variable as hidden"
    flag -r "Remove the variable when starting a process"
    flag -u "Unset the variable"
    flag -t <tmux-session> "Session"
    arg <variable> "Variable name"
    arg [<value>] "Variable value"
  command show-environment|showenv "Show environment variables"
    flag -g "Show the global environment"
    flag -h "Show hidden variables"
    flag -s "Print as shell commands"
    flag -t <tmux-session> "Session"
    arg [<variable>] "Variable name"
  command bind-key|bind "Bind a key to a command"
    flag -n "Bind in the root table (no prefix)"
    flag -r "Allow the key to repeat"
    flag -N <note> "Attach a note to the binding"
    flag -T <key-table> "Key table"
    arg <key> "Key"
    arg <command> stop "tmux command"
    arg [<argument>] repeat "Command arguments"
  command unbind-key|unbind "Remove a key binding"
    flag -a "Remove all bindings in the table"
    flag -n "Unbind from the root table"
    flag -q "Suppress errors"
    flag -T <key-table> "Key table"
    arg [<key>] "Key"
  command set-buffer|setb "Set a paste buffer"
    flag -a "Append to the buffer"
    flag -w "Send the buffer to the clipboard"
    flag -b <tmux-buffer> "Buffer name"
    flag -n <new-buffer-name> "Rename the buffer"
    flag -t <target-client> "Client for the clipboard"
    arg [<data>] "Buffer contents"
  command show-buffer|showb "Print a paste buffer"
    flag -b <tmux-buffer> "Buffer name"
  command paste-buffer|pasteb "Paste a buffer into a pane"
    flag -d "Delete the buffer after pasting"
    flag -p "Use bracketed paste if enabled"
    flag -r "Do not replace newlines with carriage returns"
    flag -S "Do not sanitize control characters"
    flag -s <separator> "Line separator"
    flag -b <tmux-buffer> "Buffer name"
    flag -t <tmux-pane> "Pane to paste into"
  command delete-buffer|deleteb "Delete a paste buffer"
    flag -b <tmux-buffer> "Buffer name"
  command save-buffer|saveb "Save a paste buffer to a file"
    flag -a "Append to the file"
    flag -b <tmux-buffer> "Buffer name"
    arg <file> "Destination path"
  command load-buffer|loadb "Load a file into a paste buffer"
    flag -w "Also send to the clipboard"
    flag -b <tmux-buffer> "Buffer name"
    flag -t <target-client> "Client for the clipboard"
    arg <file> "Source path"
  command start-server|start "Start the server without a session"
  command lock-server|lock "Lock all clients"
  command clear-history|clearhist "Clear a pane's scrollback"
    flag -H "Also clear hyperlinks"
    flag -t <tmux-pane> "Pane"

#test "tmux " => +attach +a +ls +kill-server +-L ---t
#test "tmux n" => +new-session +new +neww -attach
#test "tmux -L work a" => +attach-session +attach --L
#test "tmux -f " => -new -attach
#test "tmux -2u -" => --2 --u +-L
#test "tmux attach -" => +-t +-d ---L
#test "tmux new -s dev -" => --s +-d +-n ---F
#test "tmux new -P -" => +-F
#test "tmux splitw -h -" => ---v +-c
#test "tmux split-window -v -" => ---h
#test "tmux joinp -" => +-h +-v
#test "tmux select-layout " => +tiled +main-vertical
#test "tmux selectl -t 1 even" => +even-horizontal +even-vertical
#test "tmux ls -" => +-F +-f ---t
#test "tmux new -d htop -" => ---s
#test "tmux bind r source-file -" => ---n
#test "tmux kill-session -a -" => --a +-t
