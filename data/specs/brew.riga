# Original Riga completion spec for a Homebrew subset (MIT). Format reference: docs/SPECS.md.
# Formula, cask and tap names come from the Homebrew prefix and API cache; search text, URLs and command names are not generated.
command brew "The missing package manager for macOS"
  flag --debug|-d persistent "Display debugging information"
  flag --quiet|-q persistent "Make output quieter"
  flag --verbose|-v persistent "Make output more verbose"
  flag --help|-h persistent "Show help for the command"
  flag --version "Print the Homebrew version"
  flag --prefix "Print the Homebrew prefix, or a formula's prefix"
  flag --cellar "Print the Homebrew Cellar path"
  flag --cache "Print the download cache path"
  flag --repository|--repo "Print the Homebrew repository path"
  flag --caskroom "Print the Caskroom path"
  flag --env "Print the build environment"
  command install "Install formulae or casks"
    flag --formula|--formulae excludes=--cask "Treat all arguments as formulae"
    flag --cask|--casks excludes=--formula "Treat all arguments as casks"
    flag --force|-f "Install even if already installed or keg-only"
    flag --dry-run|-n "Show what would be installed without installing"
    flag --no-ask|--yes|-y "Skip the confirmation prompt"
    flag --build-from-source|-s excludes=--force-bottle "Compile from source even if a bottle exists"
    flag --force-bottle excludes=--build-from-source "Install from a bottle even if options would prevent it"
    flag --HEAD "Install the HEAD version from the upstream repository"
    flag --fetch-HEAD "Check upstream for HEAD changes"
    flag --ignore-dependencies "Skip installing dependencies (unsupported)"
    flag --only-dependencies "Install only the dependencies"
    flag --include-test "Also install test dependencies"
    flag --cc <compiler> "Compiler to build with"
    flag --keep-tmp "Keep temporary build files"
    flag --debug-symbols "Generate debug symbols when building"
    flag --build-bottle "Build for later bottling"
    flag --skip-post-install "Skip post-install steps"
    flag --skip-link "Do not link the keg into the prefix"
    flag --as-dependency "Mark as installed as a dependency"
    flag --interactive|-i "Open a shell to build interactively"
    flag --git|-g "Create a Git repository for interactive builds"
    flag --overwrite "Overwrite conflicting files while linking"
    flag --display-times "Print install time for each package"
    flag --require-sha "Require casks to have a checksum"
    flag --adopt "Adopt existing app artifacts"
    flag --skip-cask-deps "Skip cask dependencies"
    flag --no-quarantine "Do not quarantine downloaded casks"
    flag --appdir <directory> "Target directory for applications"
    flag --fontdir <directory> "Target directory for fonts"
    arg <brew-package> repeat "Formula or cask to install"
  command reinstall "Uninstall and reinstall formulae or casks"
    flag --formula|--formulae excludes=--cask "Treat all arguments as formulae"
    flag --cask|--casks excludes=--formula "Treat all arguments as casks"
    flag --force|-f "Reinstall without checking existing installs"
    flag --no-ask|--yes|-y "Skip the confirmation prompt"
    flag --build-from-source|-s excludes=--force-bottle "Compile from source"
    flag --force-bottle excludes=--build-from-source "Install from a bottle"
    flag --interactive|-i "Open a shell to build interactively"
    flag --keep-tmp "Keep temporary build files"
    flag --adopt "Adopt existing app artifacts"
    flag --zap "Remove all files of the cask before reinstalling"
    flag --appdir <directory> "Target directory for applications"
    arg <brew-installed> repeat "Formula or cask to reinstall"
  command uninstall|remove|rm "Uninstall formulae or casks"
    flag --formula|--formulae excludes=--cask "Treat all arguments as formulae"
    flag --cask|--casks excludes=--formula "Treat all arguments as casks"
    flag --force|-f "Delete all installed versions"
    flag --zap "Remove all files associated with a cask"
    flag --ignore-dependencies "Uninstall even if other formulae depend on it"
    arg <brew-installed> repeat "Installed formula or cask"
  command upgrade "Upgrade outdated formulae and casks"
    flag --formula|--formulae excludes=--cask "Only upgrade formulae"
    flag --cask|--casks excludes=--formula "Only upgrade casks"
    flag --force|-f "Install without checking previous installs"
    flag --dry-run|-n "Show what would be upgraded without upgrading"
    flag --no-ask|--yes|-y "Skip the confirmation prompt"
    flag --build-from-source|-s excludes=--force-bottle "Compile from source"
    flag --force-bottle excludes=--build-from-source "Install from a bottle"
    flag --interactive|-i "Open a shell to build interactively"
    flag --fetch-HEAD "Check upstream for HEAD changes"
    flag --keep-tmp "Keep temporary build files"
    flag --overwrite "Overwrite conflicting files while linking"
    flag --display-times "Print install time for each package"
    flag --greedy|-g "Also upgrade casks that update themselves or are :latest"
    flag --greedy-latest "Also upgrade :latest casks"
    flag --greedy-auto-updates "Also upgrade self-updating casks"
    flag --skip-cask-deps "Skip cask dependencies"
    flag --no-quit "Do not quit running cask apps"
    flag --appdir <directory> "Target directory for applications"
    arg [<brew-installed>] repeat "Formula or cask to upgrade (default: all)"
  command update|up "Fetch the newest Homebrew and formula definitions"
    flag --force|-f "Always do a full update check"
    flag --auto-update "Behave like an automatic update"
  command outdated "List installed packages with newer versions available"
    flag --formula|--formulae excludes=--cask "Only list formulae"
    flag --cask|--casks excludes=--formula "Only list casks"
    flag --json [{v1,v2}] "Print JSON output"
    flag --fetch-HEAD "Check upstream for HEAD changes"
    flag --greedy|-g "Include casks that update themselves or are :latest"
    flag --greedy-latest "Include :latest casks"
    flag --greedy-auto-updates "Include self-updating casks"
    arg [<brew-installed>] repeat "Formula or cask to check"
  command search "Search formulae and casks by name"
    flag --formula|--formulae excludes=--cask "Only search formulae"
    flag --cask|--casks excludes=--formula "Only search casks"
    flag --desc "Also search descriptions"
    flag --pull-request "Search GitHub pull requests"
    flag --open requires=--pull-request excludes=--closed "Only open pull requests"
    flag --closed requires=--pull-request excludes=--open "Only closed pull requests"
    arg <text|/regex/> repeat "Search term"
  command info|abv "Show information about formulae or casks"
    flag --formula|--formulae excludes=--cask "Treat all arguments as formulae"
    flag --cask|--casks excludes=--formula "Treat all arguments as casks"
    flag --json [{v1,v2}] "Print JSON output"
    flag --installed requires=--json "Describe all installed packages"
    flag --github "Open the GitHub source page"
    flag --analytics "Show analytics data"
    flag --days {30,90,365} requires=--analytics "Days of analytics data"
    flag --sizes "Show installed sizes"
    arg [<brew-package>] repeat "Formula or cask"
  command list|ls "List installed formulae and casks"
    flag --formula|--formulae excludes=--cask "Only list formulae"
    flag --cask|--casks excludes=--formula "Only list casks"
    flag --full-name "Print fully-qualified formula names"
    flag --versions "Show installed versions"
    flag --multiple requires=--versions "Only formulae with several installed versions"
    flag --pinned "Only pinned formulae"
    flag --installed-on-request "Only formulae installed on request"
    flag --installed-as-dependency "Only formulae installed as dependencies"
    flag -1 "One entry per line"
    flag -l "Long listing format"
    flag -r "Reverse the sort order"
    flag -t "Sort by modification time"
    arg [<brew-installed>] repeat "List files of these packages"
  command deps "Show dependencies of formulae"
    flag --formula|--formulae excludes=--cask "Treat all arguments as formulae"
    flag --cask|--casks excludes=--formula "Treat all arguments as casks"
    flag --tree excludes=--graph "Show dependencies as a tree"
    flag --graph excludes=--tree "Show dependencies as a graph"
    flag --dot requires=--graph "Print the graph in DOT format"
    flag --direct|--declared|-1 "Only direct dependencies"
    flag --topological|-n "Sort in topological order"
    flag --installed "Dependencies of installed formulae"
    flag --missing "Only missing dependencies"
    flag --union "Union of dependencies for several formulae"
    flag --full-name "Print fully-qualified names"
    flag --include-build "Include build dependencies"
    flag --include-optional "Include optional dependencies"
    flag --include-test "Include test dependencies"
    flag --skip-recommended "Skip recommended dependencies"
    flag --annotate "Mark build, test, optional and recommended dependencies"
    flag --os <os> "Dependencies for this operating system"
    flag --arch {arm,intel} "Dependencies for this CPU architecture"
    arg [<brew-package>] repeat "Formula or cask"
  command uses "Show formulae that depend on a formula"
    flag --recursive "Resolve dependencies recursively"
    flag --installed excludes=--missing "Only installed dependents"
    flag --missing excludes=--installed "Only dependents that are not installed"
    flag --include-build "Include build dependents"
    flag --include-optional "Include optional dependents"
    flag --include-test "Include test dependents"
    flag --skip-recommended "Skip recommended dependents"
    arg <brew-formula> repeat "Formula"
  command leaves "List installed formulae no other formula depends on"
    flag --installed-on-request|-r excludes=--installed-as-dependency "Only manually installed leaves"
    flag --installed-as-dependency|-p excludes=--installed-on-request "Only leaves installed as dependencies"
  command autoremove "Uninstall formulae no longer needed as dependencies"
    flag --dry-run|-n "List what would be removed"
  command cleanup "Remove stale lock files, old versions and cache"
    flag --prune <days|all> "Remove cache files older than this many days"
    flag --dry-run|-n "Show what would be removed"
    flag --scrub|-s "Also remove downloads for current versions"
    flag --prune-prefix "Only prune broken symlinks in the prefix"
    arg [<brew-installed>] repeat "Formula or cask"
  command fetch "Download source packages or bottles"
    flag --formula|--formulae excludes=--cask "Treat all arguments as formulae"
    flag --cask|--casks excludes=--formula "Treat all arguments as casks"
    flag --force|-f "Remove the cached version and download again"
    flag --deps "Also download dependencies"
    flag --retry "Retry failed downloads"
    flag --HEAD "Fetch the HEAD version"
    flag --build-from-source|-s "Download source packages"
    flag --force-bottle "Download a bottle"
    flag --os <os> "Download for this operating system"
    flag --arch {arm,intel} "Download for this CPU architecture"
    flag --bottle-tag <tag> "Download the bottle for this tag"
    arg <brew-package> repeat "Formula or cask"
  command link|ln "Symlink a formula's files into the prefix"
    flag --overwrite "Overwrite conflicting files"
    flag --dry-run|-n "Show what would be linked"
    flag --force|-f "Allow linking keg-only formulae"
    flag --HEAD "Link the HEAD version"
    arg <brew-installed-formula> repeat "Installed formula"
  command unlink "Remove a formula's symlinks from the prefix"
    flag --dry-run|-n "Show what would be unlinked"
    arg <brew-installed-formula> repeat "Installed formula"
  command pin "Prevent formulae from being upgraded"
    arg <brew-installed-formula> repeat "Installed formula"
  command unpin "Allow pinned formulae to be upgraded"
    arg <brew-pinned> repeat "Pinned formula"
  command tap "Add or list third-party repositories"
    flag --custom-remote "Set a custom remote for the tap"
    flag --repair "Repair tap symlinks"
    flag --force|-f "Force tapping core taps"
    arg [<user/repo>] "Tap to add"
    arg [<URL>] "Repository URL"
  command untap "Remove a tapped repository"
    flag --force|-f "Untap even if packages from it are installed"
    arg <brew-tap> repeat "Tap to remove"
  command services "Manage background services"
    command list "List managed services"
      flag --json "Print JSON output"
    command info "Show information about a service"
      flag --all "All services"
      flag --json "Print JSON output"
      arg [<brew-installed-formula>] repeat "Service formula"
    command run "Run a service without registering it"
      flag --all "All services"
      flag --file <file> "Use this service file"
      arg [<brew-installed-formula>] repeat "Service formula"
    command start "Start a service and register it to launch at login"
      flag --all "All services"
      flag --file <file> "Use this service file"
      arg [<brew-installed-formula>] repeat "Service formula"
    command stop "Stop a service and unregister it"
      flag --all "All services"
      flag --keep "Keep the service registered"
      flag --no-wait excludes=--max-wait "Do not wait for the service to stop"
      flag --max-wait <seconds> excludes=--no-wait "Seconds to wait for the service to stop"
      arg [<brew-installed-formula>] repeat "Service formula"
    command kill "Stop a service but keep it registered"
      flag --all "All services"
      arg [<brew-installed-formula>] repeat "Service formula"
    command restart "Restart a service and register it"
      flag --all "All services"
      flag --file <file> "Use this service file"
      arg [<brew-installed-formula>] repeat "Service formula"
    command cleanup "Remove unused services"
  command bundle "Install or manage packages from a Brewfile"
    flag --file <file> excludes=--global "Brewfile to use"
    flag --global|-g excludes=--file "Use the global Brewfile"
    command install "Install everything in the Brewfile"
      flag --no-upgrade "Do not upgrade outdated dependencies"
      flag --cleanup "Uninstall everything not in the Brewfile"
      flag --file <file> "Brewfile to use"
    command dump "Write installed packages to a Brewfile"
      flag --force|-f "Overwrite an existing Brewfile"
      flag --describe "Add descriptions as comments"
      flag --file <file> "Brewfile to write"
    command check "Check whether the Brewfile is satisfied"
      flag --file <file> "Brewfile to check"
    command cleanup "Uninstall packages not in the Brewfile"
      flag --force|-f "Actually uninstall instead of listing"
      flag --file <file> "Brewfile to use"
    command list "List entries in the Brewfile"
      flag --all "List all entry types"
      flag --file <file> "Brewfile to read"
    command exec "Run a command in the Brewfile environment"
      arg <command> stop "Command to run"
      arg [<args>] repeat "Command arguments"
    command edit "Edit the Brewfile"
  command analytics "Control anonymous usage analytics"
    command state "Show whether analytics are enabled"
    command on "Turn analytics on"
    command off "Turn analytics off"
  command desc "Show short descriptions of formulae or casks"
    flag --search|-s "Search names and descriptions"
    flag --name|-n "Search names only"
    flag --description|-d "Search descriptions only"
    arg <brew-package> repeat "Formula, cask or search text"
  command home|homepage "Open a formula or cask homepage"
    arg [<brew-package>] repeat "Formula or cask"
  command log "Show the Git log of a formula or cask"
    flag --patch|-p "Also print patches"
    flag --stat "Also print diffstats"
    flag --oneline "One line per commit"
    flag --max-count|-n <count> "Number of commits to show"
    arg [<brew-package>] "Formula or cask"
  command edit "Open a formula or cask in the editor"
    arg [<brew-package>] repeat "Formula or cask"
  command cat "Print a formula or cask definition"
    arg <brew-package> repeat "Formula or cask"
  command doctor|dr "Check the system for potential problems"
  command config "Show Homebrew and system configuration"
  command commands "List available commands"
    flag --include-aliases "Include aliases of internal commands"
  command missing "Check installed formulae for missing dependencies"
  command shellenv "Print shell setup for Homebrew"
    arg [{bash,zsh,fish,csh,tcsh,pwsh}] "Shell to print setup for"
  command help "Show help for a command"
    arg [<command>] "Command"

#test "brew " => +install +upgrade +services +--verbose +--prefix
#test "brew ins" => +install -uninstall
#test "brew rm --" => +--zap +--force
#test "brew install --verbose --" => ---verbose +--cask +--HEAD
#test "brew install --cask --form" => ---formula
#test "brew install -s --force-" => ---force-bottle
#test "brew upgrade -d --gre" => +--greedy +--greedy-latest
#test "brew outdated --json=" => +v1 +v2
#test "brew info --inst" => ---installed
#test "brew info --json --inst" => +--installed
#test "brew deps --arch " => +arm +intel
#test "brew deps --arch=i" => +intel -arm
#test "brew services " => +start +stop +restart +list
#test "brew services stop --no-wait --" => ---max-wait +--all +--keep
#test "brew bundle " => +install +dump +--file
#test "brew bundle dump --" => +--describe +--force +--help
#test "brew up --" => +--force +--auto-update
#test "brew shellenv " => +zsh +bash
#test "brew list -1 -" => --1 +-l +-t
