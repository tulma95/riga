# Original Riga completion spec for a Terraform 1.x subset (MIT). Format reference: docs/SPECS.md.
# Workspaces, *.tfvars files and local-backend resource addresses are read from the working directory; variable values, provider sources, hostnames, lock IDs and remote IDs are not generated.
command terraform nobundle "Write, plan and apply infrastructure as code"
  flag -help|-h|--help persistent "Print usage"
  flag -version|-v|--version "Print the Terraform version"
  flag -chdir <directory> chdir "Switch to this working directory before running the command"
  command init "Prepare the working directory: backend, modules and providers"
    flag -backend [{true,false}] "Configure the backend (default true)"
    flag -backend-config <file> repeat "Backend configuration file or key=value pair"
    flag -force-copy "Answer yes to state migration prompts"
    flag -from-module <source> "Copy the given module into the empty directory first"
    flag -get [{true,false}] "Download modules (default true)"
    flag -input [{true,false}] "Ask for input when needed (default true)"
    flag -lock [{true,false}] "Hold a state lock (default true)"
    flag -lock-timeout <duration> "How long to retry a state lock, such as 30s"
    flag -no-color "Disable colored output"
    flag -json "Print machine-readable JSON output"
    flag -plugin-dir <directory> repeat "Look for providers only in this directory"
    flag -reconfigure excludes=-migrate-state "Reconfigure the backend, ignoring saved configuration"
    flag -migrate-state "Reconfigure the backend and migrate existing state"
    flag -upgrade "Upgrade modules and providers within their version constraints"
    flag -lockfile {readonly} "Dependency lock file mode"
    flag -ignore-remote-version "Continue despite a remote Terraform version mismatch"
    flag -test-directory <directory> "Directory holding test files"
  command validate "Check that the configuration is valid"
    flag -json "Print machine-readable JSON output"
    flag -no-color "Disable colored output"
    flag -no-tests "Skip validating test files"
    flag -test-directory <directory> "Directory holding test files"
  command plan "Show the changes Terraform would make"
    flag -destroy excludes=-refresh-only "Plan to destroy all managed objects"
    flag -refresh-only "Plan only to update state to match remote objects"
    flag -refresh [{true,false}] "Refresh state before planning (default true)"
    flag -replace <terraform-resource> repeat "Plan to replace this resource instance"
    flag -target <terraform-resource> repeat "Limit planning to this resource or module"
    flag -var <assignment> repeat "Set an input variable as name=value"
    flag -var-file <terraform-var-file> repeat "Load input variables from a file"
    flag -compact-warnings "Show warnings in a compact form"
    flag -detailed-exitcode "Exit 2 when there are changes"
    flag -generate-config-out <file> "Write configuration for import blocks to this file"
    flag -input [{true,false}] "Ask for input when needed (default true)"
    flag -json "Print machine-readable JSON output"
    flag -lock [{true,false}] "Hold a state lock (default true)"
    flag -lock-timeout <duration> "How long to retry a state lock, such as 30s"
    flag -no-color "Disable colored output"
    flag -out <file> "Save the plan to this file"
    flag -parallelism <count> "Limit concurrent operations (default 10)"
    flag -state <file> "Legacy local state file path"
  command apply "Create or update infrastructure"
    flag -auto-approve "Skip the interactive approval"
    flag -backup <file> "Legacy local backend backup path"
    flag -compact-warnings "Show warnings in a compact form"
    flag -destroy excludes=-refresh-only "Destroy all managed objects"
    flag -refresh-only "Only update state to match remote objects"
    flag -refresh [{true,false}] "Refresh state before planning (default true)"
    flag -replace <terraform-resource> repeat "Replace this resource instance"
    flag -target <terraform-resource> repeat "Limit the operation to this resource or module"
    flag -var <assignment> repeat "Set an input variable as name=value"
    flag -var-file <terraform-var-file> repeat "Load input variables from a file"
    flag -input [{true,false}] "Ask for input when needed (default true)"
    flag -json "Print machine-readable JSON output"
    flag -lock [{true,false}] "Hold a state lock (default true)"
    flag -lock-timeout <duration> "How long to retry a state lock, such as 30s"
    flag -no-color "Disable colored output"
    flag -parallelism <count> "Limit concurrent operations (default 10)"
    flag -state <file> "Legacy local state file path"
    flag -state-out <file> "Legacy local path to write updated state"
    arg [<file>] "Saved plan file to apply"
  command destroy "Destroy all managed infrastructure"
    flag -auto-approve "Skip the interactive approval"
    flag -compact-warnings "Show warnings in a compact form"
    flag -refresh [{true,false}] "Refresh state before planning (default true)"
    flag -target <terraform-resource> repeat "Limit destruction to this resource or module"
    flag -var <assignment> repeat "Set an input variable as name=value"
    flag -var-file <terraform-var-file> repeat "Load input variables from a file"
    flag -input [{true,false}] "Ask for input when needed (default true)"
    flag -json "Print machine-readable JSON output"
    flag -lock [{true,false}] "Hold a state lock (default true)"
    flag -lock-timeout <duration> "How long to retry a state lock, such as 30s"
    flag -no-color "Disable colored output"
    flag -parallelism <count> "Limit concurrent operations (default 10)"
  command fmt "Rewrite configuration files in the canonical style"
    flag -list [{true,false}] "List files whose formatting differs (default true)"
    flag -write [{true,false}] "Write the result to the source files (default true)"
    flag -diff "Show formatting differences"
    flag -check "Exit non-zero if any file needs formatting, without writing"
    flag -recursive "Also process subdirectories"
    flag -no-color "Disable colored output"
    arg [<file>] repeat "Files or directories to format"
  command show "Show a state or plan file in readable form"
    flag -json "Print machine-readable JSON output"
    flag -no-color "Disable colored output"
    arg [<file>] "Plan or state file to show"
  command output "Show output values from the state"
    flag -json excludes=-raw "Print machine-readable JSON output"
    flag -raw "Print a string value without quotes"
    flag -no-color "Disable colored output"
    flag -state <file> "Legacy local state file path"
    arg [<name>] "Output to show"
  command state "Inspect and change the state"
    command list "List resources in the state"
      flag -state <file> "Legacy local state file path"
      flag -id <id> "Only list resources with this ID"
      arg [<terraform-resource>] repeat "Addresses to filter by"
    command show "Show the attributes of one resource"
      flag -state <file> "Legacy local state file path"
      arg <terraform-resource> "Resource instance to show"
    command mv "Move or rename an item in the state"
      flag -dry-run "Print what would be moved without moving"
      flag -lock [{true,false}] "Hold a state lock (default true)"
      flag -lock-timeout <duration> "How long to retry a state lock, such as 30s"
      flag -ignore-remote-version "Continue despite a remote Terraform version mismatch"
      flag -state <file> "Legacy local source state file"
      flag -state-out <file> "Legacy local destination state file"
      flag -backup <file> "Legacy backup path for the source state"
      flag -backup-out <file> "Legacy backup path for the destination state"
      arg <terraform-resource> "Source address"
      arg <destination> "Destination address"
    command rm "Forget resources without destroying them"
      flag -dry-run "Print what would be removed without removing"
      flag -backup <file> "Legacy backup path"
      flag -lock [{true,false}] "Hold a state lock (default true)"
      flag -lock-timeout <duration> "How long to retry a state lock, such as 30s"
      flag -ignore-remote-version "Continue despite a remote Terraform version mismatch"
      flag -state <file> "Legacy local state file path"
      arg <terraform-resource> repeat "Addresses to remove"
    command pull "Print the current state as JSON"
    command push "Overwrite the remote state with a local file"
      flag -force "Push even if lineage or serial checks fail"
      flag -lock [{true,false}] "Hold a state lock (default true)"
      flag -lock-timeout <duration> "How long to retry a state lock, such as 30s"
      flag -ignore-remote-version "Continue despite a remote Terraform version mismatch"
      arg <file> "State file to push, or - for stdin"
    command replace-provider "Change the provider recorded for resources"
      flag -auto-approve "Skip the interactive approval"
      flag -backup <file> "Legacy backup path"
      flag -lock [{true,false}] "Hold a state lock (default true)"
      flag -lock-timeout <duration> "How long to retry a state lock, such as 30s"
      flag -ignore-remote-version "Continue despite a remote Terraform version mismatch"
      flag -state <file> "Legacy local state file path"
      arg <from-provider> "Provider address to replace"
      arg <to-provider> "New provider address"
  command workspace "Manage workspaces"
    command list "List workspaces"
    command select "Switch to a workspace"
      flag -or-create "Create the workspace if it does not exist"
      arg <terraform-workspace> "Workspace to select"
    command new "Create a workspace"
      flag -lock [{true,false}] "Hold a state lock (default true)"
      flag -lock-timeout <duration> "How long to retry a state lock, such as 30s"
      flag -state <file> "Copy this state file into the new workspace"
      arg <name> "Name of the new workspace"
    command delete "Delete a workspace"
      flag -force "Delete even if the workspace still manages resources"
      flag -lock [{true,false}] "Hold a state lock (default true)"
      flag -lock-timeout <duration> "How long to retry a state lock, such as 30s"
      arg <terraform-workspace> "Workspace to delete"
    command show "Print the current workspace name"
  command import "Associate an existing remote object with a resource"
    flag -config <directory> "Directory with the configuration"
    flag -input [{true,false}] "Ask for input when needed (default true)"
    flag -lock [{true,false}] "Hold a state lock (default true)"
    flag -lock-timeout <duration> "How long to retry a state lock, such as 30s"
    flag -no-color "Disable colored output"
    flag -var <assignment> repeat "Set an input variable as name=value"
    flag -var-file <terraform-var-file> repeat "Load input variables from a file"
    flag -ignore-remote-version "Continue despite a remote Terraform version mismatch"
    arg <address> "Resource address to import into"
    arg <id> "Provider-specific ID of the remote object"
  command providers "Show the providers the configuration requires"
    flag -test-directory <directory> "Directory holding test files"
    command lock "Write provider checksums to the dependency lock file"
      flag -platform <os_arch> repeat "Platform to record checksums for, such as linux_amd64"
      flag -fs-mirror <directory> "Read providers from this local mirror"
      flag -net-mirror <url> "Read providers from this network mirror"
      flag -enable-plugin-cache "Use the configured plugin cache"
      arg [<provider>] repeat "Providers to lock"
    command mirror "Save the required providers into a local directory"
      flag -platform <os_arch> repeat "Platform to download for, such as linux_amd64"
      flag -lock-file [{true,false}] "Use the dependency lock file (default true)"
      arg <directory> "Mirror directory"
    command schema "Print provider schemas"
      flag -json "Print machine-readable JSON output (required)"
  command graph "Print the dependency graph in DOT format"
    flag -type {plan,plan-refresh-only,plan-destroy,apply} "Graph type to output"
    flag -plan <file> "Graph this saved plan"
    flag -draw-cycles "Highlight cycles in the graph"
  command console "Evaluate expressions interactively"
    flag -state <file> "Legacy local state file path"
    flag -plan "Evaluate against a fresh plan"
    flag -var <assignment> repeat "Set an input variable as name=value"
    flag -var-file <terraform-var-file> repeat "Load input variables from a file"
  command login "Get and save an API token for a host"
    arg [<hostname>] "Host to log in to (default app.terraform.io)"
  command logout "Remove a saved API token"
    arg [<hostname>] "Host to log out of (default app.terraform.io)"
  command taint "Mark a resource instance for replacement"
    flag -allow-missing "Succeed even if the resource is missing"
    flag -lock [{true,false}] "Hold a state lock (default true)"
    flag -lock-timeout <duration> "How long to retry a state lock, such as 30s"
    flag -ignore-remote-version "Continue despite a remote Terraform version mismatch"
    arg <terraform-resource> "Resource instance to taint"
  command untaint "Remove the tainted mark from a resource instance"
    flag -allow-missing "Succeed even if the resource is missing"
    flag -lock [{true,false}] "Hold a state lock (default true)"
    flag -lock-timeout <duration> "How long to retry a state lock, such as 30s"
    flag -ignore-remote-version "Continue despite a remote Terraform version mismatch"
    arg <terraform-resource> "Resource instance to untaint"
  command force-unlock "Release a stuck state lock"
    flag -force "Do not ask for confirmation"
    arg <lock-id> "ID of the lock to release"
  command get "Download and update modules"
    flag -update "Check already-downloaded modules for updates"
    flag -no-color "Disable colored output"
    flag -test-directory <directory> "Directory holding test files"
  command refresh "Update the state to match remote objects (prefer apply -refresh-only)"
    flag -compact-warnings "Show warnings in a compact form"
    flag -target <terraform-resource> repeat "Limit refreshing to this resource or module"
    flag -var <assignment> repeat "Set an input variable as name=value"
    flag -var-file <terraform-var-file> repeat "Load input variables from a file"
    flag -input [{true,false}] "Ask for input when needed (default true)"
    flag -lock [{true,false}] "Hold a state lock (default true)"
    flag -lock-timeout <duration> "How long to retry a state lock, such as 30s"
    flag -no-color "Disable colored output"
    flag -parallelism <count> "Limit concurrent operations (default 10)"
  command test "Run the tests in .tftest.hcl files"
    flag -filter <file> repeat "Run only this test file"
    flag -json "Print machine-readable JSON output"
    flag -no-color "Disable colored output"
    flag -test-directory <directory> "Directory holding test files"
    flag -var <assignment> repeat "Set an input variable as name=value"
    flag -var-file <terraform-var-file> repeat "Load input variables from a file"
    flag -verbose "Print the plan or state of each run block"
  command version "Print the Terraform version"
    flag -json "Print machine-readable JSON output"
  command metadata "Print metadata about Terraform"
    command functions "List the available functions"
      flag -json "Print machine-readable JSON output (required)"

#test "terraform " => +init +plan +apply +state +workspace +force-unlock +-chdir +-version
#test "terraform -" => +-help +--help +-v ---json
#test "terraform -chdir=infra pl" => +plan
#test "terraform -chdir infra plan -" => +-var-file +-help ---chdir
#test "terraform plan -destroy -" => ---refresh-only +-out +-target
#test "terraform apply -refresh-only -" => ---destroy +-auto-approve
#test "terraform plan -input=f" => +false
#test "terraform plan -lock " => +-out
#test "terraform apply -auto-approve -" => ---auto-approve +-var +-h
#test "terraform plan -var a=1 -var b=2 -v" => +-var +-var-file
#test "terraform plan -out plan.bin -" => ---out +-replace
#test "terraform graph -type=pl" => +plan +plan-destroy ---apply
#test "terraform graph -type " => +plan +apply
#test "terraform init -reconfigure -" => ---migrate-state +-upgrade +-backend-config
#test "terraform init -lockfile=r" => +readonly
#test "terraform output -raw -" => ---json +-state
#test "terraform state " => +list +mv +rm +pull +push +replace-provider
#test "terraform workspace " => +select +new +delete +show +list
#test "terraform workspace select -" => +-or-create +--help
#test "terraform providers " => +lock +mirror +schema
#test "terraform metadata " => +functions
#test "terraform fmt -check -recursive -" => +-diff ---check
#test "terraform plan --" => +--help ---var
