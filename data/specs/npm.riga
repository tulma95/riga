# Original Riga completion spec for an npm subset (MIT). Format reference: docs/SPECS.md.
# <npm-script>, <npm-dependency>, <npm-bin> and <npm-workspace> are read from local files (never by running npm);
# registry package names, versions, config keys and dist-tags are not generated.
command npm "Node.js package manager"
  flag --version|-v "Print the npm version"
  flag --help|-h persistent "Show usage for npm or a command"
  flag --prefix|-C <directory> persistent chdir "Operate on the project in this directory"
  flag --registry <url> persistent "Registry base URL"
  flag --userconfig <file> persistent "User configuration file"
  flag --loglevel {silent,error,warn,notice,http,info,verbose,silly} persistent excludes=--silent,--quiet "Set the log level"
  flag --silent|-s persistent excludes=--quiet "Print no log output"
  flag --quiet|-q persistent "Print only warnings and errors"
  flag --global|-g persistent "Operate on globally installed packages"
  flag --workspace|-w <workspace> repeat persistent "Run in the named workspace"
  flag --workspaces|-ws persistent "Run in all configured workspaces"
  flag --include-workspace-root|-iwr persistent "Include the root project with workspaces"
  flag --yes|-y persistent "Answer yes to prompts"
  flag --force|-f persistent "Skip safety checks and force the operation"
  command install|i|add|in "Install a package or the project's dependencies"
    flag --save|-S excludes=--no-save "Save to dependencies"
    flag --no-save excludes=--save-dev,--save-prod,--save-optional,--save-peer,--save-exact "Do not update package.json"
    flag --save-dev|-D excludes=--save-prod,--save-optional,--save-peer "Save to devDependencies"
    flag --save-prod|-P excludes=--save-optional,--save-peer "Save to dependencies"
    flag --save-optional|-O excludes=--save-peer "Save to optionalDependencies"
    flag --save-peer "Save to peerDependencies"
    flag --save-bundle|-B "Also add to bundleDependencies"
    flag --save-exact|-E "Save an exact version instead of a range"
    flag --omit {dev,optional,peer} repeat "Skip a dependency type on disk"
    flag --include {prod,dev,optional,peer} repeat "Install a dependency type even if omitted"
    flag --install-strategy {hoisted,nested,shallow,linked} "Layout of node_modules"
    flag --legacy-peer-deps "Ignore peer dependency conflicts"
    flag --strict-peer-deps "Fail on conflicting peer dependencies"
    flag --prefer-offline "Use cached data before the network"
    flag --prefer-online "Revalidate cached data with the registry"
    flag --offline "Use only the local cache"
    flag --package-lock-only "Only update package-lock.json"
    flag --no-package-lock "Ignore and do not write package-lock.json"
    flag --ignore-scripts "Do not run lifecycle scripts"
    flag --foreground-scripts "Show lifecycle script output"
    flag --no-audit "Skip the security audit"
    flag --no-fund "Hide the funding message"
    flag --no-bin-links "Do not link package executables"
    flag --install-links "Install file: dependencies as packages, not links"
    flag --dry-run "Show what would change without doing it"
    flag --before <date> "Install versions published before this date"
    flag --tag <tag> "Dist-tag to install by default"
    arg [<package-spec>] repeat "Packages, tarballs, folders or git URLs"
  command ci|clean-install|ic|install-clean "Clean install from package-lock.json"
    flag --omit {dev,optional,peer} repeat "Skip a dependency type on disk"
    flag --include {prod,dev,optional,peer} repeat "Install a dependency type even if omitted"
    flag --install-strategy {hoisted,nested,shallow,linked} "Layout of node_modules"
    flag --legacy-peer-deps "Ignore peer dependency conflicts"
    flag --strict-peer-deps "Fail on conflicting peer dependencies"
    flag --prefer-offline "Use cached data before the network"
    flag --ignore-scripts "Do not run lifecycle scripts"
    flag --foreground-scripts "Show lifecycle script output"
    flag --no-audit "Skip the security audit"
    flag --no-fund "Hide the funding message"
    flag --no-bin-links "Do not link package executables"
    flag --dry-run "Show what would change without doing it"
  command install-test|it "Install dependencies, then run tests"
    flag --ignore-scripts "Do not run lifecycle scripts"
    arg [<package-spec>] repeat "Packages to install"
  command install-ci-test|cit "Clean install, then run tests"
    flag --ignore-scripts "Do not run lifecycle scripts"
  command uninstall|remove|rm|r|un|unlink "Remove a package"
    flag --save|-S "Remove from package.json"
    flag --no-save "Do not update package.json"
    flag --dry-run "Show what would change without doing it"
    arg <npm-dependency> repeat "Packages to remove"
  command update|up|upgrade|u "Update packages to the newest allowed version"
    flag --save|-S excludes=--no-save "Save updated ranges to package.json"
    flag --no-save "Do not update package.json"
    flag --omit {dev,optional,peer} repeat "Skip a dependency type on disk"
    flag --include {prod,dev,optional,peer} repeat "Update a dependency type even if omitted"
    flag --legacy-peer-deps "Ignore peer dependency conflicts"
    flag --ignore-scripts "Do not run lifecycle scripts"
    flag --no-audit "Skip the security audit"
    flag --no-fund "Hide the funding message"
    flag --dry-run "Show what would change without doing it"
    arg [<npm-dependency>] repeat "Packages to update"
  command outdated "List outdated packages"
    flag --all|-a "Include nested dependencies"
    flag --json "Print JSON output"
    flag --long|-l "Show extended information"
    flag --parseable|-p "Print tab-separated output"
    arg [<npm-dependency>] repeat "Packages to check"
  command ls|list "List installed packages"
    flag --all|-a "Show the whole dependency tree"
    flag --depth <depth> "Maximum tree depth"
    flag --json "Print JSON output"
    flag --long|-l "Show extended information"
    flag --parseable|-p "Print paths instead of a tree"
    flag --omit {dev,optional,peer} repeat "Hide a dependency type"
    flag --include {prod,dev,optional,peer} repeat "Show a dependency type even if omitted"
    flag --link "Show only linked dependencies"
    flag --package-lock-only "Read package-lock.json instead of node_modules"
    arg [<npm-dependency>] repeat "Packages to show"
  command explain|why "Explain why a package is installed"
    flag --json "Print JSON output"
    arg <npm-dependency> repeat "Packages or folders to explain"
  command run|run-script "Run a package.json script"
    flag --if-present "Do not fail when the script is missing"
    flag --ignore-scripts "Do not run pre and post scripts"
    flag --foreground-scripts "Show script output in the foreground"
    flag --script-shell <file> "Shell used to run scripts"
    arg [<npm-script>] "Script to run (lists scripts when omitted)"
    arg [<args>] repeat "Arguments for the script (usually after --)"
  command test|t|tst "Run the test script"
    flag --ignore-scripts "Do not run pre and post scripts"
    flag --script-shell <file> "Shell used to run scripts"
    arg [<args>] repeat "Arguments for the test script"
  command start "Run the start script"
    flag --ignore-scripts "Do not run pre and post scripts"
    flag --script-shell <file> "Shell used to run scripts"
    arg [<args>] repeat "Arguments for the start script"
  command stop "Run the stop script"
    flag --ignore-scripts "Do not run pre and post scripts"
    arg [<args>] repeat "Arguments for the stop script"
  command restart "Run the restart script, or stop and start"
    flag --ignore-scripts "Do not run pre and post scripts"
    arg [<args>] repeat "Arguments for the scripts"
  command exec|x "Run a command from a local or remote package"
    flag --package <package-spec> repeat "Package to install before running"
    flag --call|-c <command> "Shell command to run"
    arg <command> stop "Package binary to run"
    arg [<args>] repeat "Arguments for the command"
  command init|create "Create a package.json or run a create- package"
    flag --init-author-name <name> "Default author name"
    flag --init-author-url <url> "Default author URL"
    flag --init-license <license> "Default license"
    flag --init-version <version> "Default version"
    flag --init-module <file> "Module that drives the init questions"
    flag --init-type {commonjs,module} "Default package type"
    flag --init-private "Mark the new package private"
    flag --scope <@scope> "Scope for the new package"
    flag --no-workspaces-update "Do not update workspace links"
    arg [<package-spec>] stop "Initializer package (create-<name>)"
    arg [<args>] repeat "Arguments for the initializer"
  command publish "Publish a package to the registry"
    flag --tag <tag> "Dist-tag to publish under"
    flag --access {public,restricted} "Access level for scoped packages"
    flag --dry-run "Show what would be published"
    flag --otp <code> "One-time password for two-factor auth"
    flag --provenance excludes=--provenance-file "Generate a provenance statement"
    flag --provenance-file <file> "Attach an existing provenance bundle"
    flag --ignore-scripts "Do not run lifecycle scripts"
    arg [<package-spec>] "Folder or tarball to publish"
  command unpublish "Remove a package version from the registry"
    flag --dry-run "Show what would be removed"
    flag --otp <code> "One-time password for two-factor auth"
    arg <package-spec> "Package and version to remove"
  command pack "Create a tarball from a package"
    flag --dry-run "List files without writing the tarball"
    flag --json "Print JSON output"
    flag --pack-destination <directory> "Directory for the tarball"
    flag --ignore-scripts "Do not run lifecycle scripts"
    arg [<package-spec>] repeat "Packages to pack"
  command audit "Report known vulnerabilities"
    flag --audit-level {info,low,moderate,high,critical,none} persistent "Minimum severity that fails"
    flag --omit {dev,optional,peer} repeat persistent "Skip a dependency type"
    flag --include {prod,dev,optional,peer} repeat persistent "Audit a dependency type even if omitted"
    flag --json persistent "Print JSON output"
    flag --package-lock-only persistent "Audit package-lock.json only"
    flag --dry-run persistent "Show what would change without doing it"
    command fix "Install compatible fixes for vulnerabilities"
    command signatures "Verify registry signatures of installed packages"
  command cache "Manage the package cache"
    flag --cache <directory> persistent "Cache directory"
    command add "Add packages to the cache"
      arg <package-spec> repeat "Packages to add"
    command clean|clear|rm "Delete cache data"
      arg [<key>] repeat "Cache keys to delete"
    command ls "List cache entries"
      arg [<name@version>] repeat "Entries to list"
    command verify|check "Verify and garbage-collect the cache"
    command npx "Manage the npx cache"
      command ls "List npx cache entries"
      command rm "Remove npx cache entries"
        arg [<key>] repeat "Entries to remove"
      command info "Show npx cache entries"
        arg <key> repeat "Entries to show"
  command config|c "Manage npm configuration"
    flag --json persistent "Print JSON output"
    flag --location|-L {global,user,project} persistent "Configuration file to use"
    flag --long|-l persistent "Also show default values"
    flag --editor <file> persistent "Editor for config edit"
    command set "Set configuration values"
      arg <key=value> repeat "Values to set"
    command get "Print configuration values"
      arg [<key>] repeat "Keys to print"
    command delete|rm|del "Delete configuration keys"
      arg <key> repeat "Keys to delete"
    command list|ls "List configuration"
    command edit "Open the configuration file in an editor"
    command fix "Repair invalid configuration"
  command get "Print configuration values"
    arg [<key>] repeat "Keys to print"
  command set "Set configuration values"
    arg <key=value> repeat "Values to set"
  command pkg "Manage package.json fields"
    command get "Print package.json fields"
      arg [<field>] repeat "Fields to print"
    command set "Set package.json fields"
      arg <field=value> repeat "Fields to set"
    command delete "Delete package.json fields"
      arg <field> repeat "Fields to delete"
    command fix "Normalize package.json"
  command link|ln "Symlink a package folder"
    flag --save|-S "Save the link to package.json"
    flag --no-save "Do not update package.json"
    flag --dry-run "Show what would change without doing it"
    arg [<package-spec>] repeat "Package folder or name to link"
  command version "Bump the package version"
    flag --allow-same-version "Allow setting the current version"
    flag --no-git-tag-version "Do not commit or tag in git"
    flag --no-commit-hooks "Skip git commit hooks"
    flag --sign-git-tag "Sign the version tag"
    flag --preid <prerelease-id> "Prerelease identifier such as beta"
    flag --json "Print JSON output"
    arg [{major,minor,patch,premajor,preminor,prepatch,prerelease,from-git}] "Release type (or an exact version)"
  command view|info|show|v "Show registry information about a package"
    flag --json "Print JSON output"
    arg [<package-spec>] "Package to show"
    arg [<field>] repeat "Fields to print"
  command search|find|s "Search the registry"
    flag --json "Print JSON output"
    flag --long|-l "Show full descriptions"
    flag --searchlimit <number> "Maximum number of results"
    arg <term> repeat "Search terms"
  command login "Log in to a registry"
    flag --auth-type {web,legacy} "Authentication flow"
    flag --scope <@scope> "Associate the login with a scope"
  command adduser "Create a registry account"
    flag --auth-type {web,legacy} "Authentication flow"
    flag --scope <@scope> "Associate the account with a scope"
  command logout "Log out of a registry"
    flag --scope <@scope> "Scope to log out of"
  command whoami "Print the logged-in user name"
  command dist-tag "Manage distribution tags"
    command add "Tag a package version"
      arg <package@version> "Package version to tag"
      arg [<tag>] "Tag name"
    command rm "Remove a tag"
      arg <package> "Package"
      arg <tag> "Tag to remove"
    command ls "List a package's tags"
      arg [<package>] "Package"
  command deprecate "Deprecate a package version"
    flag --otp <code> "One-time password for two-factor auth"
    arg <package-spec> "Package versions to deprecate"
    arg <message> "Deprecation message"
  command dedupe|ddp "Reduce duplication in the dependency tree"
    flag --dry-run "Show what would change without doing it"
  command prune "Remove extraneous packages"
    flag --omit {dev,optional,peer} repeat "Also remove a dependency type"
    flag --dry-run "Show what would change without doing it"
    arg [<npm-dependency>] repeat "Packages to prune"
  command rebuild|rb "Rebuild native packages"
    flag --ignore-scripts "Do not run lifecycle scripts"
    arg [<npm-dependency>] repeat "Packages to rebuild"
  command fund "Show funding information"
    flag --json "Print JSON output"
    arg [<npm-dependency>] "Package to show"
  command docs|home "Open a package's documentation"
    arg [<package-spec>] repeat "Packages"
  command repo "Open a package's repository"
    arg [<package-spec>] repeat "Packages"
  command bugs|issues "Open a package's issue tracker"
    arg [<package-spec>] "Package"
  command explore "Open a shell in an installed package"
    arg <npm-dependency> stop "Installed package"
    arg [<command>] repeat "Command to run there"
  command doctor "Check the npm environment"
  command ping "Check registry connectivity"
  command root "Print the node_modules folder"
  command prefix "Print the project prefix"
  command bin "Print the folder for package executables"
  command shrinkwrap "Write npm-shrinkwrap.json from the lockfile"
  command query "Query installed packages with a selector"
    arg <selector> "Dependency selector"
  command sbom "Generate a software bill of materials"
    flag --sbom-format {cyclonedx,spdx} "SBOM format"
    flag --package-lock-only "Read package-lock.json only"
  command diff "Compare package versions"
    flag --diff <package-spec> repeat "Version or path to compare"
    flag --diff-name-only "Print only changed file names"
    arg [<path>] repeat "Paths to limit the diff to"
  command owner|author "Manage package owners"
    command add "Add an owner"
      arg <user> "User"
      arg [<package>] "Package"
    command rm "Remove an owner"
      arg <user> "User"
      arg [<package>] "Package"
    command ls "List owners"
      arg [<package>] "Package"
  command help "Show help for a topic"
    arg <term> "Command or topic"
  command completion "Print shell completion script for npm"

#test "npm " => +install +ci +exec +--prefix +-g ---save-dev
#test "npm r" => +run +run-script +rm +restart -install
#test "npm i" => +install +i +init +it
#test "npm i -" => +-D +--save-exact +-g +-w ---version
#test "npm install --save-dev --save-p" => ---save-prod ---save-peer
#test "npm install -D -" => --D --P +-E
#test "npm install --no-save --save-" => ---save-dev ---save-exact +--save-bundle
#test "npm install --omit " => +dev +optional +peer -prod
#test "npm install --omit=op" => +optional
#test "npm install --omit dev --o" => +--omit +--offline
#test "npm --loglevel " => +silly +warn -install
#test "npm --loglevel=v" => +verbose
#test "npm -s -" => ---quiet ---loglevel
#test "npm -C dir run --" => +--if-present +--registry ---prefix ---version
#test "npm run build --" => +--if-present
#test "npm run-script --if" => +--if-present
#test "npm rm --" => +--save -install
#test "npm version " => +patch +major +from-git -publish
#test "npm version --preid beta " => +prerelease
#test "npm publish --provenance --prov" => ---provenance-file
#test "npm publish --access=" => +public +restricted
#test "npm audit " => +fix +signatures +--audit-level
#test "npm audit fix --audit-level " => +critical +moderate
#test "npm audit fix -" => +--dry-run +-f
#test "npm config " => +set +get +list +ls +delete +--location
#test "npm c set --location " => +global +project
#test "npm cache " => +clean +verify +npx +--cache
#test "npm cache npx " => +ls +rm +info
#test "npm x -- " => -install
#test "npm exec eslint --" => ---package
#test "npm -ws -" => ---workspaces +-w
