    flag --no-default-groups "Leave out the default dependency groups"
    flag --only-group <py-group> repeat "Only include this dependency group"
    flag --all-groups "Include every dependency group"
  command audit "Check dependencies for known vulnerabilities"
    flag --output-format {text,json,sarif} "Output format"
    flag --ignore <id> repeat "Ignore a vulnerability ID"
    flag --ignore-until-fixed <id> repeat "Ignore a vulnerability until a fix exists"
    flag --service-format {osv} "Vulnerability service format"
    flag --service-url <url> "Vulnerability service URL"
    flag --script <file> "Audit a PEP 723 script"
