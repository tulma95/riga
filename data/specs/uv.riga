#test "uv " => +run +add +sync +pip +tool +python +--directory +-V ---frozen
#test "uv r" => +run +remove -add
#test "uv --color " => +auto +always +never -run
#test "uv --color=n" => +never
#test "uv --directory /tmp sync --" => +--frozen +--offline +--color ---directory ---version
#test "uv add --" => +--dev +--group +--requirements +--upgrade +--python +--quiet ---no-dev
#test "uv add --dev --" => ---optional ---group +--editable
#test "uv sync --locked --" => ---frozen ---locked +--no-dev
#test "uv sync --no-dev --only" => ---only-dev +--only-group
#test "uv sync --link-mode " => +clone +copy +hardlink +symlink
#test "uv lock --resolution=lowest" => +lowest +lowest-direct -highest
#test "uv export --format " => +requirements.txt +pylock.toml +cyclonedx1.5
#test "uv init --build-backend=h" => +hatch -uv
#test "uv init --app --" => ---lib ---script +--name
#test "uv venv --fo" => ---force
#test "uv venv --clear --fo" => +--force
#test "uv venv -c --allow" => ---allow-existing
#test "uv version --bump " => +patch +minor +rc
#test "uv run pytest -" => ---with ---frozen
#test "uv run --with rich --w" => +--with +--with-editable
#test "uv tool " => +run +install +upgrade +list +uninstall +dir
#test "uv tool run ruff --" => ---from
#test "uv tool install --" => +--with +--force +--python
#test "uv python " => +install +list +pin +find
#test "uv python list --only-installed --only" => ---only-downloads
#test "uv pip " => +install +compile +sync +freeze +--python +--system
#test "uv pip install --python 3.12 --" => ---python +--requirements +--system
#test "uv pip install -t dir --" => ---prefix ---target
#test "uv pip compile --format " => +requirements.txt +pylock.toml
#test "uv pip list --format=j" => +json
#test "uv publish --token x --" => ---username ---password +--dry-run
#test "uv cache " => +clean +prune +dir +size
#test "uv -q --" => +--quiet +--verbose +--version
#test "uv --managed-python --" => ---no-managed-python
