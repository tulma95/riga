  command format "Format Python code with Ruff"
    flag --check "Fail if files are not formatted"
    flag --diff "Show a diff instead of writing changes"
    flag --version <version> "Ruff version to use"
    flag --exclude-newer <date> "Ignore Ruff releases after this date"
    flag --no-project "Do not discover a project or workspace"
    arg [<ruff-args>] repeat "Arguments for Ruff (after --)"
  command check "Type-check the project with ty"
    flag --fix "Apply safe fixes"
    flag --all-packages excludes=--package "Check every workspace member"
    flag --package <py-dependency> repeat "Check a workspace member"
    flag --script <file> "Check a PEP 723 script"
    flag --no-sync "Do not sync the environment first"
    flag --no-install-project "Do not install the current project"
    flag --isolated "Do not change project state"
    flag --ty-version <version> "ty version to use"
    flag --no-project "Do not discover a project or workspace"
