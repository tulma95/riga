# Original Riga completion spec for a uv subset (MIT). Format reference: docs/SPECS.md.
# Package names in uv add, uv pip and uv tool install, Python versions, indexes and workspace members are free text.
# Dependency, extra, group and script names come from the nearest pyproject.toml; tool names from ~/.local/share/uv/tools.
# uvx (an alias for uv tool run) is a separate executable without a spec.
command uv "Python package and project manager"
  flag --help|-h persistent "Show usage for uv or a command"
  flag --version|-V "Print the uv version"
  flag --quiet|-q repeat persistent "Print less output"
  flag --verbose|-v repeat persistent "Print more output"
  flag --color {auto,always,never} persistent "When to use colored output"
  flag --offline persistent "Disable network access"
  flag --no-progress persistent "Hide progress output"
  flag --no-cache|-n persistent "Use a temporary cache for this run"
  flag --cache-dir <directory> persistent "Cache directory"
  flag --directory <directory> persistent chdir "Change to this directory before running"
  flag --project <directory> persistent "Find the project in this directory"
  flag --config-file <file> persistent "Path to a uv.toml configuration file"
  flag --no-config persistent "Ignore pyproject.toml and uv.toml configuration"
  flag --allow-insecure-host <host> repeat persistent "Allow insecure connections to a host"
  flag --system-certs persistent "Load TLS certificates from the system store"
  flag --managed-python persistent excludes=--no-managed-python "Only use Python versions managed by uv"
  flag --no-managed-python persistent "Never use Python versions managed by uv"
  flag --no-python-downloads persistent "Never download Python automatically"
  command run "Run a command or script in the project environment"
    flag --module|-m "Run a Python module"
    flag --script|-s excludes=--gui-script "Treat the target as a PEP 723 script"
    flag --gui-script "Run the target as a GUI script with pythonw"
    flag --with|-w <requirement> repeat "Add a package to the run environment"
    flag --with-editable <path> repeat "Add an editable package to the run environment"
    flag --with-requirements <file> repeat "Add packages from a requirements file"
    flag --isolated "Run in a fresh isolated environment"
    flag --active "Prefer the active virtual environment"
    flag --no-sync "Do not sync the environment first"
    flag --exact "Remove packages not in the lockfile"
    flag --env-file <file> repeat "Load environment variables from a .env file"
    flag --no-env-file "Ignore env files"
    flag --no-project "Do not discover a project or workspace"
    flag --package <py-dependency> "Run in a workspace member"
    flag --all-packages "Sync every workspace member"
    flag --no-editable "Install workspace members as non-editable"
    flag --python-platform <platform> "Target platform for the environment"
    flag --python|-p <python> "Python interpreter or version request"
    flag --locked excludes=--frozen "Fail if uv.lock would change"
    flag --frozen "Use uv.lock as is, without checking it"
    flag --extra <py-extra> repeat "Include an optional dependency extra"
    flag --all-extras "Include every optional dependency extra"
    flag --no-extra <py-extra> repeat "Leave out an extra when using --all-extras"
    flag --no-dev excludes=--only-dev "Leave out the dev dependency group"
    flag --only-dev "Only include the dev dependency group"
    flag --group <py-group> repeat "Include a dependency group"
    flag --no-group <py-group> repeat "Leave out a dependency group"
    flag --no-default-groups "Leave out the default dependency groups"
    flag --only-group <py-group> repeat "Only include this dependency group"
    flag --all-groups "Include every dependency group"
    flag --index <index> repeat "Extra package index, by name or URL"
    flag --default-index <url> "Replace the default package index"
    flag --index-url|-i <url> "Primary index URL (older form of --default-index)"
    flag --extra-index-url <url> repeat "Additional index URL (older form of --index)"
    flag --find-links|-f <path-or-url> repeat "Directory or flat HTML page with distributions"
    flag --no-index "Ignore package registries"
    flag --index-strategy {first-index,unsafe-first-match,unsafe-best-match} "How to pick versions across several indexes"
    flag --keyring-provider {disabled,subprocess} "Use keyring for index credentials"
    flag --upgrade|-U "Allow upgrading every package"
    flag --upgrade-package|-P <py-dependency> repeat "Allow upgrading one package"
    flag --resolution {highest,lowest,lowest-direct} "Version selection strategy"
    flag --prerelease {disallow,allow,if-necessary,explicit,if-necessary-or-explicit} "When to accept pre-release versions"
    flag --fork-strategy {fewest,requires-python} "How to split resolution across Python versions"
    flag --exclude-newer <date> "Ignore distributions uploaded after this date"
    flag --no-sources "Ignore tool.uv.sources while resolving"
    flag --config-setting|-C <key=value> repeat "Setting for the PEP 517 build backend"
    flag --no-build-isolation "Build without isolated build environments"
    flag --no-build "Never build from source distributions"
    flag --no-binary "Never use prebuilt wheels"
    flag --refresh "Revalidate all cached data"
    flag --refresh-package <py-dependency> repeat "Revalidate cached data for one package"
    flag --reinstall "Reinstall every package"
    flag --reinstall-package <py-dependency> repeat "Reinstall one package"
    flag --link-mode {clone,copy,hardlink,symlink} "How packages are installed from the cache"
    flag --compile-bytecode "Compile installed Python files to bytecode"
    arg <py-script> stop "Command, script path or module to run"
    arg [<args>] repeat "Arguments for the command"
  command init "Create a new project"
    flag --name <name> "Project name"
    flag --bare "Only create pyproject.toml"
    flag --package excludes=--no-package "Set the project up as a buildable package"
    flag --no-package "Do not make the project buildable"
    flag --app excludes=--lib,--script "Create an application project"
    flag --lib excludes=--script "Create a library project"
    flag --script "Create a PEP 723 script"
    flag --description <text> "Project description"
    flag --no-description "Leave out the description"
    flag --vcs {git,none} "Version control to initialize"
    flag --build-backend {uv,hatch,flit,pdm,poetry,setuptools,maturin,scikit} "Build backend to configure"
    flag --no-readme "Do not create README.md"
    flag --author-from {auto,git,none} "Where to read the authors field from"
    flag --no-pin-python "Do not create .python-version"
    flag --no-workspace "Do not join a parent workspace"
    flag --python|-p <python> "Python interpreter or version request"
    arg [<directory>] "Project directory (default: current directory)"
  command add "Add dependencies to the project"
    flag --requirements|-r <file> repeat "Add packages from a requirements file"
    flag --constraints|-c <file> repeat "Constrain versions with a file"
    flag --marker|-m <marker> "Environment marker for the added dependencies"
    flag --dev excludes=--optional,--group "Add to the dev dependency group"
    flag --optional <py-extra> excludes=--group "Add to an optional dependency extra"
    flag --group <py-group> "Add to a dependency group"
    flag --editable "Add as an editable dependency"
    flag --raw "Add the requirement exactly as given"
    flag --bounds {lower,major,minor,exact} "Kind of version bound to write"
    flag --rev <commit> "Git commit to use"
    flag --tag <tag> "Git tag to use"
    flag --branch <branch> "Git branch to use"
    flag --lfs "Fetch Git LFS objects"
    flag --extra <extra> repeat "Extras to enable on the dependency"
    flag --no-sync "Do not sync the environment afterwards"
    flag --active "Prefer the active virtual environment"
    flag --package <py-dependency> "Add to a workspace member"
    flag --script <file> "Add to a PEP 723 script instead of the project"
    flag --workspace excludes=--no-workspace "Add local paths as workspace members"
    flag --no-workspace "Do not add local paths as workspace members"
    flag --no-install-project "Do not install the current project"
    flag --python|-p <python> "Python interpreter or version request"
    flag --locked excludes=--frozen "Fail if uv.lock would change"
    flag --frozen "Use uv.lock as is, without checking it"
    flag --index <index> repeat "Extra package index, by name or URL"
    flag --default-index <url> "Replace the default package index"
    flag --index-url|-i <url> "Primary index URL (older form of --default-index)"
    flag --extra-index-url <url> repeat "Additional index URL (older form of --index)"
    flag --find-links|-f <path-or-url> repeat "Directory or flat HTML page with distributions"
    flag --no-index "Ignore package registries"
    flag --index-strategy {first-index,unsafe-first-match,unsafe-best-match} "How to pick versions across several indexes"
    flag --keyring-provider {disabled,subprocess} "Use keyring for index credentials"
    flag --upgrade|-U "Allow upgrading every package"
    flag --upgrade-package|-P <py-dependency> repeat "Allow upgrading one package"
    flag --resolution {highest,lowest,lowest-direct} "Version selection strategy"
    flag --prerelease {disallow,allow,if-necessary,explicit,if-necessary-or-explicit} "When to accept pre-release versions"
    flag --fork-strategy {fewest,requires-python} "How to split resolution across Python versions"
    flag --exclude-newer <date> "Ignore distributions uploaded after this date"
    flag --no-sources "Ignore tool.uv.sources while resolving"
    flag --config-setting|-C <key=value> repeat "Setting for the PEP 517 build backend"
    flag --no-build-isolation "Build without isolated build environments"
    flag --no-build "Never build from source distributions"
    flag --no-binary "Never use prebuilt wheels"
    flag --refresh "Revalidate all cached data"
    flag --refresh-package <py-dependency> repeat "Revalidate cached data for one package"
    flag --reinstall "Reinstall every package"
    flag --reinstall-package <py-dependency> repeat "Reinstall one package"
    flag --link-mode {clone,copy,hardlink,symlink} "How packages are installed from the cache"
    flag --compile-bytecode "Compile installed Python files to bytecode"
    arg <package> repeat "Packages to add (requirement specifiers, paths or URLs)"
  command remove "Remove dependencies from the project"
    flag --dev excludes=--optional,--group "Remove from the dev dependency group"
    flag --optional <py-extra> excludes=--group "Remove from an optional dependency extra"
    flag --group <py-group> "Remove from a dependency group"
    flag --no-sync "Do not sync the environment afterwards"
    flag --active "Prefer the active virtual environment"
    flag --package <py-dependency> "Remove from a workspace member"
    flag --script <file> "Remove from a PEP 723 script instead of the project"
    flag --python|-p <python> "Python interpreter or version request"
    flag --locked excludes=--frozen "Fail if uv.lock would change"
    flag --frozen "Use uv.lock as is, without checking it"
    flag --index <index> repeat "Extra package index, by name or URL"
    flag --default-index <url> "Replace the default package index"
    flag --index-url|-i <url> "Primary index URL (older form of --default-index)"
    flag --extra-index-url <url> repeat "Additional index URL (older form of --index)"
    flag --find-links|-f <path-or-url> repeat "Directory or flat HTML page with distributions"
    flag --no-index "Ignore package registries"
    flag --index-strategy {first-index,unsafe-first-match,unsafe-best-match} "How to pick versions across several indexes"
    flag --keyring-provider {disabled,subprocess} "Use keyring for index credentials"
    flag --upgrade|-U "Allow upgrading every package"
    flag --upgrade-package|-P <py-dependency> repeat "Allow upgrading one package"
    flag --resolution {highest,lowest,lowest-direct} "Version selection strategy"
    flag --prerelease {disallow,allow,if-necessary,explicit,if-necessary-or-explicit} "When to accept pre-release versions"
    flag --fork-strategy {fewest,requires-python} "How to split resolution across Python versions"
    flag --exclude-newer <date> "Ignore distributions uploaded after this date"
    flag --no-sources "Ignore tool.uv.sources while resolving"
    flag --config-setting|-C <key=value> repeat "Setting for the PEP 517 build backend"
    flag --no-build-isolation "Build without isolated build environments"
    flag --no-build "Never build from source distributions"
    flag --no-binary "Never use prebuilt wheels"
    flag --refresh "Revalidate all cached data"
    flag --refresh-package <py-dependency> repeat "Revalidate cached data for one package"
    flag --reinstall "Reinstall every package"
    flag --reinstall-package <py-dependency> repeat "Reinstall one package"
    flag --link-mode {clone,copy,hardlink,symlink} "How packages are installed from the cache"
    flag --compile-bytecode "Compile installed Python files to bytecode"
    arg <py-dependency> repeat "Packages to remove"
  command version "Read or update the project version"
    flag --bump {major,minor,patch,stable,alpha,beta,rc,post,dev} repeat "Bump a version component"
    flag --dry-run "Show the new version without writing it"
    flag --short "Print only the version"
    flag --output-format {text,json} "Output format"
    flag --no-sync "Do not sync the environment afterwards"
    flag --active "Prefer the active virtual environment"
    flag --package <py-dependency> "Use a workspace member"
    flag --python|-p <python> "Python interpreter or version request"
    flag --locked excludes=--frozen "Fail if uv.lock would change"
    flag --frozen "Use uv.lock as is, without checking it"
    arg [<version>] "Set the version to this value"
  command sync "Update the project environment"
    flag --inexact "Keep packages that are not in the lockfile"
    flag --active "Sync the active virtual environment"
    flag --dry-run "Show changes without making them"
    flag --check "Fail if the environment is out of date"
    flag --no-install-project "Do not install the current project"
    flag --no-install-workspace "Do not install workspace members"
    flag --no-install-local "Do not install local path dependencies"
    flag --no-install-package <py-dependency> repeat "Do not install this package"
    flag --no-editable "Install workspace members as non-editable"
    flag --all-packages excludes=--package "Sync every workspace member"
    flag --package <py-dependency> "Sync one workspace member"
    flag --script <file> "Sync a PEP 723 script environment"
    flag --output-format {text,json} "Output format"
    flag --python-platform <platform> "Target platform for the environment"
    flag --python|-p <python> "Python interpreter or version request"
    flag --locked excludes=--frozen "Fail if uv.lock would change"
    flag --frozen "Use uv.lock as is, without checking it"
    flag --extra <py-extra> repeat "Include an optional dependency extra"
    flag --all-extras "Include every optional dependency extra"
    flag --no-extra <py-extra> repeat "Leave out an extra when using --all-extras"
    flag --no-dev excludes=--only-dev "Leave out the dev dependency group"
    flag --only-dev "Only include the dev dependency group"
    flag --group <py-group> repeat "Include a dependency group"
    flag --no-group <py-group> repeat "Leave out a dependency group"
    flag --no-default-groups "Leave out the default dependency groups"
    flag --only-group <py-group> repeat "Only include this dependency group"
    flag --all-groups "Include every dependency group"
    flag --index <index> repeat "Extra package index, by name or URL"
    flag --default-index <url> "Replace the default package index"
    flag --index-url|-i <url> "Primary index URL (older form of --default-index)"
    flag --extra-index-url <url> repeat "Additional index URL (older form of --index)"
    flag --find-links|-f <path-or-url> repeat "Directory or flat HTML page with distributions"
    flag --no-index "Ignore package registries"
    flag --index-strategy {first-index,unsafe-first-match,unsafe-best-match} "How to pick versions across several indexes"
    flag --keyring-provider {disabled,subprocess} "Use keyring for index credentials"
    flag --upgrade|-U "Allow upgrading every package"
    flag --upgrade-package|-P <py-dependency> repeat "Allow upgrading one package"
    flag --resolution {highest,lowest,lowest-direct} "Version selection strategy"
    flag --prerelease {disallow,allow,if-necessary,explicit,if-necessary-or-explicit} "When to accept pre-release versions"
    flag --fork-strategy {fewest,requires-python} "How to split resolution across Python versions"
    flag --exclude-newer <date> "Ignore distributions uploaded after this date"
    flag --no-sources "Ignore tool.uv.sources while resolving"
    flag --config-setting|-C <key=value> repeat "Setting for the PEP 517 build backend"
    flag --no-build-isolation "Build without isolated build environments"
    flag --no-build "Never build from source distributions"
    flag --no-binary "Never use prebuilt wheels"
    flag --refresh "Revalidate all cached data"
    flag --refresh-package <py-dependency> repeat "Revalidate cached data for one package"
    flag --reinstall "Reinstall every package"
    flag --reinstall-package <py-dependency> repeat "Reinstall one package"
    flag --link-mode {clone,copy,hardlink,symlink} "How packages are installed from the cache"
    flag --compile-bytecode "Compile installed Python files to bytecode"
  command lock "Update the project lockfile"
    flag --check "Fail if uv.lock is out of date"
    flag --check-exists "Fail if uv.lock does not exist"
    flag --dry-run "Resolve without writing uv.lock"
    flag --script <file> "Lock a PEP 723 script"
    flag --link-mode {clone,copy,hardlink,symlink} "How packages are installed from the cache"
    flag --python|-p <python> "Python interpreter or version request"
    flag --index <index> repeat "Extra package index, by name or URL"
    flag --default-index <url> "Replace the default package index"
    flag --index-url|-i <url> "Primary index URL (older form of --default-index)"
    flag --extra-index-url <url> repeat "Additional index URL (older form of --index)"
    flag --find-links|-f <path-or-url> repeat "Directory or flat HTML page with distributions"
    flag --no-index "Ignore package registries"
    flag --index-strategy {first-index,unsafe-first-match,unsafe-best-match} "How to pick versions across several indexes"
    flag --keyring-provider {disabled,subprocess} "Use keyring for index credentials"
    flag --upgrade|-U "Allow upgrading every package"
    flag --upgrade-package|-P <py-dependency> repeat "Allow upgrading one package"
    flag --resolution {highest,lowest,lowest-direct} "Version selection strategy"
    flag --prerelease {disallow,allow,if-necessary,explicit,if-necessary-or-explicit} "When to accept pre-release versions"
    flag --fork-strategy {fewest,requires-python} "How to split resolution across Python versions"
    flag --exclude-newer <date> "Ignore distributions uploaded after this date"
    flag --no-sources "Ignore tool.uv.sources while resolving"
    flag --config-setting|-C <key=value> repeat "Setting for the PEP 517 build backend"
    flag --no-build-isolation "Build without isolated build environments"
    flag --no-build "Never build from source distributions"
    flag --no-binary "Never use prebuilt wheels"
    flag --refresh "Revalidate all cached data"
    flag --refresh-package <py-dependency> repeat "Revalidate cached data for one package"
  command export "Export the lockfile to another format"
    flag --format {requirements.txt,pylock.toml,cyclonedx1.5} "Export format"
    flag --output-file|-o <file> "Write to this file"
    flag --all-packages excludes=--package "Export every workspace member"
    flag --package <py-dependency> "Export one workspace member"
    flag --prune <py-dependency> repeat "Leave out a package and its dependencies"
    flag --no-hashes "Leave out hashes"
    flag --no-header "Leave out the header comment"
    flag --no-annotate "Leave out source annotations"
    flag --no-editable "Export workspace members as non-editable"
    flag --no-emit-project "Leave out the current project"
    flag --no-emit-workspace "Leave out workspace members"
    flag --no-emit-local "Leave out local path dependencies"
    flag --no-emit-package <py-dependency> repeat "Leave out this package"
    flag --emit-index-url "Include index URLs"
    flag --script <file> "Export a PEP 723 script lockfile"
    flag --python|-p <python> "Python interpreter or version request"
    flag --locked excludes=--frozen "Fail if uv.lock would change"
    flag --frozen "Use uv.lock as is, without checking it"
    flag --extra <py-extra> repeat "Include an optional dependency extra"
    flag --all-extras "Include every optional dependency extra"
    flag --no-extra <py-extra> repeat "Leave out an extra when using --all-extras"
    flag --no-dev excludes=--only-dev "Leave out the dev dependency group"
    flag --only-dev "Only include the dev dependency group"
    flag --group <py-group> repeat "Include a dependency group"
    flag --no-group <py-group> repeat "Leave out a dependency group"
    flag --no-default-groups "Leave out the default dependency groups"
    flag --only-group <py-group> repeat "Only include this dependency group"
