    flag --config-setting|-C <key=value> repeat "Setting for the PEP 517 build backend"
    flag --no-build-isolation "Build without isolated build environments"
    flag --no-build "Never build from source distributions"
    flag --no-binary "Never use prebuilt wheels"
    flag --refresh "Revalidate all cached data"
    flag --refresh-package <py-dependency> repeat "Revalidate cached data for one package"
  command tree "Show the project dependency tree"
    flag --universal "Show a platform-independent tree"
    flag --format {text,json} "Output format"
    flag --depth|-d <depth> "Maximum depth"
    flag --prune <py-dependency> repeat "Hide a package and its dependencies"
    flag --package <py-dependency> repeat "Only show this package"
    flag --no-dedupe "Repeat already shown dependencies"
    flag --invert "Show packages that depend on the given package"
    flag --outdated "Show the latest available versions"
    flag --show-sizes "Show wheel sizes"
    flag --script <file> "Show a PEP 723 script tree"
    flag --python-version <version> "Python version to resolve for"
    flag --python-platform <platform> "Platform to resolve for"
    flag --python|-p <python> "Python interpreter or version request"
    flag --locked excludes=--frozen "Fail if uv.lock would change"
    flag --frozen "Use uv.lock as is, without checking it"
