# Original Riga completion spec for a Cargo subset (MIT). Format reference: docs/SPECS.md.
# Package, target, feature, dependency and profile names come from Cargo.toml/Cargo.lock, installed
# packages from $CARGO_HOME/.crates.toml; crate (registry), target-triple and registry names are not generated.
# `cargo +toolchain ...` gets no spec suggestions: the toolchain word is not modeled.
command cargo "Rust package manager"
  flag --help|-h persistent "Print help"
  flag --verbose|-v persistent repeat excludes=--quiet "Use verbose output; repeat for more"
  flag --quiet|-q persistent "Do not print Cargo log messages"
  flag --color {auto,always,never} persistent "When to color output"
  flag --config <key=value-or-path> persistent repeat "Override a configuration value"
  flag --locked persistent "Require Cargo.lock to stay unchanged"
  flag --offline persistent "Run without network access"
  flag --frozen persistent "Same as --locked plus --offline"
  flag -Z <flag> persistent repeat "Unstable nightly-only flag"
  flag --version|-V "Print version information"
  flag --list "List installed commands"
  flag --explain <code> "Explain a rustc error code"
  flag -C <directory> chdir "Change to a directory first (nightly-only)"
  command build|b "Compile the current package"
    flag --package|-p <cargo-package> repeat "Package to build"
    flag --workspace|--all "Build every workspace member"
    flag --exclude <cargo-package> repeat requires=--workspace "Skip a workspace member"
    flag --lib "Build only the library"
    flag --bins "Build every binary"
    flag --bin <cargo-bin> repeat "Build one binary"
    flag --examples "Build every example"
    flag --example <cargo-example> repeat "Build one example"
    flag --tests "Build every test target"
    flag --test <cargo-test> repeat "Build one test target"
    flag --benches "Build every bench target"
    flag --bench <cargo-bench> repeat "Build one bench target"
    flag --all-targets "Build every target"
    flag --features|-F <cargo-feature> repeat "Features to activate"
    flag --all-features "Activate every feature"
    flag --no-default-features "Do not activate the default feature"
    flag --release|-r excludes=--profile "Optimized release build"
    flag --profile <cargo-profile> "Build with a named profile"
    flag --jobs|-j <n> "Number of parallel jobs"
    flag --keep-going "Keep building after an error"
    flag --target <triple> repeat "Build for a target triple"
    flag --target-dir <directory> "Directory for build artifacts"
    flag --manifest-path|-m <file> "Path to Cargo.toml"
    flag --message-format <fmt> repeat "Diagnostic output format, e.g. human, short, json"
    flag --timings "Write a build timing report"
    flag --ignore-rust-version "Ignore the rust-version requirement"
  command check|c "Check the package for errors without producing binaries"
    flag --package|-p <cargo-package> repeat "Package to check"
    flag --workspace|--all "Check every workspace member"
    flag --exclude <cargo-package> repeat requires=--workspace "Skip a workspace member"
    flag --lib "Check only the library"
    flag --bins "Check every binary"
    flag --bin <cargo-bin> repeat "Check one binary"
    flag --examples "Check every example"
    flag --example <cargo-example> repeat "Check one example"
    flag --tests "Check every test target"
    flag --test <cargo-test> repeat "Check one test target"
    flag --benches "Check every bench target"
    flag --bench <cargo-bench> repeat "Check one bench target"
    flag --all-targets "Check every target"
    flag --features|-F <cargo-feature> repeat "Features to activate"
    flag --all-features "Activate every feature"
    flag --no-default-features "Do not activate the default feature"
    flag --release|-r excludes=--profile "Check in release mode"
    flag --profile <cargo-profile> "Check with a named profile"
    flag --jobs|-j <n> "Number of parallel jobs"
    flag --keep-going "Keep checking after an error"
    flag --target <triple> repeat "Check for a target triple"
    flag --target-dir <directory> "Directory for build artifacts"
    flag --manifest-path|-m <file> "Path to Cargo.toml"
    flag --message-format <fmt> repeat "Diagnostic output format, e.g. human, short, json"
    flag --timings "Write a build timing report"
    flag --ignore-rust-version "Ignore the rust-version requirement"
  command clippy "Run the Clippy linter (lint flags go after --)"
    flag --fix "Apply lint suggestions automatically"
    flag --no-deps "Lint only the given crate, not its dependencies"
    flag --allow-dirty "Allow --fix with uncommitted changes"
    flag --allow-staged "Allow --fix with staged changes"
    flag --allow-no-vcs "Allow --fix without version control"
    flag --package|-p <cargo-package> repeat "Package to lint"
    flag --workspace|--all "Lint every workspace member"
    flag --exclude <cargo-package> repeat requires=--workspace "Skip a workspace member"
    flag --lib "Lint only the library"
    flag --bins "Lint every binary"
    flag --bin <cargo-bin> repeat "Lint one binary"
    flag --examples "Lint every example"
    flag --example <cargo-example> repeat "Lint one example"
    flag --tests "Lint every test target"
    flag --test <cargo-test> repeat "Lint one test target"
    flag --benches "Lint every bench target"
    flag --bench <cargo-bench> repeat "Lint one bench target"
    flag --all-targets "Lint every target"
    flag --features|-F <cargo-feature> repeat "Features to activate"
    flag --all-features "Activate every feature"
    flag --no-default-features "Do not activate the default feature"
    flag --release|-r excludes=--profile "Lint in release mode"
    flag --profile <cargo-profile> "Lint with a named profile"
    flag --jobs|-j <n> "Number of parallel jobs"
    flag --keep-going "Keep going after an error"
    flag --target <triple> repeat "Lint for a target triple"
    flag --target-dir <directory> "Directory for build artifacts"
    flag --manifest-path|-m <file> "Path to Cargo.toml"
    flag --message-format <fmt> repeat "Diagnostic output format, e.g. human, short, json"
    arg [<lint-options>] repeat "Options passed to Clippy after --, e.g. -D warnings"
  command run|r "Run a binary or example of the local package"
    flag --package|-p <cargo-package> "Package with the target to run"
    flag --bin <cargo-bin> excludes=--example "Binary to run"
    flag --example <cargo-example> "Example to run"
    flag --features|-F <cargo-feature> repeat "Features to activate"
    flag --all-features "Activate every feature"
    flag --no-default-features "Do not activate the default feature"
    flag --release|-r excludes=--profile "Run an optimized release build"
    flag --profile <cargo-profile> "Build with a named profile"
    flag --jobs|-j <n> "Number of parallel jobs"
    flag --keep-going "Keep building after an error"
    flag --target <triple> "Build for a target triple"
    flag --target-dir <directory> "Directory for build artifacts"
    flag --manifest-path|-m <file> "Path to Cargo.toml"
    flag --message-format <fmt> repeat "Diagnostic output format, e.g. human, short, json"
    flag --timings "Write a build timing report"
    flag --ignore-rust-version "Ignore the rust-version requirement"
    arg [<args>] stop "Arguments for the program"
    arg [<more-args>] repeat "More arguments for the program"
  command test|t "Build and run the tests"
    flag --no-run "Compile but do not run the tests"
    flag --no-fail-fast "Run every test even after failures"
    flag --doc "Test only the library documentation"
    flag --package|-p <cargo-package> repeat "Package to test"
    flag --workspace|--all "Test every workspace member"
    flag --exclude <cargo-package> repeat requires=--workspace "Skip a workspace member"
    flag --lib "Test only the library"
    flag --bins "Test every binary"
    flag --bin <cargo-bin> repeat "Test one binary"
    flag --examples "Test every example"
    flag --example <cargo-example> repeat "Test one example"
    flag --tests "Test every test target"
    flag --test <cargo-test> repeat "Run one integration test target"
    flag --benches "Test every bench target"
    flag --bench <cargo-bench> repeat "Test one bench target"
    flag --all-targets "Test every target except doctests"
    flag --features|-F <cargo-feature> repeat "Features to activate"
    flag --all-features "Activate every feature"
    flag --no-default-features "Do not activate the default feature"
    flag --release|-r excludes=--profile "Test an optimized release build"
    flag --profile <cargo-profile> "Build with a named profile"
    flag --jobs|-j <n> "Number of parallel jobs"
    flag --target <triple> repeat "Build for a target triple"
    flag --target-dir <directory> "Directory for build artifacts"
    flag --manifest-path|-m <file> "Path to Cargo.toml"
    flag --message-format <fmt> repeat "Diagnostic output format, e.g. human, short, json"
    flag --timings "Write a build timing report"
    flag --ignore-rust-version "Ignore the rust-version requirement"
    arg [<test-name>] "Run only tests whose names contain this string"
    arg [<test-args>] repeat "Arguments for the test binary after --"
  command bench "Build and run the benchmarks"
    flag --no-run "Compile but do not run the benchmarks"
    flag --no-fail-fast "Run every benchmark even after failures"
    flag --package|-p <cargo-package> repeat "Package to benchmark"
    flag --workspace|--all "Benchmark every workspace member"
    flag --exclude <cargo-package> repeat requires=--workspace "Skip a workspace member"
    flag --lib "Benchmark only the library"
    flag --bins "Benchmark every binary"
    flag --bin <cargo-bin> repeat "Benchmark one binary"
    flag --bench <cargo-bench> repeat "Run one bench target"
    flag --benches "Benchmark every bench target"
    flag --all-targets "Benchmark every target"
    flag --features|-F <cargo-feature> repeat "Features to activate"
    flag --all-features "Activate every feature"
    flag --no-default-features "Do not activate the default feature"
    flag --profile <cargo-profile> "Build with a named profile"
    flag --jobs|-j <n> "Number of parallel jobs"
    flag --target <triple> repeat "Build for a target triple"
    flag --target-dir <directory> "Directory for build artifacts"
    flag --manifest-path|-m <file> "Path to Cargo.toml"
    arg [<bench-name>] "Run only benchmarks whose names contain this string"
    arg [<bench-args>] repeat "Arguments for the bench binary after --"
  command doc|d "Build documentation for the package and its dependencies"
    flag --open "Open the docs in a browser afterwards"
    flag --no-deps "Do not document dependencies"
    flag --document-private-items "Include private items"
    flag --package|-p <cargo-package> repeat "Package to document"
    flag --workspace|--all "Document every workspace member"
    flag --exclude <cargo-package> repeat requires=--workspace "Skip a workspace member"
    flag --lib "Document only the library"
    flag --bins "Document every binary"
    flag --bin <cargo-bin> repeat "Document one binary"
    flag --features|-F <cargo-feature> repeat "Features to activate"
    flag --all-features "Activate every feature"
    flag --no-default-features "Do not activate the default feature"
    flag --release|-r excludes=--profile "Build in release mode"
    flag --profile <cargo-profile> "Build with a named profile"
    flag --jobs|-j <n> "Number of parallel jobs"
    flag --target <triple> repeat "Build for a target triple"
    flag --target-dir <directory> "Directory for build artifacts"
    flag --manifest-path|-m <file> "Path to Cargo.toml"
  command fmt "Format the code with rustfmt (rustfmt options go after --)"
    flag --check "Report unformatted files without writing"
    flag --all "Format every workspace member"
    flag --package|-p <cargo-package> repeat "Package to format"
    flag --manifest-path <file> "Path to Cargo.toml"
    flag --message-format {short,human} "Output format"
    arg [<rustfmt-options>] repeat "Options passed to rustfmt after --"
  command fix "Apply rustc lint suggestions automatically"
    flag --edition "Prepare for the next edition"
    flag --edition-idioms "Migrate to the idioms of the current edition"
    flag --broken-code "Fix code that already fails to compile"
    flag --allow-no-vcs "Fix without version control"
    flag --allow-dirty "Fix with uncommitted changes"
    flag --allow-staged "Fix with staged changes"
    flag --package|-p <cargo-package> repeat "Package to fix"
    flag --workspace|--all "Fix every workspace member"
    flag --exclude <cargo-package> repeat requires=--workspace "Skip a workspace member"
    flag --lib "Fix only the library"
    flag --bins "Fix every binary"
    flag --bin <cargo-bin> repeat "Fix one binary"
    flag --tests "Fix every test target"
    flag --all-targets "Fix every target"
    flag --features|-F <cargo-feature> repeat "Features to activate"
    flag --all-features "Activate every feature"
    flag --no-default-features "Do not activate the default feature"
    flag --target <triple> repeat "Fix for a target triple"
    flag --manifest-path|-m <file> "Path to Cargo.toml"
  command clean "Remove the target directory"
    flag --doc "Remove only the documentation directory"
    flag --dry-run|-n "Show what would be deleted"
    flag --package|-p <cargo-package> repeat "Clean artifacts of one package"
    flag --workspace "Clean artifacts of workspace members"
    flag --release|-r excludes=--profile "Clean release artifacts"
    flag --profile <cargo-profile> "Clean artifacts of a named profile"
    flag --target <triple> repeat "Clean output for a target triple"
    flag --target-dir <directory> "Directory for build artifacts"
    flag --manifest-path|-m <file> "Path to Cargo.toml"
  command new "Create a new package in a new directory"
    flag --bin excludes=--lib "Use a binary template (default)"
    flag --lib "Use a library template"
    flag --vcs {git,hg,pijul,fossil,none} "Version control to initialize"
    flag --edition {2015,2018,2021,2024} "Rust edition for the new crate"
    flag --name <name> "Package name (defaults to the directory name)"
    flag --registry <registry> "Registry to use"
    arg <directory> "Directory to create"
  command init "Create a new package in an existing directory"
    flag --bin excludes=--lib "Use a binary template (default)"
    flag --lib "Use a library template"
    flag --vcs {git,hg,pijul,fossil,none} "Version control to initialize"
    flag --edition {2015,2018,2021,2024} "Rust edition for the new crate"
    flag --name <name> "Package name (defaults to the directory name)"
    flag --registry <registry> "Registry to use"
    arg [<directory>] "Directory to initialize"
  command add "Add dependencies to Cargo.toml"
    flag --features|-F <features> repeat "Features to enable on the dependency"
    flag --default-features excludes=--no-default-features "Re-enable the default features"
    flag --no-default-features "Disable the default features"
    flag --optional excludes=--no-optional "Mark the dependency optional"
    flag --no-optional "Mark the dependency required"
    flag --rename <name> "Rename the dependency"
    flag --dry-run|-n "Do not write the manifest"
    flag --package|-p <cargo-package> "Package to add the dependency to"
    flag --manifest-path|-m <file> "Path to Cargo.toml"
    flag --path <directory> "Local crate to depend on"
    flag --git <url> excludes=--path "Git repository to depend on"
    flag --branch <branch> requires=--git excludes=--tag,--rev "Git branch to use"
    flag --tag <tag> requires=--git excludes=--rev "Git tag to use"
    flag --rev <rev> requires=--git "Git revision to use"
    flag --registry <registry> "Registry to use"
    flag --dev excludes=--build "Add as a development dependency"
    flag --build "Add as a build dependency"
    flag --target <target> "Add as a dependency of a target platform"
    arg <crate> repeat "Crate to add, optionally name@version"
  command remove|rm "Remove dependencies from Cargo.toml"
    flag --dev excludes=--build "Remove a development dependency"
    flag --build "Remove a build dependency"
    flag --target <target> "Remove a dependency of a target platform"
    flag --dry-run|-n "Do not write the manifest"
    flag --package|-p <cargo-package> "Package to remove the dependency from"
    flag --manifest-path|-m <file> "Path to Cargo.toml"
    arg <cargo-dependency> repeat "Dependency to remove"
  command update "Update dependencies in Cargo.lock"
    flag --dry-run|-n "Do not write the lockfile"
    flag --recursive "Also update dependencies of the given packages"
    flag --precise <version> "Update the package to exactly this version"
    flag --workspace|-w "Only update workspace packages"
    flag --manifest-path|-m <file> "Path to Cargo.toml"
    arg [<cargo-lock-package>] repeat "Package to update"
  command install "Install a Rust binary"
    flag --version <version> "Version to install"
    flag --git <url> excludes=--path "Install from a Git repository"
    flag --branch <branch> requires=--git excludes=--tag,--rev "Git branch to use"
    flag --tag <tag> requires=--git excludes=--rev "Git tag to use"
    flag --rev <sha> requires=--git "Git commit to use"
    flag --path <directory> "Install from a local crate"
    flag --root <directory> "Directory to install into"
    flag --registry <registry> "Registry to use"
    flag --index <url> "Registry index to install from"
    flag --force|-f "Overwrite existing crates or binaries"
    flag --no-track "Do not save tracking information"
    flag --list "List installed packages"
    flag --bin <name> repeat "Install one binary"
    flag --bins "Install every binary"
    flag --example <name> repeat "Install one example"
    flag --examples "Install every example"
    flag --features|-F <features> repeat "Features to activate"
    flag --all-features "Activate every feature"
    flag --no-default-features "Do not activate the default feature"
    flag --debug excludes=--profile "Build in debug mode instead of release"
    flag --profile <profile> "Build with a named profile"
    flag --jobs|-j <n> "Number of parallel jobs"
    flag --target <triple> "Build for a target triple"
    flag --target-dir <directory> "Directory for build artifacts"
    arg [<crate>] repeat "Crate to install, optionally name@version"
  command uninstall "Remove an installed Rust binary"
    flag --package|-p <cargo-installed> repeat "Package to uninstall"
    flag --bin <name> repeat "Only uninstall this binary"
    flag --root <directory> "Directory to uninstall from"
    arg [<cargo-installed>] repeat "Package to uninstall"
  command search "Search the registry for crates"
    flag --limit <n> "Maximum number of results"
    flag --registry <registry> "Registry to search"
    flag --index <url> "Registry index to search"
    arg <query> repeat "Search terms"
  command info "Show information about a crate"
    flag --registry <registry> "Registry to query"
    flag --index <url> "Registry index to query"
    arg <crate> "Crate, optionally name@version"
  command tree "Show the dependency graph as a tree"
    flag --edges|-e <kinds> repeat "Dependency kinds to show, e.g. normal, dev, build, features"
    flag --invert|-i <cargo-lock-package> repeat "Invert the tree around a package"
    flag --prune <cargo-lock-package> repeat "Hide a package from the tree"
    flag --depth <depth> "Maximum display depth"
    flag --prefix {depth,indent,none} "How to indent entries"
    flag --no-dedupe "Repeat shared dependencies"
    flag --duplicates|-d "Show only dependencies with multiple versions"
    flag --charset {utf8,ascii} "Character set for the tree lines"
    flag --format|-f <format> "Format string for each entry"
    flag --package|-p <cargo-package> repeat "Package to use as the root"
    flag --workspace "Show every workspace member"
    flag --features|-F <cargo-feature> repeat "Features to activate"
    flag --all-features "Activate every feature"
    flag --no-default-features "Do not activate the default feature"
    flag --target <triple> repeat "Only dependencies for a target triple"
    flag --manifest-path|-m <file> "Path to Cargo.toml"
  command metadata "Print package metadata as JSON"
    flag --format-version {1} "Output format version"
    flag --no-deps "Only workspace members, no dependencies"
    flag --filter-platform <triple> repeat "Only dependencies for a target triple"
    flag --features|-F <cargo-feature> repeat "Features to activate"
    flag --all-features "Activate every feature"
    flag --no-default-features "Do not activate the default feature"
    flag --manifest-path|-m <file> "Path to Cargo.toml"
  command fetch "Download dependencies from the network"
    flag --target <triple> repeat "Only fetch for a target triple"
    flag --manifest-path|-m <file> "Path to Cargo.toml"
  command generate-lockfile "Generate Cargo.lock for the package"
    flag --manifest-path|-m <file> "Path to Cargo.toml"
  command package "Assemble the package into a crate file"
    flag --list|-l "List files that would be packaged"
    flag --no-verify "Do not build to verify the contents"
    flag --allow-dirty "Allow uncommitted changes"
    flag --package|-p <cargo-package> repeat "Package to assemble"
    flag --workspace "Assemble every workspace member"
    flag --registry <registry> "Registry to prepare for"
    flag --manifest-path|-m <file> "Path to Cargo.toml"
  command publish "Package and upload to a registry"
    flag --dry-run|-n "Check everything without uploading"
    flag --no-verify "Do not build to verify the contents"
    flag --allow-dirty "Allow uncommitted changes"
    flag --registry <registry> "Registry to upload to"
    flag --index <url> "Registry index to upload to"
    flag --package|-p <cargo-package> repeat "Package to publish"
    flag --workspace "Publish every workspace member"
    flag --features|-F <cargo-feature> repeat "Features to activate"
    flag --all-features "Activate every feature"
    flag --no-default-features "Do not activate the default feature"
    flag --manifest-path|-m <file> "Path to Cargo.toml"
  command yank "Remove a published version from the index"
    flag --version <version> "Version to yank"
    flag --undo "Put a yanked version back"
    flag --registry <registry> "Registry to use"
    flag --token <token> "API token"
    arg [<crate>] "Crate name, optionally name@version"
  command login "Log in to a registry"
    flag --registry <registry> "Registry to log in to"
    arg [<args>] repeat "Arguments for the credential provider after --"
  command logout "Remove the registry token"
    flag --registry <registry> "Registry to log out of"
  command vendor "Copy all dependencies into a local directory"
    flag --no-delete "Keep older crates in the vendor directory"
    flag --sync|-s <file> repeat "Additional Cargo.toml to vendor"
    flag --versioned-dirs "Always put the version in directory names"
    flag --respect-source-config "Respect [source] configuration"
    flag --manifest-path|-m <file> "Path to Cargo.toml"
    arg [<directory>] "Vendor directory (default vendor)"
  command help "Show help for a command"
    arg [<command>] "Command to describe"

#test "cargo " => +build +b +test +add +clippy +--version +-C
#test "cargo --color " => +auto +never -build
#test "cargo --color=al" => +always
#test "cargo build --" => +--release +--offline +--color +--help ---version ---list
#test "cargo b -" => +--release +-p +-v
#test "cargo build --release --pro" => ---profile
#test "cargo build --profile dev --" => ---release +--locked
#test "cargo build --ex" => +--example +--examples ---exclude
#test "cargo build --workspace --ex" => +--exclude
#test "cargo test --no-run --no" => ---no-run +--no-fail-fast
#test "cargo -v -v --" => +--verbose ---quiet
#test "cargo build -q --" => ---verbose ---quiet
#test "cargo new --edition " => +2021 +2024
#test "cargo new --vcs=n" => +none
#test "cargo add --dev --" => ---build ---branch +--git
#test "cargo add --git url --b" => +--branch -build
#test "cargo add --git url --tag v1 --" => ---branch ---rev
#test "cargo rm -" => +--dev +-n
#test "cargo -C /tmp b" => +build +b
#test "cargo build -C" => --C
#test "cargo tree --charset " => +utf8 +ascii
#test "cargo run --bin x --ex" => ---example
#test "cargo run app --rel" => ---release
