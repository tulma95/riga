# Original Riga completion spec for a rustup subset (MIT). Format reference: docs/SPECS.md.
# Toolchains (plus release channels), and installed targets/components for removal, come from ~/.rustup; host tuples and available targets are not generated.
# The `+toolchain` shorthand (`rustup +nightly show`) is not modelled: an unknown first word stops spec suggestions.
command rustup "Install and manage Rust toolchains"
  flag --help|-h persistent "Print help"
  flag --version|-V "Print the rustup version"
  flag --verbose|-v "Enable debug logging"
  flag --quiet|-q "Disable progress output"
  command install "Install or update toolchains"
    flag --profile {minimal,default,complete} "Component set to install"
    flag --component|-c <components> "Comma-separated components to add"
    flag --target|-t <targets> "Comma-separated targets to add"
    flag --no-self-update "Skip updating rustup itself"
    flag --no-update "Do not update an already installed toolchain"
    flag --force "Update even if some components are missing"
    flag --allow-downgrade "Allow a downgrade to satisfy the component choice"
    flag --force-non-host "Install toolchains that need an emulator"
    flag --override "Use the toolchain as the override for this directory"
    flag --default "Make the toolchain the default"
    arg [<rustup-toolchain>] repeat "Toolchains to install"
  command uninstall "Uninstall toolchains"
    arg <rustup-toolchain> repeat "Toolchains to remove"
  command toolchain "Install, uninstall or list toolchains"
    command list "List installed toolchains"
      flag --verbose|-v "Show toolchain paths"
      flag --quiet|-q "Print a single column"
    command install|add "Install or update toolchains"
      flag --profile {minimal,default,complete} "Component set to install"
      flag --component|-c <components> "Comma-separated components to add"
      flag --target|-t <targets> "Comma-separated targets to add"
      flag --no-self-update "Skip updating rustup itself"
      flag --no-update "Do not update an already installed toolchain"
      flag --force "Update even if some components are missing"
      flag --allow-downgrade "Allow a downgrade to satisfy the component choice"
      flag --force-non-host "Install toolchains that need an emulator"
      flag --override "Use the toolchain as the override for this directory"
      flag --default "Make the toolchain the default"
      arg [<rustup-toolchain>] repeat "Toolchains to install"
    command uninstall|remove "Uninstall toolchains"
      arg <rustup-toolchain> repeat "Toolchains to remove"
    command link "Register a local build directory as a custom toolchain"
      arg <name> "Custom toolchain name"
      arg <directory> "Toolchain directory"
  command default "Set the default toolchain"
    flag --force-non-host "Install toolchains that need an emulator"
    arg [<rustup-toolchain>] "Toolchain to use by default"
  command show "Show active and installed toolchains"
    flag --verbose|-v "Include rustc details for every toolchain"
    command active-toolchain "Show the active toolchain"
      flag --verbose|-v "Include rustc details"
    command home "Print the RUSTUP_HOME directory"
    command profile "Show the default install profile"
  command update "Update toolchains and rustup"
    flag --no-self-update "Skip updating rustup itself"
    flag --force "Update even if some components are missing"
    flag --force-non-host "Install toolchains that need an emulator"
    arg [<rustup-toolchain>] repeat "Toolchains to update"
  command check "Check for toolchain and rustup updates"
    flag --no-self-update "Skip checking for a rustup update"
  command target "Manage a toolchain's compilation targets"
    command list "List installed and available targets"
      flag --toolchain <rustup-toolchain> "Toolchain to inspect"
      flag --installed "Only list installed targets"
      flag --quiet|-q "Print a single column"
    command add|install "Add targets to a toolchain"
      flag --toolchain <rustup-toolchain> "Toolchain to modify"
      arg <target> repeat "Target tuples, or all"
    command remove|uninstall "Remove targets from a toolchain"
      flag --toolchain <rustup-toolchain> "Toolchain to modify"
      arg <rustup-target> repeat "Target tuples to remove"
  command component "Manage a toolchain's components"
    command list "List installed and available components"
      flag --toolchain <rustup-toolchain> "Toolchain to inspect"
      flag --installed "Only list installed components"
      flag --quiet|-q "Print a single column"
    command add "Add components to a toolchain"
      flag --toolchain <rustup-toolchain> "Toolchain to modify"
      flag --target <target> "Target of the component"
      arg <component> repeat "Components such as clippy or rust-src"
    command remove "Remove components from a toolchain"
      flag --toolchain <rustup-toolchain> "Toolchain to modify"
      flag --target <target> "Target of the component"
      arg <rustup-component> repeat "Components to remove"
  command override "Manage per-directory toolchain overrides"
    command list "List directory overrides"
    command set|add "Set the toolchain override for a directory"
      flag --path <directory> "Directory to override instead of the current one"
      arg <rustup-toolchain> "Toolchain to use"
    command unset|remove "Remove the toolchain override for a directory"
      flag --path <directory> excludes=--nonexistent "Directory to clear instead of the current one"
      flag --nonexistent "Remove overrides for directories that no longer exist"
  command run "Run a command with a given toolchain"
    flag --install "Install the toolchain if it is missing"
    arg <rustup-toolchain> "Toolchain to use"
    arg <command> stop "Program to run"
    arg [<args>] repeat "Program arguments"
  command which "Show which binary a command runs"
    flag --toolchain <rustup-toolchain> "Toolchain to look in"
    arg <command> "Command such as rustc or cargo"
  command doc "Open the local documentation"
    flag --path "Only print the documentation path"
    flag --serve "Serve the documentation over local HTTP"
    flag --toolchain <rustup-toolchain> "Toolchain whose documentation to open"
    flag --alloc "Allocation and collections library"
    flag --book "The Rust Programming Language book"
    flag --cargo "The Cargo Book"
    flag --clippy "Clippy documentation"
    flag --core "Core library"
    flag --edition-guide "Edition Guide"
    flag --embedded-book "Embedded Rust Book"
    flag --error-codes "Error codes index"
    flag --nomicon "The Rustonomicon on unsafe code"
    flag --proc_macro "Procedural macro support library"
    flag --reference "The Rust Reference"
    flag --releases "Release notes"
    flag --rust-by-example "Rust by Example"
    flag --rustc "rustc book"
    flag --rustc-docs "Compiler API documentation"
    flag --rustdoc "rustdoc book"
    flag --std "Standard library API"
    flag --style-guide "Style Guide"
    flag --test "Test support library"
    flag --unstable-book "Unstable Book"
    arg [<topic>] "Item to look up, such as usize or core::arch"
  command man "Show the man page for a command"
    flag --toolchain <rustup-toolchain> "Toolchain to look in"
    arg <command> "Command such as rustc or cargo"
  command self "Manage the rustup installation"
    command update "Update rustup itself"
    command uninstall "Uninstall rustup and all toolchains"
      flag --yes|-y "Skip the confirmation prompt"
      flag --no-modify-path "Leave PATH untouched"
    command upgrade-data "Upgrade the internal data format"
  command set "Change rustup settings"
    command default-host "Set the host tuple for unqualified toolchains"
      arg <host-tuple> "Host tuple such as aarch64-apple-darwin"
    command profile "Set the default install profile"
      arg [{minimal,default,complete}] "Profile name"
    command auto-self-update "Set the automatic self-update mode"
      arg [{enable,disable,check-only}] "Self-update mode"
    command auto-install "Set the automatic toolchain install mode"
      arg [{enable,disable}] "Install mode"
  command completions "Generate shell completion scripts"
    arg {bash,elvish,fish,powershell,zsh} "Shell"
    arg [{rustup,cargo}] "Program to complete"
  command help "Print help for a subcommand"
    arg [<command>] repeat "Subcommand"

#test "rustup " => +install +toolchain +component +target +override +-V +--help
#test "rustup -" => +--verbose +--quiet +--version
#test "rustup show -" => +--help +--verbose ---version ---quiet
#test "rustup show " => +active-toolchain +home +profile
#test "rustup -v ins" => +install
#test "rustup toolchain " => +list +install +uninstall +link
#test "rustup toolchain add --profile " => +minimal +complete -stable
#test "rustup install --profile=mi" => +minimal -complete
#test "rustup install --force --" => ---force +--default
#test "rustup install --profile minimal " => -minimal -stable
#test "rustup target install --toolchain nightly -" => ---toolchain +--help
#test "rustup component add --target x --" => +--toolchain ---target
#test "rustup override unset --path /tmp --" => ---nonexistent ---path
#test "rustup override remove --nonexistent --" => ---path
#test "rustup set auto-self-update " => +check-only +enable
#test "rustup completions " => +zsh +fish -cargo
#test "rustup completions zsh " => +cargo +rustup
#test "rustup run nightly cargo --" => ---install
#test "rustup doc --st" => +--std +--style-guide
