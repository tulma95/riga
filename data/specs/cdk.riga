# Original Riga completion spec for the AWS CDK v2 CLI, checked against 2.1145 (MIT). Format reference: docs/SPECS.md.
# Profiles come from ~/.aws/config and ~/.aws/credentials; stack names from ./cdk.out/manifest.json of the last synth (--output and nested stage assemblies are not followed).
# Environments, context keys, notice IDs, ARNs and other values are not generated. The CDK app itself is never run.
command cdk "AWS Cloud Development Kit command line tool"
  flag --help|-h persistent "Print usage"
  flag --version persistent "Print the CDK CLI version"
  flag --app|-a <command> persistent "Command that runs the app, or a cloud assembly directory"
  flag --build <command> persistent "Command that builds the app before synthesis"
  flag --context|-c <key=value> repeat persistent "Add a context value"
  flag --plugin|-p <module> repeat persistent "Load a CLI plugin"
  flag --trace persistent "Print the trace for stack warnings"
  flag --strict persistent "Do not construct stacks that have warnings"
  flag --lookups persistent excludes=--no-lookups "Allow context lookups during synthesis"
  flag --no-lookups persistent "Fail when a context lookup is needed"
  flag --ignore-errors persistent "Ignore synthesis errors"
  flag --json|-j persistent "Print templates as JSON instead of YAML"
  flag --verbose|-v repeat persistent "Show debug logs; repeat for more detail"
  flag --debug persistent "Print detailed debugging information"
  flag --debug-app persistent "Log extra information while the app synthesizes"
  flag --debug-cli persistent "Report what keeps the CLI process alive if it fails to exit"
  flag --region <region> persistent "Default AWS region"
  flag --profile <aws-profile> persistent "AWS profile from the shared config files"
  flag --proxy <url> persistent "HTTPS proxy for AWS requests"
  flag --ca-bundle-path <file> persistent "Certificate bundle for HTTPS requests"
  flag --ec2creds|-i persistent "Force the EC2 instance metadata credential provider"
  flag --version-reporting|--telemetry persistent excludes=--no-version-reporting "Send telemetry and add the AWS::CDK::Metadata resource"
  flag --no-version-reporting|--no-telemetry persistent "Disable telemetry and leave out the AWS::CDK::Metadata resource"
  flag --path-metadata persistent excludes=--no-path-metadata "Add aws:cdk:path metadata to resources (default)"
  flag --no-path-metadata persistent "Leave out aws:cdk:path metadata"
  flag --asset-metadata persistent excludes=--no-asset-metadata "Add asset metadata to resources (default)"
  flag --no-asset-metadata persistent "Leave out asset metadata"
  flag --role-arn|-r <arn> persistent "IAM role CloudFormation assumes for deployments"
  flag --no-staging persistent "Use assets from their original location without copying"
  flag --output|-o <directory> persistent "Cloud assembly output directory"
  flag --notices persistent excludes=--no-notices "Show relevant notices"
  flag --no-notices persistent "Hide notices"
  flag --no-color persistent excludes=--color "Remove colors and formatting from the output"
  flag --color persistent "Force colored output even when stdout is not a terminal"
  flag --ci persistent "Write logs to stdout for CI systems"
  flag --unstable <feature> repeat persistent "Opt in to an unstable command or feature"
  flag --telemetry-file <file> persistent "Also write telemetry data to this local file"
  flag --yes|-y persistent "Answer interactive prompts with the recommended response"
  command list|ls "List the stacks in the app"
    flag --long|-l "Show environment details for each stack"
    flag --show-dependencies|-d "Show stack dependencies"
    arg [<cdk-stack>] repeat "Stacks to list"
  command synth|synthesize "Synthesize CloudFormation templates"
    flag --exclusively|-e "Synthesize only the named stacks, not their dependencies"
    flag --validation "Run construct validation after synthesis"
    flag --quiet|-q "Do not print the template"
    flag --watch "Synthesize again whenever files change"
    arg [<cdk-stack>] repeat "Stacks to synthesize"
  command bootstrap "Deploy the CDK toolkit stack to environments"
    flag --bootstrap-bucket-name|--toolkit-bucket-name|-b <name> "Name of the asset bucket"
    flag --bootstrap-kms-key-id <key-id> excludes=--bootstrap-customer-key "KMS key for asset bucket encryption"
    flag --bootstrap-customer-key "Create a customer managed KMS key for the asset bucket"
    flag --example-permissions-boundary|--epb excludes=--custom-permissions-boundary "Use the example permissions boundary"
    flag --custom-permissions-boundary|--cpb <policy> "Use a named managed policy as permissions boundary"
    flag --qualifier <qualifier> "String that keeps bootstrap resource names unique"
    flag --public-access-block-configuration "Block public access on the asset bucket"
    flag --tags|-t <key=value> repeat "Tag to add to the toolkit stack"
    flag --execute excludes=--no-execute "Execute the change set (default)"
    flag --no-execute "Create the change set without executing it"
    flag --trust <account> repeat "Account trusted to deploy into this environment"
    flag --trust-for-lookup <account> repeat "Account trusted to look up values in this environment"
    flag --untrust <account> repeat "Account to remove from the trust lists"
    flag --cloudformation-execution-policies <arn> repeat "Managed policies for the CloudFormation execution role"
    flag --force|-f "Update the toolkit stack even if it would downgrade"
    flag --termination-protection "Toggle termination protection on the toolkit stack"
    flag --show-template "Print the bootstrap template instead of deploying it"
    flag --toolkit-stack-name <name> "Name of the toolkit stack"
    flag --template <file> "Use a custom bootstrap template"
    flag --previous-parameters excludes=--no-previous-parameters "Reuse previous values for omitted parameters (default)"
    flag --no-previous-parameters "Require every parameter on each deployment"
    flag --deny-external-id "Block AssumeRole with an ExternalId on the bootstrapped roles"
    flag --import-existing-resources excludes=--no-import-existing-resources "Import resources that already exist instead of failing (default)"
    flag --no-import-existing-resources "Fail if bootstrap resources already exist"
    flag --express "Create the bootstrap stack in CloudFormation Express mode"
    arg [<environment>] repeat "Environments as aws://ACCOUNT/REGION"
  command gc "Delete unused assets from the bootstrap bucket and repository"
    flag --action {print,tag,delete-tagged,full} "What garbage collection should do"
    flag --type {s3,ecr,all} "Asset storage to collect"
    flag --rollback-buffer-days <days> "Days an asset stays tagged before deletion"
    flag --created-buffer-days <days> "Minimum age in days before an asset is collected"
    flag --confirm excludes=--no-confirm "Ask before deleting assets (default)"
    flag --no-confirm "Delete without asking"
    flag --bootstrap-stack-name|--toolkit-stack-name <name> "Name of the toolkit stack"
    arg [<environment>] repeat "Environments as aws://ACCOUNT/REGION"
  command deploy "Deploy stacks to AWS"
    flag --all "Deploy every stack"
    flag --build-exclude|-E <asset-id> repeat "Do not build this asset"
    flag --exclusively|-e "Deploy only the named stacks, not their dependencies"
    flag --require-approval {never,any-change,broadening,destructive} "Changes that need manual approval"
    flag --notification-arns <arn> repeat "SNS topics that receive stack events"
    flag --tags|-t <key=value> repeat "Tag to add to the stack"
    flag --change-set-name <name> "Name of the CloudFormation change set"
    flag --method|-m {direct,change-set,prepare-change-set,execute-change-set} "How to deploy the stack"
    flag --import-existing-resources "Import resources that already exist"
    flag --force|-f "Deploy even if the template has not changed"
    flag --parameters <key=value> repeat "CloudFormation parameter, optionally prefixed with Stack:"
    flag --outputs-file|-O <file> "Write stack outputs to a JSON file"
    flag --previous-parameters excludes=--no-previous-parameters "Reuse previous values for omitted parameters (default)"
    flag --no-previous-parameters "Require every parameter on each deployment"
    flag --toolkit-stack-name <name> "Name of the toolkit stack"
    flag --progress {bar,events,errors-only} "How to show deployment progress"
    flag --rollback excludes=--no-rollback "Roll back the stack on failure"
    flag --no-rollback|-R "Leave a failed deployment in place for fixing"
    flag --hotswap excludes=--hotswap-fallback "Update supported resources directly, skipping CloudFormation"
    flag --hotswap-fallback "Hotswap, falling back to a full deployment"
    flag --hotswap-ecs-minimum-healthy-percent <percent> "Minimum ECS tasks kept running during a hotswap"
    flag --hotswap-ecs-maximum-healthy-percent <percent> "Maximum ECS tasks running or pending during a hotswap"
    flag --hotswap-ecs-stabilization-timeout-seconds <seconds> "How long to wait for ECS services to stabilize"
    flag --watch "Keep watching and deploying changes"
    flag --logs excludes=--no-logs "Show CloudWatch logs while watching (default)"
    flag --no-logs "Do not show CloudWatch logs while watching"
    flag --concurrency <count> "Maximum stacks deployed in parallel"
    flag --asset-parallelism excludes=--no-asset-parallelism "Build and publish assets in parallel"
    flag --no-asset-parallelism "Build and publish assets one at a time"
    flag --asset-build-concurrency <count> "Maximum asset builds in parallel (default 1)"
    flag --asset-prebuild excludes=--no-asset-prebuild "Build all assets before deploying the first stack (default)"
    flag --no-asset-prebuild "Build each stack's assets just before deploying it"
    flag --ignore-no-stacks "Succeed when the app has no stacks"
    flag --revert-drift "Create a change set that reverts drifted resources to the template"
    flag --express "Deploy in CloudFormation Express mode, skipping stabilization"
    arg [<cdk-stack>] repeat "Stacks to deploy"
  command rollback "Roll back stacks to their last stable state"
    flag --all "Roll back every stack"
    flag --toolkit-stack-name <name> "Name of the toolkit stack"
    flag --force|-f "Orphan resources that fail to roll back"
    flag --validate-bootstrap-version "Check the bootstrap stack version"
    flag --orphan <logical-id> repeat "Resource to orphan during rollback"
    arg [<cdk-stack>] repeat "Stacks to roll back"
  command import "Import existing resources into a stack"
    flag --execute excludes=--no-execute "Execute the change set (default)"
    flag --no-execute "Create the change set without executing it"
    flag --notification-arns <arn> repeat "SNS topics that receive stack events"
    flag --resource-mapping-inline <json> excludes=--resource-mapping "Resource mapping as inline JSON"
    flag --change-set-name <name> "Name of the CloudFormation change set"
    flag --toolkit-stack-name <name> "Name of the toolkit stack"
    flag --rollback excludes=--no-rollback "Roll back the stack on failure"
    flag --no-rollback "Leave a failed import in place"
    flag --force|-f "Import even if the template has other changes"
    flag --record-resource-mapping|-r <file> excludes=--resource-mapping "Write the resource mapping to a file without importing"
    flag --resource-mapping|-m <file> "Read the resource mapping from a file"
    arg [<cdk-stack>] "Stack to import into"
  command watch "Deploy changes whenever files change"
    flag --build-exclude|-E <asset-id> repeat "Do not build this asset"
    flag --exclusively|-e "Deploy only the named stacks, not their dependencies"
    flag --change-set-name <name> "Name of the CloudFormation change set"
    flag --force|-f "Deploy even if the template has not changed"
    flag --toolkit-stack-name <name> "Name of the toolkit stack"
    flag --progress {bar,events,errors-only} "How to show deployment progress"
    flag --rollback excludes=--no-rollback "Roll back the stack on failure"
    flag --no-rollback|-R "Leave a failed deployment in place for fixing"
    flag --hotswap excludes=--hotswap-fallback "Update supported resources directly, skipping CloudFormation"
    flag --hotswap-fallback "Hotswap, falling back to a full deployment"
    flag --hotswap-ecs-minimum-healthy-percent <percent> "Minimum ECS tasks kept running during a hotswap"
    flag --hotswap-ecs-maximum-healthy-percent <percent> "Maximum ECS tasks running or pending during a hotswap"
    flag --hotswap-ecs-stabilization-timeout-seconds <seconds> "How long to wait for ECS services to stabilize"
    flag --outputs-file|-O <file> "Write stack outputs to a JSON file"
    flag --logs excludes=--no-logs "Show CloudWatch logs (default)"
    flag --no-logs "Do not show CloudWatch logs"
    flag --concurrency <count> "Maximum stacks deployed in parallel"
    arg [<cdk-stack>] repeat "Stacks to watch"
  command destroy "Delete stacks"
    flag --all "Destroy every stack"
    flag --exclusively|-e "Destroy only the named stacks, not their dependents"
    flag --force|-f "Do not ask for confirmation"
    flag --concurrency <count> "Maximum stacks destroyed in parallel (default 1)"
    flag --express "Destroy in CloudFormation Express mode, skipping stabilization"
    arg [<cdk-stack>] repeat "Stacks to destroy"
  command diff "Compare stacks with the deployed or a local template"
    flag --exclusively|-e "Diff only the named stacks, not their dependencies"
    flag --context-lines <count> "Lines of context around each change"
    flag --template <file> "Compare with this template instead of the deployed one"
    flag --strict "Keep AWS::CDK::Metadata resources and other noise"
    flag --security-only "Show only security-related changes"
    flag --fail "Exit with an error when differences are found"
    flag --fail-on {never,any-change,broadening,destructive} "Kind of change that makes the diff fail"
    flag --processed "Compare with the processed template after transforms"
    flag --quiet|-q "Print nothing for stacks without differences"
    flag --method|-m {auto,change-set,template} "How to compute the diff (default auto)"
    flag --change-set|--changeset excludes=--no-change-set "Use a change set to compute the diff (deprecated, use --method)"
    flag --no-change-set|--no-changeset "Compare templates only (deprecated, use --method template)"
    flag --change-set-name <name> "Name of the CloudFormation change set"
    flag --import-existing-resources "Show resources that would be imported"
    flag --include-moves "Detect resources moved between stacks"
    arg [<cdk-stack>] repeat "Stacks to compare"
  command drift "Detect drift between deployed stacks and their templates"
    flag --fail "Exit with an error when drift is found"
    arg [<cdk-stack>] repeat "Stacks to check"
  command metadata "Show the metadata of a stack"
    arg [<cdk-stack>] "Stack to inspect"
  command acknowledge|ack "Stop showing a notice"
    arg [<notice-id>] "ID of the notice"
  command notices "List relevant notices"
    flag --unacknowledged|-u "Show only notices that are not acknowledged"
  command init "Create a new CDK project from a template"
    flag --language|-l {typescript,ts,javascript,js,python,py,java,csharp,cs,fsharp,fs,go} "Language of the project"
    flag --list "List the available templates"
    flag --generate-only "Create files only, without git init or installing dependencies"
    flag --lib-version|-V <version> "aws-cdk-lib version to use"
    flag --from-path <directory> "Local custom template directory or multi-template repository"
    flag --template-path <path> "Template inside a multi-template repository"
    flag --package-manager {npm,yarn,pnpm,bun} "Package manager for TypeScript and JavaScript projects"
    flag --project-name|-n <name> "Name of the new project"
    arg [{app,lib,sample-app}] "Template to use"
  command migrate "Generate a CDK app from CloudFormation or existing resources"
    flag --stack-name|-n <name> "Name of the generated stack"
    flag --language|-l {typescript,ts,python,py,java,csharp,cs,go} "Language of the generated project"
    flag --account <account> "Account to read the stack or resources from"
    flag --region <region> "Region to read the stack or resources from"
    flag --from-path <file> "Local CloudFormation template to migrate"
    flag --from-stack "Migrate the deployed stack named by --stack-name"
    flag --output-path <directory> "Where to write the new project"
    flag --from-scan {new,most-recent} "Migrate resources found by an IaC generator scan"
    flag --filter <filter> repeat "Filter for the resources to scan"
    flag --compress "Write a zip archive instead of a directory"
  command context "Show or change cached context values"
    flag --reset|-e <key> "Remove a context key or number"
    flag --force|-f "Ignore missing keys when resetting"
    flag --clear "Remove all cached context"
  command docs|doc "Open the CDK reference documentation"
    flag --browser|-b <command> "Command that opens the browser, with %u for the URL"
  command doctor "Check the setup for common problems"
  command flags "View and change feature flags"
    flag --set "Change feature flag configuration"
    flag --value <value> "Value to set the feature flag to"
    flag --all "View or change all feature flags"
    flag --unconfigured "Change only flags that are not configured"
    flag --recommended "Set flags to their recommended values"
    flag --default "Set flags to their default values"
    flag --safe "Enable all flags that do not change the app"
    flag --interactive|-i "Choose flags interactively"
    flag --concurrency|-n <count> "Maximum synths in parallel (default 4)"
    arg [<flag>] repeat "Feature flags to show or change"
  command validate "Validate synthesized templates against policy rules"
    flag --online excludes=--no-online "Also submit templates to CloudFormation for early validation (default)"
    flag --no-online "Validate locally only"
    flag --watch "Validate again whenever files change"
    arg [<cdk-stack>] repeat "Stacks to validate"
  command diagnose "Find the root causes of failed stack deployments"
    flag --toolkit-stack-name <name> "Name of the toolkit stack"
    flag --concurrency <count> "Stacks diagnosed in parallel"
    arg [<cdk-stack>] repeat "Stacks to diagnose"
  command publish-assets "Publish stack assets without deploying"
    flag --all "Publish assets for every stack"
    flag --exclusively|-e "Only the named stacks, not their dependencies"
    flag --force|-f "Publish even if the assets are already published"
    flag --concurrency <count> "Maximum asset operations in parallel (default 4)"
    arg [<cdk-stack>] repeat "Stacks whose assets to publish"
  command orphan "Detach resources from a stack without deleting them"
    arg [<path>] repeat "Construct paths of the resources"
  command lsp "Start the CDK language server over stdio"
    flag --features "Print the feature manifest as JSON and exit"
  command cli-telemetry "Enable or disable anonymous telemetry"
    flag --enable excludes=--disable,--status "Enable telemetry"
    flag --disable excludes=--status "Disable telemetry"
    flag --status "Show whether telemetry is enabled"
  command refactor "Move resources between stacks while keeping them deployed"
    flag --dry-run "Show the mappings without applying them"
    flag --override-file <file> "JSON file with resource mappings to apply"
    flag --revert "Undo the mappings in the override file"
    flag --force|-f "Apply the refactor without asking"
    flag --additional-stack-name <name> repeat "Deployed stack to include in the comparison"
    flag --toolkit-stack-name <name> "Name of the toolkit stack"
    arg [<cdk-stack>] repeat "Stacks to refactor"
#test "cdk " => +deploy +bootstrap +--app +--profile
#test "cdk s" => +synth +synthesize
#test "cdk i" => +init +import
#test "cdk de" => +deploy +destroy
#test "cdk deploy -" => +--all +--hotswap +--profile +--require-approval
#test "cdk deploy --o" => +--outputs-file +--output
#test "cdk deploy --require-approval " => +never +any-change +broadening
#test "cdk deploy --require-approval=b" => +broadening -never
#test "cdk deploy --method " => +direct +change-set +prepare-change-set
#test "cdk deploy --hotswap --w" => +--watch
#test "cdk deploy --hotswap --h" => ---hotswap ---hotswap-fallback +--hotswap-ecs-minimum-healthy-percent
#test "cdk deploy --no-rollback --" => ---rollback ---no-rollback +--force
#test "cdk init " => +app +lib +sample-app
#test "cdk init --language " => +typescript +python +go +fsharp
#test "cdk init --language=p" => +python -go
#test "cdk ls -" => +--long +-d +--json
#test "cdk --profile dev synth -" => +--quiet +-e +--verbose
#test "cdk synth --w" => +--watch
#test "cdk ack -" => +--help ---unacknowledged
#test "cdk bootstrap --epb -" => ---cpb ---custom-permissions-boundary +--trust
#test "cdk gc --type " => +s3 +ecr +all
#test "cdk import -r out.json -" => ---resource-mapping +--force
#test "cdk " => +flags +diagnose +cli-telemetry
#test "cdk v" => +validate
#test "cdk p" => +publish-assets
#test "cdk l" => +lsp +list
#test "cdk o" => +orphan
#test "cdk migrate --language " => +typescript +go ---javascript
#test "cdk deploy --no-" => +--no-previous-parameters +--no-asset-prebuild +--no-logs +--no-rollback
#test "cdk deploy --no-logs -" => ---logs +--express
#test "cdk diff --method " => +auto +template
#test "cdk --yes --region eu-west-1 deploy -" => ---yes +--all
#test "cdk cli-telemetry --enable -" => ---disable ---status
